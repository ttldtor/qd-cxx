cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../../schema-export/Environment.cmake")
schema_export_arguments(JAVA_HOME UPSTREAM RUN RECEIPT MODE EXPECTED)
schema_export_require(JAVA_HOME UPSTREAM RUN RECEIPT)
if(NOT DEFINED MODE)
    set(MODE Capture)
endif()
if(NOT MODE MATCHES "^(Capture|Verify)$")
    message(FATAL_ERROR "MODE must be Capture or Verify")
endif()
if(NOT DEFINED EXPECTED)
    set(EXPECTED "${schema_export_repo}/tests/fixtures/protocol/tape-write/expected")
endif()
cmake_path(ABSOLUTE_PATH EXPECTED NORMALIZE)
cmake_path(IS_PREFIX EXPECTED "${RUN}" NORMALIZE under_expected)
if(under_expected)
    message(FATAL_ERROR "RUN must be separate from expectations")
endif()
schema_export_environment()
schema_export_classpath(actual_receipt classpath)
file(READ "${RECEIPT}" prepared_receipt)
if(NOT prepared_receipt STREQUAL actual_receipt)
    message(FATAL_ERROR "Prepared classpath receipt differs from actual provider bytes")
endif()
schema_export_fresh_run()
file(MAKE_DIRECTORY "${RUN}/classes" "${RUN}/artifacts")
set(source "${CMAKE_CURRENT_LIST_DIR}/TapeWriteOracle.java")
set(event_source "${CMAKE_CURRENT_LIST_DIR}/../event-mapping-oracle/EventMappingOracle.java")
execute_process(COMMAND "${schema_export_javac}" -encoding UTF-8 -cp "${classpath}" -d "${RUN}/classes" "${source}" "${event_source}"
    TIMEOUT 30 RESULT_VARIABLE result OUTPUT_FILE "${RUN}/javac.stdout" ERROR_FILE "${RUN}/javac.stderr")
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Compile failed (${result}); see RUN/javac.stderr")
endif()
set(classpath "${RUN}/classes${schema_export_separator}${classpath}")
string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
foreach(case extras events)
    if(case STREQUAL extras)
        set(main qdcxx.oracle.TapeWriteOracle)
        set(args "${RUN}/artifacts/extras" "${schema_export_repo}/tests/fixtures/protocol/tape-write/inputs.tsv")
    else()
        set(main com.dxfeed.event.market.EventMappingOracle)
        set(args "${RUN}/artifacts/events" default "${schema_export_repo}/tests/fixtures/events/mapping/inputs")
    endif()
    execute_process(COMMAND "${schema_export_java}" -Xmx256m -Dfile.encoding=UTF-8 -Duser.language=en
        -Duser.country=US -Duser.timezone=UTC -cp "${classpath}" "${main}" ${args}
        TIMEOUT 30 RESULT_VARIABLE result OUTPUT_FILE "${RUN}/${case}.stdout" ERROR_FILE "${RUN}/${case}.stderr")
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Production capture ${case} failed (${result}); see RUN/${case}.stderr")
    endif()
    file(READ "${RUN}/${case}.stdout" stdout)
    if(NOT stdout MATCHES "CAPTURE COMPLETE:")
        message(FATAL_ERROR "Production capture missing completion")
    endif()
endforeach()
schema_export_environment()
schema_export_classpath(after_receipt unused)
if(NOT after_receipt STREQUAL actual_receipt)
    message(FATAL_ERROR "Provider bytes changed during capture")
endif()
file(WRITE "${RUN}/artifacts/classpath-receipt.json" "${actual_receipt}")
set(manifest "case\tprovenance\nlock\t${schema_export_commit}\n")
set(owned TapeWriteOracle.java Invoke-Oracle.cmake Compare-TapeWrite.ps1 Test-Negatives.ps1)
foreach(name IN LISTS owned)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${name}" hash)
    string(APPEND manifest "tool\t${name}\t${hash}\n")
endforeach()
file(SHA256 "${event_source}" hash)
string(APPEND manifest "tool\t../event-mapping-oracle/EventMappingOracle.java\t${hash}\n")
file(SHA256 "${schema_export_repo}/tests/fixtures/protocol/tape-write/inputs.tsv" hash)
string(APPEND manifest "input\tinputs.tsv\t${hash}\n")
set(providers
    qd-core/src/main/java/com/devexperts/qd/qtp/BinaryRecordDesc.java
    qd-core/src/main/java/com/devexperts/qd/qtp/BinaryQTPComposer.java
    qd-core/src/main/java/com/devexperts/qd/kit/PentaCodec.java
    qd-core/src/main/java/com/devexperts/qd/kit/StringField.java
    qd-core/src/main/java/com/devexperts/qd/kit/DefaultRecord.java
    qds-file/src/main/java/com/devexperts/qd/qtp/file/FileWriterImpl.java
    qds-file/src/main/java/com/devexperts/qd/qtp/file/FileReader.java)
foreach(name IN LISTS providers)
    file(SHA256 "${UPSTREAM}/${name}" hash)
    string(APPEND manifest "provider\t${name}\t${hash}\n")
endforeach()
string(APPEND manifest "complete\tprovenance\n")
file(WRITE "${RUN}/artifacts/provenance.tsv" "${manifest}")
string(TIMESTAMP finished "%Y-%m-%dT%H:%M:%SZ" UTC)
file(WRITE "${RUN}/run.tsv" "mode\t${MODE}\nstartedUtc\t${started}\nfinishedUtc\t${finished}\nupstream\t${UPSTREAM}\njava\t${schema_export_java}\nreceipt\t${RECEIPT}\nheapMiB\t256\ntimeoutSeconds\t30\n")
find_program(pwsh pwsh REQUIRED)
if(MODE STREQUAL Capture)
    set(against "${RUN}/artifacts")
else()
    set(against "${EXPECTED}")
endif()
execute_process(COMMAND "${pwsh}" -NoProfile -File "${CMAKE_CURRENT_LIST_DIR}/Compare-TapeWrite.ps1"
    -Actual "${RUN}/artifacts" -Expected "${against}" TIMEOUT 30 RESULT_VARIABLE result
    OUTPUT_FILE "${RUN}/verify.stdout" ERROR_FILE "${RUN}/verify.stderr")
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Strict comparison failed (${result}); see RUN/verify.stderr")
endif()
message(STATUS "${MODE} PASS: production writer/reader and strict artifact comparison")
