cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../../schema-export/Environment.cmake")
schema_export_arguments(JAVA_HOME UPSTREAM RUN RECEIPT INPUT PRODUCER)
schema_export_require(JAVA_HOME UPSTREAM RUN RECEIPT INPUT PRODUCER)
if(NOT IS_DIRECTORY "${INPUT}")
    message(FATAL_ERROR "INPUT must contain emitted case directories")
endif()
schema_export_environment()
schema_export_classpath(actual_receipt classpath)
file(READ "${RECEIPT}" prepared_receipt)
if(NOT prepared_receipt STREQUAL actual_receipt)
    message(FATAL_ERROR "Prepared classpath receipt differs from actual provider bytes")
endif()
schema_export_fresh_run()
file(MAKE_DIRECTORY "${RUN}/classes" "${RUN}/observed")
string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
set(source "${CMAKE_CURRENT_LIST_DIR}/TapeWriterInteropOracle.java")
execute_process(COMMAND "${schema_export_javac}" -encoding UTF-8 -cp "${classpath}"
    -d "${RUN}/classes" "${source}" TIMEOUT 30
    RESULT_VARIABLE result OUTPUT_FILE "${RUN}/javac.stdout" ERROR_FILE "${RUN}/javac.stderr")
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Interop compilation failed (${result}); see RUN/javac.stderr")
endif()
set(classpath "${RUN}/classes${schema_export_separator}${classpath}")
file(GLOB candidates LIST_DIRECTORIES true RELATIVE "${INPUT}" "${INPUT}/*")
set(cases)
foreach(case IN LISTS candidates)
    if(IS_DIRECTORY "${INPUT}/${case}")
        list(APPEND cases "${case}")
    endif()
endforeach()
list(SORT cases)
list(LENGTH cases case_count)
if(case_count LESS 1 OR case_count GREATER 64)
    message(FATAL_ERROR "Expected 1..64 emitted cases")
endif()
set(provenance "kind\tpath\tsha256\n")
foreach(name TapeWriterInteropOracle.java Verify-Writer.cmake ../../schema-export/Environment.cmake)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${name}" hash)
    string(APPEND provenance "tool\t${name}\t${hash}\n")
endforeach()
set(source_paths include/qd/protocol/tape_writer.hpp src/protocol/tape_writer.cpp
    include/qd/encoding/char_array.hpp src/encoding/char_array.cpp
    tests/conformance/tape_writer_tests.cpp upstream.lock)
foreach(name IN LISTS source_paths)
    file(SHA256 "${schema_export_repo}/${name}" hash)
    set(source_before_${name} "${hash}")
    string(APPEND provenance "source\t${name}\t${hash}\n")
endforeach()
file(SHA256 "${PRODUCER}" producer_hash)
string(APPEND provenance "producer\tartifact\t${producer_hash}\n")
foreach(case IN LISTS cases)
    if(case MATCHES "[;\r\n]")
        message(FATAL_ERROR "Case directory name cannot contain separators or line breaks")
    endif()
    set(mode)
    set(mode_exists false)
    if(EXISTS "${INPUT}/${case}/schema-mode.txt")
        set(mode_exists true)
        file(READ "${INPUT}/${case}/schema-mode.txt" mode)
        string(STRIP "${mode}" mode)
        if(NOT mode STREQUAL "standard")
            message(FATAL_ERROR "Unknown explicit schema mode for ${case}")
        endif()
        file(SHA256 "${INPUT}/${case}/schema-mode.txt" hash)
        set(mode_before "${hash}")
        string(APPEND provenance "input\t${case}/schema-mode.txt\t${hash}\n")
    endif()
    foreach(name tape.qtp schema.tsv expected.tsv)
        file(SHA256 "${INPUT}/${case}/${name}" hash)
        set(before_${name} "${hash}")
        string(APPEND provenance "input\t${case}/${name}\t${hash}\n")
    endforeach()
    execute_process(COMMAND "${schema_export_java}" -Xmx256m -Dfile.encoding=UTF-8
        -Duser.language=en -Duser.country=US -Duser.timezone=UTC -cp "${classpath}"
        qdcxx.oracle.TapeWriterInteropOracle "${INPUT}/${case}" "${RUN}/observed/${case}.tsv" ${mode}
        TIMEOUT 30 RESULT_VARIABLE result
        OUTPUT_FILE "${RUN}/${case}.stdout" ERROR_FILE "${RUN}/${case}.stderr")
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Production parse mismatch (${case}, ${result}); see RUN/${case}.stderr")
    endif()
    file(READ "${RUN}/${case}.stdout" stdout)
    if(NOT stdout MATCHES "VERIFY COMPLETE: records=[0-9]+ errors=0 callbacks=[0-9]+ rows=[0-9]+")
        message(FATAL_ERROR "Missing production verification completion for ${case}")
    endif()
    foreach(name tape.qtp schema.tsv expected.tsv)
        file(SHA256 "${INPUT}/${case}/${name}" after)
        if(NOT after STREQUAL "${before_${name}}")
            message(FATAL_ERROR "Input bytes changed during verification for ${case}/${name}")
        endif()
    endforeach()
    if(mode_exists)
        file(SHA256 "${INPUT}/${case}/schema-mode.txt" mode_after)
        if(NOT mode_after STREQUAL mode_before)
            message(FATAL_ERROR "Schema mode bytes changed during verification for ${case}")
        endif()
    elseif(EXISTS "${INPUT}/${case}/schema-mode.txt")
        message(FATAL_ERROR "Schema mode appeared during verification for ${case}")
    endif()
endforeach()
foreach(name IN LISTS source_paths)
    file(SHA256 "${schema_export_repo}/${name}" after)
    if(NOT after STREQUAL "${source_before_${name}}")
        message(FATAL_ERROR "Source snapshot changed during verification: ${name}")
    endif()
endforeach()
file(SHA256 "${PRODUCER}" producer_after)
if(NOT producer_after STREQUAL producer_hash)
    message(FATAL_ERROR "Producer artifact changed during verification")
endif()
schema_export_environment()
schema_export_classpath(after_receipt unused)
if(NOT after_receipt STREQUAL actual_receipt)
    message(FATAL_ERROR "Provider bytes changed during verification")
endif()
file(WRITE "${RUN}/classpath-receipt.json" "${actual_receipt}")
string(TIMESTAMP ended "%Y-%m-%dT%H:%M:%SZ" UTC)
string(APPEND provenance "complete\t${case_count}\t${schema_export_commit}\n")
file(WRITE "${RUN}/provenance.tsv" "${provenance}")
file(WRITE "${RUN}/bounds.tsv" "phase\tstartUtc\tendUtc\nverify\t${started}\t${ended}\n")
message(STATUS "Production writer interoperability PASS: ${case_count} cases")
