cmake_minimum_required(VERSION 3.25)

# Shadow caller cache variables; only a directory created below is owned here.
set(tempRoot "")

# Filenames stay in JSON/individual quoted variables, never in CMake lists.
function(jsonString output value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(fail reason)
    if(NOT tempRoot STREQUAL "")
        file(REMOVE_RECURSE "${tempRoot}")
    endif()
    message(FATAL_ERROR "${reason}")
endfunction()

if(NOT DEFINED ROOT)
    get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
file(REAL_PATH "${ROOT}" ROOT)
if(NOT DEFINED MODE)
    set(MODE Check)
endif()
if(NOT MODE STREQUAL "Check" AND NOT MODE STREQUAL "Format")
    fail("MODE must be Check or Format")
endif()
foreach(config .uncrustify.cfg .clang-format)
    if(NOT EXISTS "${ROOT}/${config}" OR IS_DIRECTORY "${ROOT}/${config}")
        fail("Missing configuration: ${config}")
    endif()
endforeach()

set(selected "[]")
if(DEFINED FILES)
    if(NOT EXISTS "${FILES}" OR IS_DIRECTORY "${FILES}")
        fail("FILES must name a JSON array manifest")
    endif()
    file(READ "${FILES}" selected)
    string(JSON type ERROR_VARIABLE error TYPE "${selected}")
    if(error OR NOT type STREQUAL "ARRAY")
        fail("FILES must contain a JSON array")
    endif()
else()
    # Git C-quotes controls/quotes/backslashes. core.quotepath=false leaves UTF-8
    # intact; decoding each complete line precedes all path selection/tool calls.
    execute_process(COMMAND git -c core.quotepath=false -C "${ROOT}" ls-files
        --cached --others --exclude-standard
        RESULT_VARIABLE result OUTPUT_VARIABLE inventory ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        fail("Source discovery failed: ${error}")
    endif()
    set(index 0)
    while(NOT inventory STREQUAL "")
        string(FIND "${inventory}" "\n" end)
        if(end EQUAL -1)
            set(line "${inventory}")
            set(inventory "")
        else()
            string(SUBSTRING "${inventory}" 0 ${end} line)
            math(EXPR next "${end}+1")
            string(SUBSTRING "${inventory}" ${next} -1 inventory)
        endif()
        string(REGEX REPLACE "\r$" "" line "${line}")
        if(line STREQUAL "")
            continue()
        endif()
        if(line MATCHES "^\"")
            # JSON understands Git's escapes except bell/vertical-tab and octal.
            # Git uses octal for remaining ASCII control bytes even with quotepath=false.
            set(decoded "")
            string(LENGTH "${line}" length)
            math(EXPR last "${length}-1")
            set(position 1)
            while(position LESS last)
                string(SUBSTRING "${line}" ${position} 1 character)
                if(character STREQUAL "\\")
                    math(EXPR position "${position}+1")
                    string(SUBSTRING "${line}" ${position} 1 escape)
                    if(escape MATCHES "[0-7]")
                        string(SUBSTRING "${line}" ${position} 3 octal)
                        string(SUBSTRING "${octal}" 0 1 first)
                        string(SUBSTRING "${octal}" 1 1 second)
                        string(SUBSTRING "${octal}" 2 1 third)
                        math(EXPR byte "${first}*64+${second}*8+${third}")
                        string(ASCII ${byte} character)
                        math(EXPR position "${position}+2")
                    elseif(escape STREQUAL "a")
                        string(ASCII 7 character)
                    elseif(escape STREQUAL "v")
                        string(ASCII 11 character)
                    else()
                        string(JSON character ERROR_VARIABLE error GET "[\"\\${escape}\"]" 0)
                        if(error)
                            fail("Unsupported Git filename escape")
                        endif()
                    endif()
                endif()
                string(APPEND decoded "${character}")
                math(EXPR position "${position}+1")
            endwhile()
            set(line "${decoded}")
        endif()
        if(line MATCHES "[\r\n]")
            fail("CR/LF-containing filenames are unsupported")
        endif()
        if(line MATCHES "^(include/.*\\.hpp|src/.*\\.cpp|tests/conformance/.*\\.cpp|examples/subscriptions/.*\\.(cpp|hpp)|tools/(qtp-inspect|tape-inspect|tape-write|subscribe|dev)/.*\\.(cpp|hpp))$"
            AND NOT line MATCHES "(^|/)(upstream|generated|fixtures)/")
            jsonString(quoted "${line}")
            string(JSON selected SET "${selected}" ${index} "${quoted}")
            math(EXPR index "${index}+1")
        endif()
    endwhile()
endif()
string(JSON count LENGTH "${selected}")
if(count EQUAL 0)
    fail("No C++ source files selected")
endif()
math(EXPR last "${count}-1")
set(sources "[]")
foreach(index RANGE 0 ${last})
    string(JSON type TYPE "${selected}" ${index})
    if(NOT type STREQUAL "STRING")
        fail("Every FILES entry must be a string")
    endif()
    string(JSON path GET "${selected}" ${index})
    if(path MATCHES "[\r\n]")
        fail("CR/LF-containing filenames are unsupported")
    endif()
    string(FIND "${path}" "\\" backslash)
    if(UNIX AND NOT backslash EQUAL -1)
        fail("Literal backslash source filenames are unsupported by the CMake path grammar")
    endif()
    # Normalize lexical traversal before resolving aliases, then validate both.
    get_filename_component(source "${path}" ABSOLUTE BASE_DIR "${ROOT}")
    file(RELATIVE_PATH relative "${ROOT}" "${source}")
    if(WIN32)
        string(TOLOWER "${relative}" relative)
    endif()
    if(NOT relative MATCHES "^(include/|src/|tests/conformance/|examples/subscriptions/|tools/(qtp-inspect|tape-inspect|tape-write|subscribe|dev)/|\\.work/)"
        OR relative MATCHES "(^|/)(upstream|generated|fixtures)/" OR NOT relative MATCHES "\\.(cpp|hpp)$")
        fail("Outside formatting scope: ${path}")
    endif()
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        fail("Missing source: ${path}")
    endif()
    file(REAL_PATH "${source}" resolved)
    file(RELATIVE_PATH relative "${ROOT}" "${resolved}")
    if(WIN32)
        string(TOLOWER "${relative}" relative)
    endif()
    if(NOT relative MATCHES "^(include/|src/|tests/conformance/|examples/subscriptions/|tools/(qtp-inspect|tape-inspect|tape-write|subscribe|dev)/|\\.work/)"
        OR relative MATCHES "(^|/)(upstream|generated|fixtures)/" OR NOT relative MATCHES "\\.(cpp|hpp)$")
        fail("Resolved source outside formatting scope: ${path}")
    endif()
    jsonString(quoted "${resolved}")
    string(JSON sources SET "${sources}" ${index} "${quoted}")
endforeach()

foreach(tool UNCRUSTIFY CLANG_FORMAT)
    if(NOT DEFINED ${tool} OR NOT EXISTS "${${tool}}" OR IS_DIRECTORY "${${tool}}")
        fail("Missing formatter: ${tool}; supply an explicit native executable")
    endif()
    file(REAL_PATH "${${tool}}" executable)
    set(${tool} "${executable}")
    execute_process(COMMAND "${executable}" --version RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(tool STREQUAL "UNCRUSTIFY")
        set(version "Uncrustify-0\\.83\\.0([^0-9.]|$)")
    else()
        set(version "clang-format version 20\\.1\\.8([^0-9.]|$)")
    endif()
    if(NOT result STREQUAL "0" OR NOT "${output}${error}" MATCHES "${version}")
        fail("Wrong formatter version: ${tool}: ${output}${error}")
    endif()
endforeach()

file(MAKE_DIRECTORY "${ROOT}/.work")
file(REAL_PATH "${ROOT}/.work" workRoot)
file(RELATIVE_PATH workRelative "${ROOT}" "${workRoot}")
if(NOT workRelative STREQUAL ".work")
    fail("Unsafe temporary root: .work must resolve directly inside ROOT")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef token)
set(tempRoot "${workRoot}/format-portable-${token}")
file(MAKE_DIRECTORY "${tempRoot}")
set(mismatches "")
foreach(index RANGE 0 ${last})
    string(JSON source GET "${sources}" ${index})
    # clang-format uses the source basename to recognize its corresponding header.
    # An index directory avoids collisions without changing that semantic input.
    get_filename_component(basename "${source}" NAME)
    file(MAKE_DIRECTORY "${tempRoot}/${index}")
    set(copy "${tempRoot}/${index}/${basename}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${source}" "${copy}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        fail("Cannot copy source: ${source}")
    endif()
    execute_process(COMMAND "${UNCRUSTIFY}" -c "${ROOT}/.uncrustify.cfg" --no-backup -l CPP "${copy}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    string(TOLOWER "${output}${error}" diagnostic)
    if(NOT result STREQUAL "0" OR diagnostic MATCHES "warning|error|unknown|invalid")
        fail("Uncrustify failed (${result}): ${output}${error}")
    endif()
    if(NOT EXISTS "${copy}")
        fail("Uncrustify removed its temporary output")
    endif()
    execute_process(COMMAND "${CLANG_FORMAT}" --Werror "--style=file:${ROOT}/.clang-format" -i "${copy}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    string(STRIP "${output}${error}" diagnostic)
    if(NOT result STREQUAL "0" OR NOT diagnostic STREQUAL "")
        fail("clang-format failed (${result}): ${output}${error}")
    endif()
    if(NOT EXISTS "${source}" OR NOT EXISTS "${copy}")
        fail("Formatter removed an input or its temporary output")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${source}" "${copy}" RESULT_VARIABLE different)
    if(NOT different STREQUAL "0")
        if(MODE STREQUAL "Format")
            execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${copy}" "${source}" RESULT_VARIABLE result)
            if(NOT result STREQUAL "0")
                fail("Cannot publish source: ${source}")
            endif()
        else()
            string(APPEND mismatches "\n${source}")
        endif()
    endif()
endforeach()
file(REMOVE_RECURSE "${tempRoot}")
set(tempRoot "")
if(NOT mismatches STREQUAL "")
    fail("Formatting mismatch:${mismatches}")
endif()
message(STATUS "${MODE} passed: ${count} C++ files (Uncrustify 0.83.0 -> clang-format 20.1.8)")
