cmake_minimum_required(VERSION 3.25)
# First-build exception: raw command streams with UTC phase bounds, not line timestamps.
if(NOT DEFINED SOURCE)
    cmake_path(GET CMAKE_CURRENT_LIST_DIR PARENT_PATH tools)
    cmake_path(GET tools PARENT_PATH SOURCE)
endif()
foreach(required BINARY LOG)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Bootstrap requires -D${required}=<path>")
    endif()
endforeach()
if(NOT DEFINED CONFIG)
    set(CONFIG Debug)
endif()
cmake_path(ABSOLUTE_PATH SOURCE NORMALIZE)
cmake_path(ABSOLUTE_PATH BINARY NORMALIZE)
cmake_path(ABSOLUTE_PATH LOG NORMALIZE)
if(BINARY STREQUAL SOURCE OR BINARY STREQUAL "${SOURCE}/tools/dev")
    message(FATAL_ERROR "Bootstrap requires a separate build directory outside source roots")
endif()
cmake_path(GET LOG PARENT_PATH log_parent)
file(MAKE_DIRECTORY "${log_parent}")
file(WRITE "${LOG}" "QDCXX bootstrap: raw streams; UTC phase bounds\n")

function(bootstrap_phase phase)
    string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(APPEND "${LOG}" "${started} START ${phase}\nCOMMAND")
    math(EXPR final_index "${ARGC} - 1")
    set(command)
    foreach(index RANGE 1 ${final_index})
        set(argument "${ARGV${index}}")
        string(LENGTH "${argument}" length)
        file(APPEND "${LOG}" " [${length}:${argument}]")
        string(REPLACE ";" "\\;" argument "${argument}")
        list(APPEND command "${argument}")
    endforeach()
    file(APPEND "${LOG}" "\n")
    execute_process(COMMAND ${command} RESULT_VARIABLE result
        OUTPUT_FILE "${LOG}.${phase}.stdout" ERROR_FILE "${LOG}.${phase}.stderr")
    file(READ "${LOG}.${phase}.stdout" output)
    file(READ "${LOG}.${phase}.stderr" error)
    file(APPEND "${LOG}" "STDOUT BEGIN\n${output}\nSTDOUT END\nSTDERR BEGIN\n${error}\nSTDERR END\n")
    string(TIMESTAMP ended "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(APPEND "${LOG}" "${ended} EXIT ${phase} ${result}\n")
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Bootstrap ${phase} failed (${result}); see ${LOG}")
    endif()
endfunction()

set(configure_arguments -S "${SOURCE}/tools/dev" -B "${BINARY}" "-DCMAKE_BUILD_TYPE=${CONFIG}")
if(DEFINED GENERATOR)
    list(APPEND configure_arguments -G "${GENERATOR}")
endif()
if(DEFINED CONFIGURE_ARGS)
    string(JSON argument_count ERROR_VARIABLE json_error LENGTH "${CONFIGURE_ARGS}")
    string(JSON argument_type ERROR_VARIABLE json_error TYPE "${CONFIGURE_ARGS}")
    if(json_error OR NOT argument_type STREQUAL "ARRAY")
        message(FATAL_ERROR "CONFIGURE_ARGS must be a JSON array of strings")
    endif()
    if(argument_count GREATER 0)
        math(EXPR last_argument "${argument_count} - 1")
        foreach(index RANGE 0 ${last_argument})
            string(JSON argument_type TYPE "${CONFIGURE_ARGS}" ${index})
            if(NOT argument_type STREQUAL "STRING")
                message(FATAL_ERROR "CONFIGURE_ARGS must contain strings")
            endif()
            string(JSON argument GET "${CONFIGURE_ARGS}" ${index})
            string(REPLACE ";" "\\;" argument "${argument}")
            list(APPEND configure_arguments "${argument}")
        endforeach()
    endif()
endif()
bootstrap_phase(configure "${CMAKE_COMMAND}" ${configure_arguments})
bootstrap_phase(build "${CMAKE_COMMAND}" --build "${BINARY}" --config "${CONFIG}" --parallel)
message(STATUS "Developer tools bootstrapped; evidence: ${LOG}")
