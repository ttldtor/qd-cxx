cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED PROGRAM)
    message(FATAL_ERROR "PROGRAM is required")
endif()

function(run result expected)
    execute_process(COMMAND "${PROGRAM}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 4)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Args '${ARGN}': expected ${expected}, got ${status}. ${err}")
    endif()
    set(${result} "${out}" PARENT_SCOPE)
endfunction()

run(noargs 0)
run(english 0 --help)
run(russian 0 --help-ru)
if(NOT noargs STREQUAL english OR NOT english MATCHES "^Usage:" OR NOT russian MATCHES "^Использование:")
    message(FATAL_ERROR "Unexpected offline help")
endif()
if(EVENT_MODE)
    foreach(text IN ITEMS english russian)
        foreach(option port duration rate batch startup record symbol contract clients address start-signal pacing tcp-no-delay)
            if(NOT ${text} MATCHES "--${option}")
                message(FATAL_ERROR "Help ${text} does not explain --${option}")
            endif()
        endforeach()
    endforeach()
    run(result 2 p)
    run(result 2 p --port 0 --batch 9)
    run(result 2 p --port 0 --record Quote --contract ticker --batch 2)
    run(result 2 p --port 0 --symbol MSFT)
    run(result 2 p --port 0 --contract ticker)
    run(result 2 p --port 0 --record Quote)
    run(result 2 p --port 0 --clients 0)
    run(result 2 p --port 0 --clients 9)
    run(result 2 p --port 0 --start-signal other)
    run(result 2 p --port 0 --pacing other)
    run(result 2 p --port 0 --tcp-no-delay 2)
    run(result 2 p --port 0 --record Quote --contract stream)
    run(result 2 p --port 0 --record TimeAndSale --contract ticker)
    return()
endif()
foreach(text IN ITEMS english russian)
