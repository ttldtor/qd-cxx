{
  "title": "qd-cxx NetTest",
  "uid": "qd-cxx-nettest",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "title": "Configured source rate and total deliveries",
      "type": "timeseries",
      "id": 1,
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "targets": [
        {"expr": "qdcxx_nettest_offered_records_per_second", "legendFormat": "offered {{producer}} {{contract}} {{clients}} clients"},
        {"expr": "qdcxx_nettest_delivered_records_per_second", "legendFormat": "deliveries {{producer}} {{contract}} {{clients}} clients"}
      ]
    },
    {
      "title": "Producer CPU seconds in sampled window",
      "type": "timeseries",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"expr": "qdcxx_nettest_producer_cpu_seconds", "legendFormat": "{{producer}} {{contract}} {{clients}} clients"}]
    },
    {
      "title": "Producer sampled peak working set",
      "type": "timeseries",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [{"expr": "qdcxx_nettest_producer_peak_working_set_bytes", "legendFormat": "{{producer}} {{contract}} {{clients}} clients"}]
    },
    {
      "title": "Receiver p95 record age",
      "type": "timeseries",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"expr": "qdcxx_nettest_receiver_latency_p95_seconds", "legendFormat": "client {{client}} {{contract}}"}]
    },
    {
      "title": "Receiver sampled peak working set",
      "type": "timeseries",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [{"expr": "qdcxx_nettest_receiver_peak_working_set_bytes", "legendFormat": "client {{client}} {{contract}}"}]
    }
  ]
}
