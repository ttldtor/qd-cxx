# Internal Build.cmake staging: explicit Markdown links, public regular assets and public headers.
# Input SOURCE/stage/OUTPUT are validated by the caller. Unsupported references fail; no deletion occurs.
function(public_path relative result)
    if(relative MATCHES "[;\r\n]")
        message(FATAL_ERROR "Private or unsupported documentation path: ${relative}")
    endif()
    set(candidate "${SOURCE}/${relative}")
    cmake_path(NORMAL_PATH candidate)
    string(REGEX REPLACE "/+$" "" candidate "${candidate}")
    cmake_path(IS_PREFIX SOURCE "${candidate}" NORMALIZE inside)
    if(NOT inside OR NOT EXISTS "${candidate}")
        message(FATAL_ERROR "Missing or escaping local documentation reference: ${relative}")
    endif()
    file(RELATIVE_PATH normalized_relative "${SOURCE}" "${candidate}")
    string(TOLOWER "${normalized_relative}" folded_relative)
    if(folded_relative MATCHES "(^|/)\\.[^/]+/" OR (IS_DIRECTORY "${candidate}" AND folded_relative MATCHES "(^|/)\\.[^/]+$"))
        message(FATAL_ERROR "Private or unsupported documentation directory: ${relative}")
    endif()
    if(folded_relative MATCHES "\\.(key|p12|pfx)$" AND NOT normalized_relative MATCHES "^tests/fixtures/transport/tls/server(-rsa4096)?\\.key$")
        message(FATAL_ERROR "Unapproved private-key reference: ${relative}")
    endif()
    file(REAL_PATH "${candidate}" actual)
    if(NOT actual STREQUAL candidate OR IS_SYMLINK "${candidate}")
        message(FATAL_ERROR "Documentation references may not traverse symlinks/reparse aliases: ${relative}")
    endif()
    if(NOT IS_DIRECTORY "${candidate}")
        file(SIZE "${candidate}" bytes)
        if(bytes GREATER MAX_FILE_BYTES)
            message(FATAL_ERROR "Documentation source exceeds MAX_FILE_BYTES: ${relative}")
        endif()
    endif()
    set(${result} "${candidate}" PARENT_SCOPE)
endfunction()

function(charge_source absolute)
    file(SIZE "${absolute}" bytes)
    get_property(total_bytes GLOBAL PROPERTY docs_source_bytes)
    math(EXPR total_bytes "${total_bytes} + ${bytes}")
    if(total_bytes GREATER MAX_SOURCE_BYTES)
        message(FATAL_ERROR "Markdown/header inputs exceed MAX_SOURCE_BYTES")
    endif()
    set_property(GLOBAL PROPERTY docs_source_bytes ${total_bytes})
endfunction()
function(stage_asset relative)
    public_path("${relative}" absolute)
    get_property(assets GLOBAL PROPERTY docs_assets)
    if(relative IN_LIST assets)
        return()
    endif()
    list(LENGTH assets count)
    if(count GREATER_EQUAL MAX_ASSETS)
        message(FATAL_ERROR "Documentation exceeds MAX_ASSETS")
    endif()
    set_property(GLOBAL APPEND PROPERTY docs_assets "${relative}")
    cmake_path(GET relative PARENT_PATH parent)
    file(MAKE_DIRECTORY "${OUTPUT}/html/assets/${parent}")
    if(IS_DIRECTORY "${absolute}")
        set(allowed FALSE)
        foreach(directory IN LISTS DOC_ASSET_DIRECTORIES)
            set(directory_root "${SOURCE}/${directory}")
            cmake_path(IS_PREFIX directory_root "${absolute}" NORMALIZE under_directory)
            if(under_directory)
                set(allowed TRUE)
                break()
            endif()
        endforeach()
        if(NOT allowed)
            message(FATAL_ERROR "Unsupported directory reference; link a file or register a finite public asset directory: ${relative}")
        endif()
        file(MAKE_DIRECTORY "${OUTPUT}/html/assets/${relative}")
        file(GLOB children RELATIVE "${absolute}" "${absolute}/*")
        set(index "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><title>Reference files</title><h1>Reference files</h1><ul>\n")
        foreach(child IN LISTS children)
            if(NOT child MATCHES "^[A-Za-z0-9_.-]+$")
                message(FATAL_ERROR "Unsupported asset filename: ${child}")
            endif()
            stage_asset("${relative}/${child}")
            if(IS_DIRECTORY "${absolute}/${child}")
                set(href "${child}/index.html")
            else()
                set(href "${child}")
            endif()
            string(APPEND index "<li><a href=\"${href}\">${child}</a></li>\n")
        endforeach()
        file(WRITE "${OUTPUT}/html/assets/${relative}/index.html" "${index}</ul></html>\n")
    else()
        file(SIZE "${absolute}" bytes)
        get_property(total_bytes GLOBAL PROPERTY docs_asset_bytes)
        math(EXPR total_bytes "${total_bytes} + ${bytes}")
        if(total_bytes GREATER MAX_ASSET_BYTES)
            message(FATAL_ERROR "Referenced raw assets exceed MAX_ASSET_BYTES")
        endif()
        set_property(GLOBAL PROPERTY docs_asset_bytes ${total_bytes})
        file(COPY_FILE "${absolute}" "${OUTPUT}/html/assets/${relative}" ONLY_IF_DIFFERENT)
        file(SHA256 "${absolute}" hash)
        file(APPEND "${OUTPUT}/assets.tsv" "${relative}\t${hash}\n")
    endif()
endfunction()

function(html_attribute input result)
    string(REPLACE "&" "&amp;" escaped "${input}")
    string(REPLACE "\"" "&quot;" escaped "${escaped}")
    string(REPLACE "<" "&lt;" escaped "${escaped}")
    string(REPLACE ">" "&gt;" escaped "${escaped}")
    set(${result} "${escaped}" PARENT_SCOPE)
endfunction()

function(link_target relative destination result)
    set(${result}_raw FALSE PARENT_SCOPE)
    if(destination MATCHES "^([A-Za-z][A-Za-z0-9+.-]*:|#)")
        set(${result} "${destination}" PARENT_SCOPE)
        return()
    endif()
    if(destination MATCHES "^<([^>]+)>(.*)$")
        set(path "${CMAKE_MATCH_1}")
        set(title "${CMAKE_MATCH_2}")
    elseif(destination MATCHES "^([^ \t]+)([ \t]+\"[^\"]*\")?$")
        set(path "${CMAKE_MATCH_1}")
        set(title "${CMAKE_MATCH_2}")
    else()
        message(FATAL_ERROR "Unsupported local link syntax in ${relative}: ${destination}")
    endif()
    if(NOT title STREQUAL "" AND NOT title MATCHES "^[ \t]+\"[^\"]*\"$")
        message(FATAL_ERROR "Unsupported local link title in ${relative}")
    endif()
    if(path MATCHES "^([^?#]*)([?#].*)$")
        set(path "${CMAKE_MATCH_1}")
        set(tail "${CMAKE_MATCH_2}")
    else()
        set(tail "")
    endif()
    cmake_path(GET relative PARENT_PATH parent)
    set(absolute "${SOURCE}/${parent}/${path}")
    cmake_path(NORMAL_PATH absolute)
    cmake_path(RELATIVE_PATH absolute BASE_DIRECTORY "${SOURCE}" OUTPUT_VARIABLE target)
    string(REGEX REPLACE "/+$" "" target "${target}")
    public_path("${target}" checked)
    if(IS_DIRECTORY "${checked}" AND EXISTS "${checked}/README.md")
        string(APPEND target "/README.md")
        string(APPEND path "/README.md")
        string(REGEX REPLACE "/+$" "" target "${target}")
        public_path("${target}" checked)
    endif()
    # The configured main page is a page/anchor, not its otherwise empty file-reference wrapper.
    if(target STREQUAL "docs/index.md" AND NOT tail MATCHES "#")
        string(APPEND tail "#documentation")
    endif()
    if(target MATCHES "\\.md$")
        get_property(pages GLOBAL PROPERTY docs_pages)
        if(NOT target IN_LIST pages)
            set_property(GLOBAL APPEND PROPERTY docs_pages "${target}")
        endif()
        set(replacement "${target}${tail}${title}")
    elseif(target MATCHES "^include/qd/.*\\.hpp$")
        set(replacement "${target}${tail}${title}")
    else()
        stage_asset("${target}")
        set(asset "assets/${target}")
        if(IS_DIRECTORY "${checked}")
            string(APPEND asset "/index.html")
        endif()
        set(replacement "${asset}${tail}${title}")
        set(${result}_raw TRUE PARENT_SCOPE)
        html_attribute("${asset}${tail}" escaped_url)
        set(${result}_url "${escaped_url}" PARENT_SCOPE)
        string(STRIP "${title}" title)
        if(NOT title STREQUAL "")
            string(LENGTH "${title}" title_length)
            math(EXPR title_length "${title_length} - 2")
            string(SUBSTRING "${title}" 1 ${title_length} title_text)
            # Doxygen escapes title text on output; entity-escaping it here would double-encode it.
            set(${result}_title " title=\"${title_text}\"" PARENT_SCOPE)
        else()
            set(${result}_title "" PARENT_SCOPE)
        endif()
    endif()
    set(${result} "${replacement}" PARENT_SCOPE)
endfunction()

function(stage_markdown relative)
    public_path("${relative}" absolute)
    charge_source("${absolute}")
    file(READ "${absolute}" remaining_lines)
    string(REPLACE "\r\n" "\n" remaining_lines "${remaining_lines}")
    set(content "")
    set(fence "")
    while(NOT remaining_lines STREQUAL "")
        string(FIND "${remaining_lines}" "\n" newline)
        if(newline LESS 0)
            set(line "${remaining_lines}")
            set(remaining_lines "")
        else()
            string(SUBSTRING "${remaining_lines}" 0 ${newline} line)
            math(EXPR after_newline "${newline} + 1")
            string(SUBSTRING "${remaining_lines}" ${after_newline} -1 remaining_lines)
        endif()
        if(NOT fence STREQUAL "")
            if(line MATCHES "^[ \t]*(${fence_character}+)[ \t]*$")
                string(LENGTH "${CMAKE_MATCH_1}" closing_length)
                if(closing_length GREATER_EQUAL fence_length)
                    set(fence "")
                endif()
            endif()
            string(APPEND content "${line}\n")
            continue()
        endif()
        if(line MATCHES "^[ \t]*(```+|~~~+)")
            set(fence "${CMAKE_MATCH_1}")
            string(SUBSTRING "${fence}" 0 1 fence_character)
            string(LENGTH "${fence}" fence_length)
            string(APPEND content "${line}\n")
            continue()
        endif()
        if(fence STREQUAL "")
            # Code spans are left verbatim; fenced snippets are never interpreted as links.
            if(line MATCHES "``" AND line MATCHES "\\]\\(")
                message(FATAL_ERROR "Links on extended-backtick lines are unsupported: ${relative}")
            endif()
            if(line MATCHES "QDCXX_DOC_LITERAL_[0-9]+_")
                message(FATAL_ERROR "Reserved staging marker in ${relative}")
            endif()
            set(scan "${line}")
            set(code_count 0)
            while(TRUE)
                string(REGEX MATCH "`[^`]*`" code "${scan}")
                if(code STREQUAL "")
                    break()
                endif()
                set(code_${code_count} "${code}")
                string(REPLACE "${code}" "QDCXX_DOC_LITERAL_${code_count}_" scan "${scan}")
                math(EXPR code_count "${code_count} + 1")
            endwhile()
            set(line "${scan}")
            set(remaining "${scan}")
            set(rewritten "")
            while(TRUE)
                string(REGEX MATCH "\\]\\(([^)\n]*)\\)" link "${remaining}")
                if(link STREQUAL "")
                    break()
                endif()
                set(destination "${CMAKE_MATCH_1}")
                string(FIND "${remaining}" "${link}" start)
                string(SUBSTRING "${remaining}" 0 ${start} prefix)
                string(LENGTH "${link}" length)
                math(EXPR next "${start} + ${length}")
                string(SUBSTRING "${remaining}" ${next} -1 remaining)
                link_target("${relative}" "${destination}" replacement)
                if(replacement_raw)
                    string(FIND "${prefix}" "[" label_start REVERSE)
                    if(label_start LESS 0)
                        message(FATAL_ERROR "Unsupported raw-asset link label in ${relative}")
                    endif()
                    string(SUBSTRING "${prefix}" 0 ${label_start} before_label)
                    math(EXPR label_start "${label_start} + 1")
                    string(SUBSTRING "${prefix}" ${label_start} -1 label)
                    if(label MATCHES "\\[|\\]" OR before_label MATCHES "!$")
                        message(FATAL_ERROR "Nested labels/local images are unsupported raw-asset syntax: ${relative}")
                    endif()
                    # Inline label markup remains Doxygen input, not a second Markdown renderer.
                    string(APPEND rewritten "${before_label}<a href=\"${replacement_url}\"${replacement_title}>${label}</a>")
                else()
                    string(APPEND rewritten "${prefix}](${replacement})")
                endif()
            endwhile()
            string(APPEND rewritten "${remaining}")
            set(line "${rewritten}")
            if(scan MATCHES "^([ \t]*\\[[^]]+\\]:[ \t]*)(.+)$")
                set(prefix "${CMAKE_MATCH_1}")
                set(destination "${CMAKE_MATCH_2}")
                link_target("${relative}" "${destination}" replacement)
                if(replacement_raw)
                    message(FATAL_ERROR "Raw-asset reference definitions are unsupported; use an inline link: ${relative}")
                endif()
                set(line "${prefix}${replacement}")
            endif()
            set(code_index 0)
            while(code_index LESS code_count)
                string(REPLACE "QDCXX_DOC_LITERAL_${code_index}_" "${code_${code_index}}" line "${line}")
                math(EXPR code_index "${code_index} + 1")
            endwhile()
        endif()
        string(APPEND content "${line}\n")
    endwhile()
    if(NOT fence STREQUAL "")
        message(FATAL_ERROR "Unclosed Markdown code fence: ${relative}")
    endif()
    cmake_path(GET relative PARENT_PATH parent)
    file(MAKE_DIRECTORY "${stage}/${parent}")
    file(WRITE "${stage}/${relative}" "${content}")
    file(SHA256 "${absolute}" hash)
    file(APPEND "${OUTPUT}/sources.tsv" "${relative}\t${hash}\n")
endfunction()
