# Locate generated targets by source location, independently of the staging link spelling.
function(document_html relative kind result)
    file(GLOB documents "${TEST_ROOT}/native/xml/*.xml")
    foreach(document IN LISTS documents)
        file(READ "${document}" xml)
        string(FIND "${xml}" "<location file=\"${relative}\"" location)
        if(location GREATER_EQUAL 0 AND xml MATCHES "<compounddef id=\"([^\"]+)\" kind=\"${kind}\"")
            set(id "${CMAKE_MATCH_1}")
            if(id STREQUAL "indexpage")
                set(id index)
            endif()
            set(${result} "${id}.html" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Generated document missing: ${relative}")
endfunction()
