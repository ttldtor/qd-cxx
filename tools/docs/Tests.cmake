    string(REPLACE "|" ";" names "${pair}")
    list(GET names 0 from)
    list(GET names 1 to)
    file(READ "${TEST_ROOT}/native/html/${${from}}" html)
    string(FIND "${html}" "href=\"${${to}}\"" correct)
    if(correct LESS 0)
        message(FATAL_ERROR "Same-basename language link chose the wrong generated page")
    endif()
endforeach()
