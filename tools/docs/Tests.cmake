function(reject name expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${TEST_ROOT}/source" "-DDOXYGEN=${DOXYGEN}" ${ARGN} -P "${builder}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(WRITE "${TEST_ROOT}/${name}.log" "${out}${err}")
    if(NOT code EQUAL 1 OR NOT "${out}${err}" MATCHES "${expected}")
        message(FATAL_ERROR "Expected refusal absent: ${name}; code=${code}")
    endif()
endfunction()
