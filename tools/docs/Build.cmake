cmake_minimum_required(VERSION 3.25)

# Help must precede path inspection, discovery, directory creation and execution.
if(HELP)
    message("Build qd-cxx HTML/API documentation with Doxygen 1.18+.\nUsage: cmake [-DDOXYGEN=/path/to/doxygen] [-DOUTPUT=/new/output] [-DSOURCE=/source/root] -P tools/docs/Build.cmake\nDefaults: SOURCE is this checkout; OUTPUT is SOURCE/.work/docs; DOXYGEN is found on PATH.\nHELP=ON prints this help without input checks or file/process side effects.\nThe builder follows explicit local Markdown links from docs/index.md and its Russian version, copies public headers and referenced regular assets, then runs Doxygen. It does not access the network.\nLimits (configurable positive integers): MAX_PAGES=1024, MAX_ASSETS=4096, MAX_FILE_BYTES=8388608, MAX_ASSET_BYTES=67108864, MAX_SOURCE_BYTES=67108864; local inline links, Markdown/header reference definitions, single-backtick spans and fenced code; raw-asset reference definitions/local images/nested labels fail explicitly. Unsupported paths/syntax fail explicitly. Private paths, symlinks and private keys are rejected.\nOutput must be empty or marked by this builder for the same SOURCE. Owned generated files may be overwritten; no directories are deleted. Choose a new output to exclude obsolete generated files.\nExit 0: success/help. Exit 1: invalid configuration, staging or Doxygen failure. CMake launcher errors retain their native exit status.\nResults: OUTPUT/html/index.html, warnings.log, source/asset inventories and generated configuration. See tools/docs/README.md and README.ru.md.")
    return()
endif()
set(default_MAX_PAGES 1024)
set(default_MAX_ASSETS 4096)
set(default_MAX_FILE_BYTES 8388608)
set(default_MAX_ASSET_BYTES 67108864)
set(default_MAX_SOURCE_BYTES 67108864)
foreach(setting MAX_PAGES MAX_ASSETS MAX_FILE_BYTES MAX_ASSET_BYTES MAX_SOURCE_BYTES)
    if(NOT DEFINED ${setting})
        set(${setting} "${default_${setting}}")
    endif()
    string(LENGTH "${${setting}}" digits)
    if(NOT "${${setting}}" MATCHES "^[1-9][0-9]*$" OR digits GREATER 10 OR ${setting} GREATER 2147483647)
        message(FATAL_ERROR "${setting} must be an integer in 1..2147483647")
    endif()
endforeach()
if(NOT DEFINED SOURCE)
    cmake_path(GET CMAKE_CURRENT_LIST_DIR PARENT_PATH tools_dir)
    cmake_path(GET tools_dir PARENT_PATH SOURCE)
endif()
cmake_path(ABSOLUTE_PATH SOURCE NORMALIZE)
file(REAL_PATH "${SOURCE}" real_source)
if(NOT SOURCE STREQUAL real_source OR NOT EXISTS "${SOURCE}/docs/index.md")
    message(FATAL_ERROR "SOURCE must be a regular checkout containing docs/index.md")
endif()
if(NOT DEFINED OUTPUT)
    set(OUTPUT "${SOURCE}/.work/docs")
endif()
cmake_path(ABSOLUTE_PATH OUTPUT BASE_DIRECTORY "${SOURCE}" NORMALIZE)
cmake_path(IS_PREFIX OUTPUT "${SOURCE}" NORMALIZE output_contains_source)
if(output_contains_source)
    message(FATAL_ERROR "OUTPUT must be separate from SOURCE")
endif()
foreach(protected include src docs spec tools tests cmake .git)
    set(protected_root "${SOURCE}/${protected}")
    cmake_path(IS_PREFIX protected_root "${OUTPUT}" NORMALIZE protected_output)
    if(protected_output)
        message(FATAL_ERROR "OUTPUT overlaps protected source material")
    endif()
endforeach()
set(ancestor "${OUTPUT}")
while(NOT EXISTS "${ancestor}")
    cmake_path(GET ancestor PARENT_PATH ancestor)
endwhile()
file(REAL_PATH "${ancestor}" real_ancestor)
if(NOT ancestor STREQUAL real_ancestor)
    message(FATAL_ERROR "OUTPUT may not traverse a symlink/reparse alias")
endif()
if(EXISTS "${OUTPUT}")
    if(NOT IS_DIRECTORY "${OUTPUT}")
        message(FATAL_ERROR "OUTPUT must be a directory")
    endif()
    file(GLOB existing "${OUTPUT}/*" "${OUTPUT}/.[!.]*")
    if(existing)
        if(NOT EXISTS "${OUTPUT}/.qdcxx-docs")
            message(FATAL_ERROR "Nonempty OUTPUT is not owned by this builder")
        endif()
        if(IS_SYMLINK "${OUTPUT}/.qdcxx-docs")
            message(FATAL_ERROR "OUTPUT ownership marker may not be a symlink")
        endif()
        file(READ "${OUTPUT}/.qdcxx-docs" owner)
        if(NOT owner STREQUAL "${SOURCE}\n")
            message(FATAL_ERROR "OUTPUT belongs to another SOURCE")
        endif()
    endif()
endif()
if(NOT DEFINED DOXYGEN)
    find_program(DOXYGEN NAMES doxygen REQUIRED)
endif()
if(NOT EXISTS "${DOXYGEN}" OR IS_DIRECTORY "${DOXYGEN}")
    message(FATAL_ERROR "Provide a Doxygen executable with -DDOXYGEN=<path>")
endif()
# A prior owned build must not acquire a reparse alias before a later write.
if(EXISTS "${OUTPUT}")
    file(GLOB_RECURSE previous LIST_DIRECTORIES TRUE "${OUTPUT}/*" "${OUTPUT}/.[!.]*")
    foreach(entry IN LISTS previous)
        file(REAL_PATH "${entry}" real_entry)
        if(IS_SYMLINK "${entry}" OR NOT real_entry STREQUAL entry)
            message(FATAL_ERROR "Owned OUTPUT contains a symlink/reparse alias")
        endif()
    endforeach()
endif()
set(stage "${OUTPUT}/input")
file(MAKE_DIRECTORY "${stage}" "${OUTPUT}/html/assets")
file(WRITE "${OUTPUT}/.qdcxx-docs" "${SOURCE}\n")
set_property(GLOBAL PROPERTY docs_pages "docs/index.md;docs/index.ru.md")
set_property(GLOBAL PROPERTY docs_assets "")
set_property(GLOBAL PROPERTY docs_asset_bytes 0)
set_property(GLOBAL PROPERTY docs_source_bytes 0)
file(WRITE "${OUTPUT}/sources.tsv" "path\tsha256\n")
file(WRITE "${OUTPUT}/assets.tsv" "path\tsha256\n")
include("${CMAKE_CURRENT_LIST_DIR}/AssetDirectories.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Stage.cmake")
set(position 0)
while(TRUE)
    get_property(pages GLOBAL PROPERTY docs_pages)
    list(LENGTH pages count)
    if(position GREATER_EQUAL count)
        break()
    endif()
    if(count GREATER MAX_PAGES)
        message(FATAL_ERROR "Documentation exceeds MAX_PAGES")
    endif()
    list(GET pages ${position} relative)
    stage_markdown("${relative}")
    math(EXPR position "${position} + 1")
endwhile()
file(GLOB_RECURSE headers RELATIVE "${SOURCE}" "${SOURCE}/include/qd/*.hpp")
foreach(relative IN LISTS headers)
    public_path("${relative}" absolute)
    cmake_path(GET relative PARENT_PATH parent)
    file(MAKE_DIRECTORY "${stage}/${parent}")
    charge_source("${absolute}")
    file(COPY_FILE "${absolute}" "${stage}/${relative}" ONLY_IF_DIFFERENT)
    file(SHA256 "${absolute}" hash)
    file(APPEND "${OUTPUT}/sources.tsv" "${relative}\t${hash}\n")
endforeach()
set(inputs "\"${stage}/include/qd\"")
foreach(relative IN LISTS pages)
    string(APPEND inputs " \"${stage}/${relative}\"")
endforeach()
file(WRITE "${OUTPUT}/Doxyfile" "@INCLUDE = \"${SOURCE}/tools/docs/Doxyfile\"\nOUTPUT_DIRECTORY = \"${OUTPUT}\"\nWARN_LOGFILE = \"${OUTPUT}/warnings.log\"\nINPUT = ${inputs}\nUSE_MDFILE_AS_MAINPAGE = \"${stage}/docs/index.md\"\nSTRIP_FROM_PATH = \"${stage}\"\nLAYOUT_FILE = \"${SOURCE}/tools/docs/layout.xml\"\n")
execute_process(COMMAND "${DOXYGEN}" "${OUTPUT}/Doxyfile" WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Doxygen failed: ${result}; retained OUTPUT contains diagnostics")
endif()
get_property(assets GLOBAL PROPERTY docs_assets)
list(LENGTH assets asset_count)
message(STATUS "Documentation built: ${OUTPUT}/html/index.html (${count} linked pages, ${asset_count} assets)")
