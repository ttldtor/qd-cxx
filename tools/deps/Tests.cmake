cmake_minimum_required(VERSION 3.25)
# Standalone caller: cmake -DTEST_ROOT=/fresh/tests [-DARCHIVE_CACHE=/archives -DPATCH_EXECUTABLE=/patch] -P tools/deps/Tests.cmake.
# Produces per-case command/output receipts and optionally verified SDKs. Any unexpected result is fatal.
if(HELP)
    if(LANGUAGE STREQUAL "ru")
        message("Проверить CLI подготовки runtime SDK. Запуск: cmake -DTEST_ROOT=/новый/каталог [-DARCHIVE_CACHE=/архивы -DPATCH_EXECUTABLE=/gnu/patch] -P tools/deps/Tests.cmake\nTEST_ROOT обязателен и должен отсутствовать. Без архива выполняются help/OFF и отрицательные проверки без сети; с ARCHIVE_CACHE дополнительно выполняются реальная offline-подготовка и повторная проверка SDK. Артефакты и логи сохраняются, ничего не удаляется. Код 0: выполненные проверки прошли; код 1: ошибка параметров или неожиданное поведение. HELP=ON не требует параметров и не создаёт файлов. LANGUAGE=en/ru выбирает язык справки.")
    else()
        message("Test runtime SDK provisioning. Usage: cmake -DTEST_ROOT=/fresh/tests [-DARCHIVE_CACHE=/archives -DPATCH_EXECUTABLE=/gnu/patch] -P tools/deps/Tests.cmake\nTEST_ROOT is required and must not exist. Without archives: help/OFF and offline negative cases, no network. With ARCHIVE_CACHE: real offline provisioning and SDK cache readback as well. Artifacts/logs retained, nothing deleted. Exit 0: executed cases passed; exit 1: invalid inputs or unexpected behavior. HELP=ON requires no inputs and creates no files. LANGUAGE=en/ru selects help language.")
    endif()
    return()
endif()
if(NOT DEFINED TEST_ROOT OR TEST_ROOT STREQUAL "")
    message(FATAL_ERROR "Supply a fresh TEST_ROOT; use -DHELP=ON for help")
endif()
cmake_path(ABSOLUTE_PATH TEST_ROOT NORMALIZE)
if(EXISTS "${TEST_ROOT}" OR IS_SYMLINK "${TEST_ROOT}")
    message(FATAL_ERROR "TEST_ROOT must be fresh")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}" "${TEST_ROOT}/cwd")
set(helper "${CMAKE_CURRENT_LIST_DIR}/ProvisionRuntime.cmake")
function(check name expected pattern)
    execute_process(COMMAND "${CMAKE_COMMAND}" ${ARGN} -P "${helper}"
        WORKING_DIRECTORY "${TEST_ROOT}/cwd" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${TEST_ROOT}/${name}.log" "COMMAND: ${CMAKE_COMMAND};${ARGN};-P;${helper}\nEXIT: ${result}\n${output}${error}")
    if(NOT result EQUAL expected OR NOT "${output}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Unexpected ${name}: exit=${result}\n${output}${error}")
    endif()
    message(STATUS "${name}: expected exit ${result}\n${output}${error}")
endfunction()
check(help-no-input 0 "DESTINATION" -DHELP=ON)
check(off-no-input 0 "disabled" -DENABLED=OFF)
foreach(language IN ITEMS en ru)
    check("help-${language}" 0 "DESTINATION" -DHELP=ON "-DLANGUAGE=${language}" "-DDESTINATION=${TEST_ROOT}/help-victim" "-DARCHIVE_CACHE=${TEST_ROOT}/help-cache" -DPATCH_EXECUTABLE=/missing)
endforeach()
check(off 0 "disabled" -DENABLED=OFF "-DDESTINATION=${TEST_ROOT}/off-victim" "-DARCHIVE_CACHE=${TEST_ROOT}/off-cache" -DPATCH_EXECUTABLE=/missing)
foreach(victim IN ITEMS help-victim help-victim.lock help-victim.partial help-cache off-victim off-victim.lock off-victim.partial off-cache)
    if(EXISTS "${TEST_ROOT}/${victim}")
        message(FATAL_ERROR "Help/OFF touched ${victim}")
    endif()
endforeach()
file(GLOB helpArtifacts "${TEST_ROOT}/cwd/*")
if(helpArtifacts)
    message(FATAL_ERROR "Help/OFF wrote files in the invocation directory")
endif()
check(no-input 1 QDCXX_DEPS_INPUT)
file(LOCK "${TEST_ROOT}/busy.lock" GUARD PROCESS TIMEOUT 0)
check(destination-busy 1 QDCXX_DEPS_BUSY "-DDESTINATION=${TEST_ROOT}/busy")
if(EXISTS "${TEST_ROOT}/busy" OR EXISTS "${TEST_ROOT}/busy.partial")
    message(FATAL_ERROR "Competing helper published while destination lock was held")
endif()
file(LOCK "${TEST_ROOT}/busy.lock" RELEASE)
file(MAKE_DIRECTORY "${TEST_ROOT}/busy-cache")
file(LOCK "${TEST_ROOT}/busy-cache/.qdcxx-runtime.lock" GUARD PROCESS TIMEOUT 0)
check(cache-busy 1 QDCXX_DEPS_BUSY "-DDESTINATION=${TEST_ROOT}/cache-busy" "-DARCHIVE_CACHE=${TEST_ROOT}/busy-cache" -DOFFLINE=ON "-DPATCH_EXECUTABLE=${CMAKE_COMMAND}")
file(LOCK "${TEST_ROOT}/busy-cache/.qdcxx-runtime.lock" RELEASE)
file(MAKE_DIRECTORY "${TEST_ROOT}/stale.partial")
file(WRITE "${TEST_ROOT}/stale.partial/sentinel" "retain-me")
check(stale 1 QDCXX_DEPS_PARTIAL "-DDESTINATION=${TEST_ROOT}/stale")
file(READ "${TEST_ROOT}/stale.partial/sentinel" retained)
if(NOT retained STREQUAL "retain-me")
    message(FATAL_ERROR "Partial staging was modified")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/empty-stale.partial")
check(empty-stale 1 QDCXX_DEPS_PARTIAL "-DDESTINATION=${TEST_ROOT}/empty-stale")
file(MAKE_DIRECTORY "${TEST_ROOT}/incomplete")
check(incomplete 1 QDCXX_DEPS_PARTIAL "-DDESTINATION=${TEST_ROOT}/incomplete")
file(GLOB incompleteFiles "${TEST_ROOT}/incomplete/*")
file(GLOB emptyStageFiles "${TEST_ROOT}/empty-stale.partial/*")
if(incompleteFiles OR emptyStageFiles OR NOT IS_DIRECTORY "${TEST_ROOT}/incomplete" OR NOT IS_DIRECTORY "${TEST_ROOT}/empty-stale.partial")
    message(FATAL_ERROR "Preexisting empty destination/staging was modified")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/nonempty")
file(WRITE "${TEST_ROOT}/nonempty/sentinel" "retain-existing-directory")
check(nonempty 1 QDCXX_DEPS_PARTIAL "-DDESTINATION=${TEST_ROOT}/nonempty")
file(READ "${TEST_ROOT}/nonempty/sentinel" existingSentinel)
if(NOT existingSentinel STREQUAL "retain-existing-directory" OR EXISTS "${TEST_ROOT}/nonempty/qdcxx-runtime-deps.json")
    message(FATAL_ERROR "Preexisting nonempty destination was modified")
endif()
check(overlap 1 QDCXX_DEPS_PATH "-DDESTINATION=${TEST_ROOT}/overlap" "-DARCHIVE_CACHE=${TEST_ROOT}/overlap/cache")
check(offline-missing 1 QDCXX_DEPS_CACHE_MISSING "-DDESTINATION=${TEST_ROOT}/missing" "-DARCHIVE_CACHE=${TEST_ROOT}/empty-cache" -DOFFLINE=ON "-DPATCH_EXECUTABLE=${CMAKE_COMMAND}")
file(MAKE_DIRECTORY "${TEST_ROOT}/corrupt-cache")
file(WRITE "${TEST_ROOT}/corrupt-cache/asio-1.38.2.tar.gz" "corrupt-cache-sentinel")
file(SHA256 "${TEST_ROOT}/corrupt-cache/asio-1.38.2.tar.gz" before)
check(corrupt-cache 1 QDCXX_DEPS_ARCHIVE_CORRUPT "-DDESTINATION=${TEST_ROOT}/corrupt" "-DARCHIVE_CACHE=${TEST_ROOT}/corrupt-cache" -DOFFLINE=ON "-DPATCH_EXECUTABLE=${CMAKE_COMMAND}")
file(SHA256 "${TEST_ROOT}/corrupt-cache/asio-1.38.2.tar.gz" after)
if(NOT before STREQUAL after OR EXISTS "${TEST_ROOT}/corrupt.partial")
    message(FATAL_ERROR "Corrupt archive was overwritten or extracted")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/partial-cache")
file(WRITE "${TEST_ROOT}/partial-cache/asio-1.38.2.tar.gz.part" "retain-download")
check(partial-download 1 QDCXX_DEPS_PARTIAL "-DDESTINATION=${TEST_ROOT}/download" "-DARCHIVE_CACHE=${TEST_ROOT}/partial-cache" -DOFFLINE=ON "-DPATCH_EXECUTABLE=${CMAKE_COMMAND}")
file(MAKE_DIRECTORY "${TEST_ROOT}/bad-source/asio-asio-1-38-2/include" "${TEST_ROOT}/bad-source/c-ares-1.34.9-qdcxx2")
file(WRITE "${TEST_ROOT}/bad-source/qdcxx-runtime-deps.json" "{\"schemaVersion\":1,\"asioInclude\":\"asio-asio-1-38-2/include\",\"caresSource\":\"c-ares-1.34.9-qdcxx2\"}\n")
file(WRITE "${TEST_ROOT}/bad-source/asio-asio-1-38-2/LICENSE_1_0.txt" "corrupt-source")
check(corrupt-source 1 "Pinned runtime SDK source hash mismatch" "-DDESTINATION=${TEST_ROOT}/bad-source" -DOFFLINE=ON)
file(READ "${TEST_ROOT}/bad-source/asio-asio-1-38-2/LICENSE_1_0.txt" corruptRetained)
if(NOT corruptRetained STREQUAL "corrupt-source")
    message(FATAL_ERROR "Corrupt source was overwritten")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/link-target")
file(CREATE_LINK "${TEST_ROOT}/link-target" "${TEST_ROOT}/link" SYMBOLIC RESULT linkResult)
if(linkResult STREQUAL "0")
    check(symlink 1 QDCXX_DEPS_PATH "-DDESTINATION=${TEST_ROOT}/link/sdk")
else()
    message(STATUS "NOT_CHECKED: symlink case unavailable: ${linkResult}")
endif()
if(DEFINED ARCHIVE_CACHE)
    check(provision 0 "Verified 532" "-DDESTINATION=${TEST_ROOT}/sdk" "-DARCHIVE_CACHE=${ARCHIVE_CACHE}" -DOFFLINE=ON "-DPATCH_EXECUTABLE=${PATCH_EXECUTABLE}")
    file(SHA256 "${TEST_ROOT}/sdk/qdcxx-runtime-deps.json" receiptBefore)
    check(readback 0 "sources reverified" "-DDESTINATION=${TEST_ROOT}/sdk" -DOFFLINE=ON -DPATCH_EXECUTABLE=/missing -DARCHIVE_CACHE=/missing)
    file(SHA256 "${TEST_ROOT}/sdk/qdcxx-runtime-deps.json" receiptAfter)
    if(NOT receiptBefore STREQUAL receiptAfter)
        message(FATAL_ERROR "Readback modified source receipt")
    endif()
endif()
message(STATUS "Runtime dependency CLI tests complete; actual cases and retained artifacts: ${TEST_ROOT}")
