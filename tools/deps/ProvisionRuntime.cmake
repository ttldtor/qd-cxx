if(DEFINED LANGUAGE AND NOT LANGUAGE MATCHES "^(en|ru)$")
    message(FATAL_ERROR "QDCXX_DEPS_INPUT: LANGUAGE must be en or ru")
endif()
if(NOT DEFINED DESTINATION OR DESTINATION STREQUAL "")
    message(FATAL_ERROR "QDCXX_DEPS_INPUT: supply DESTINATION; use -DHELP=ON for help")
endif()
if(NOT DEFINED DOWNLOAD_TIMEOUT)
    set(DOWNLOAD_TIMEOUT 120)
endif()
if(NOT DOWNLOAD_TIMEOUT MATCHES "^[1-9][0-9]*$" OR DOWNLOAD_TIMEOUT GREATER 3600)
    message(FATAL_ERROR "QDCXX_DEPS_INPUT: DOWNLOAD_TIMEOUT must be in 1..3600 seconds")
endif()

# Internal path guard: caller paths and cached/extracted entries must not redirect writes or reads.
function(qdcxxDepsPath path)
    if("${path}" MATCHES "[;\r\n]" OR NOT IS_ABSOLUTE "${path}")
        message(FATAL_ERROR "QDCXX_DEPS_PATH: expected an absolute path without list/control separators: ${path}")
    endif()
    set(current "${path}")
    while(NOT current STREQUAL "")
        if(IS_SYMLINK "${current}")
            message(FATAL_ERROR "QDCXX_DEPS_PATH: symlink/junction is not allowed: ${current}")
        endif()
        if(EXISTS "${current}")
            file(REAL_PATH "${current}" resolved)
            if(WIN32)
                string(TOLOWER "${current}" expected)
                string(TOLOWER "${resolved}" resolved)
            else()
                set(expected "${current}")
            endif()
            if(NOT resolved STREQUAL expected)
                message(FATAL_ERROR "QDCXX_DEPS_PATH: redirected path is not allowed: ${current}")
            endif()
        endif()
        cmake_path(GET current PARENT_PATH parent)
        if(parent STREQUAL current)
            break()
        endif()
        set(current "${parent}")
    endwhile()
endfunction()
function(qdcxxDepsTree root)
    qdcxxDepsPath("${root}")
    file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE "${root}/*")
    foreach(entry IN LISTS entries)
        if(IS_SYMLINK "${entry}")
            message(FATAL_ERROR "QDCXX_DEPS_PATH: symlink/junction in source tree: ${entry}")
        endif()
        file(REAL_PATH "${entry}" resolved)
        if(WIN32)
            string(TOLOWER "${entry}" expected)
            string(TOLOWER "${resolved}" resolved)
        else()
            set(expected "${entry}")
        endif()
        if(NOT expected STREQUAL resolved)
            message(FATAL_ERROR "QDCXX_DEPS_PATH: redirected source entry: ${entry}")
        endif()
    endforeach()
endfunction()

# Internal publication: directory rename is atomic on supported local filesystems, including DrvFS.
# The caller holds the destination/cache helper locks; external path replacement is outside the contract.
function(qdcxxDepsPublishDirectory source destination)
    qdcxxDepsPath("${source}")
    qdcxxDepsPath("${destination}")
    if(NOT IS_DIRECTORY "${source}" OR EXISTS "${destination}" OR IS_SYMLINK "${destination}")
        message(FATAL_ERROR "QDCXX_DEPS_PUBLISH: source must be a directory and destination must remain absent: ${destination}")
    endif()
    file(RENAME "${source}" "${destination}" RESULT published)
    if(NOT published STREQUAL "0")
        message(FATAL_ERROR "QDCXX_DEPS_PUBLISH: ${published}; staging retained")
    endif()
endfunction()
cmake_path(ABSOLUTE_PATH DESTINATION NORMALIZE)
cmake_path(GET DESTINATION PARENT_PATH parent)
if(parent STREQUAL DESTINATION)
    message(FATAL_ERROR "QDCXX_DEPS_PATH: DESTINATION must not be a filesystem root")
endif()
qdcxxDepsPath("${DESTINATION}")
set(stage "${DESTINATION}.partial")
qdcxxDepsPath("${stage}")
qdcxxDepsPath("${DESTINATION}.lock")
file(MAKE_DIRECTORY "${parent}")
file(LOCK "${DESTINATION}.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
    message(FATAL_ERROR "QDCXX_DEPS_BUSY: destination is locked: ${locked}")
endif()
set(profile "${CMAKE_CURRENT_LIST_DIR}/../../cmake/runtime-profile")
include("${profile}/../VerifyRuntimeSdk.cmake")
set(asioRoot "asio-asio-1-38-2")
set(caresRoot "c-ares-1.34.9-qdcxx2")
set(receipt "{\"schemaVersion\":1,\"asioInclude\":\"${asioRoot}/include\",\"caresSource\":\"${caresRoot}\"}\n")
if(EXISTS "${stage}")
    message(FATAL_ERROR "QDCXX_DEPS_PARTIAL: stale staging directory ${stage}; inspect it and choose a fresh destination")
endif()
if(EXISTS "${DESTINATION}")
    if(NOT EXISTS "${DESTINATION}/qdcxx-runtime-deps.json")
        message(FATAL_ERROR "QDCXX_DEPS_PARTIAL: destination lacks its completed receipt; choose a fresh destination")
    endif()
    qdcxxDepsTree("${DESTINATION}")
    file(READ "${DESTINATION}/qdcxx-runtime-deps.json" actualReceipt)
    if(NOT actualReceipt STREQUAL receipt)
        message(FATAL_ERROR "QDCXX_DEPS_SOURCE_CORRUPT: destination receipt differs")
    endif()
    qdcxxVerifyRuntimeSdk("${profile}/asio-1.38.2.sources.json" "${DESTINATION}/${asioRoot}" "include")
    qdcxxVerifyRuntimeSdk("${profile}/c-ares-1.34.9-qdcxx2.sources.json" "${DESTINATION}/${caresRoot}" "")
    message(STATUS "Runtime dependency sources reverified: ${DESTINATION}")
    return()
endif()
if(NOT DEFINED ARCHIVE_CACHE)
    set(ARCHIVE_CACHE "${parent}/archives")
endif()
cmake_path(ABSOLUTE_PATH ARCHIVE_CACHE NORMALIZE)
qdcxxDepsPath("${ARCHIVE_CACHE}")
foreach(output IN ITEMS "${DESTINATION}" "${stage}")
    cmake_path(IS_PREFIX output "${ARCHIVE_CACHE}" NORMALIZE cacheInside)
    cmake_path(IS_PREFIX ARCHIVE_CACHE "${output}" NORMALIZE outputInside)
    if(cacheInside OR outputInside)
        message(FATAL_ERROR "QDCXX_DEPS_PATH: archive cache and destination/staging must not overlap")
    endif()
endforeach()
if(NOT IS_ABSOLUTE "${PATCH_EXECUTABLE}" OR NOT EXISTS "${PATCH_EXECUTABLE}" OR IS_DIRECTORY "${PATCH_EXECUTABLE}")
    message(FATAL_ERROR "QDCXX_DEPS_PATCH_TOOL: supply an explicit absolute GNU PATCH_EXECUTABLE")
endif()
file(READ "${profile}/c-ares-1.34.9-qdcxx2.sources.json" caresProfile)
string(JSON expectedPatch GET "${caresProfile}" patchSha256)
file(SHA256 "${profile}/c-ares-1.34.9-qdcxx2.patch" actualPatch)
if(NOT actualPatch STREQUAL expectedPatch)
    message(FATAL_ERROR "QDCXX_DEPS_PATCH_CORRUPT: cumulative patch hash differs")
endif()
file(MAKE_DIRECTORY "${ARCHIVE_CACHE}")
qdcxxDepsPath("${ARCHIVE_CACHE}/.qdcxx-runtime.lock")
file(LOCK "${ARCHIVE_CACHE}/.qdcxx-runtime.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
    message(FATAL_ERROR "QDCXX_DEPS_BUSY: archive cache is locked: ${locked}")
endif()

# Internal acquisition: exact official URL and reviewed hash, never caller-supplied source code.
function(qdcxxDepsArchive name url manifest rootName output)
    set(archive "${ARCHIVE_CACHE}/${name}")
    qdcxxDepsPath("${archive}")
    qdcxxDepsPath("${archive}.part")
    if(EXISTS "${archive}.part")
        message(FATAL_ERROR "QDCXX_DEPS_PARTIAL: incomplete download ${archive}.part; inspect it and choose a fresh archive cache")
    endif()
    file(READ "${manifest}" sdkProfile)
    string(JSON expected GET "${sdkProfile}" archiveSha256)
    if(NOT EXISTS "${archive}")
        if(OFFLINE)
            message(FATAL_ERROR "QDCXX_DEPS_CACHE_MISSING: offline archive is absent: ${archive}")
        endif()
        file(DOWNLOAD "${url}" "${archive}.part" TLS_VERIFY ON TIMEOUT "${DOWNLOAD_TIMEOUT}" INACTIVITY_TIMEOUT "${DOWNLOAD_TIMEOUT}" STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "QDCXX_DEPS_DOWNLOAD: ${url}: ${status}; partial download retained")
        endif()
        file(SHA256 "${archive}.part" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "QDCXX_DEPS_ARCHIVE_CORRUPT: downloaded archive hash differs; partial retained")
        endif()
        file(RENAME "${archive}.part" "${archive}" NO_REPLACE RESULT renamed)
        if(NOT renamed STREQUAL "0")
            message(FATAL_ERROR "QDCXX_DEPS_DOWNLOAD: archive publication failed: ${renamed}")
        endif()
    endif()
    file(SHA256 "${archive}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "QDCXX_DEPS_ARCHIVE_CORRUPT: cached archive hash differs; not overwritten: ${archive}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}" RESULT_VARIABLE listed OUTPUT_VARIABLE entries ERROR_VARIABLE error)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tvf "${archive}" RESULT_VARIABLE verboseListed OUTPUT_VARIABLE modes ERROR_VARIABLE verboseError)
    if(NOT listed EQUAL 0 OR NOT verboseListed EQUAL 0)
        message(FATAL_ERROR "QDCXX_DEPS_ARCHIVE_PATH: unreadable archive or non-regular entry: ${error}${verboseError}")
    endif()
    # The upstream Asio distribution has two convenience links outside the selected include/license profile.
    # They are never extracted. All other entries, and the complete c-ares archive, must be regular.
    string(REPLACE "\r" "" modes "${modes}")
    string(REPLACE "\n" ";" modes "${modes}")
    foreach(mode IN LISTS modes)
        if(mode STREQUAL "" OR mode MATCHES "^[d-]")
            continue()
        endif()
        if(rootName STREQUAL asioRoot AND (mode MATCHES "^l.* ${asioRoot}/asio/include -> \\.\\./include$"
            OR mode MATCHES "^l.* ${asioRoot}/asio/src -> \\.\\./src$"))
            continue()
        endif()
        message(FATAL_ERROR "QDCXX_DEPS_ARCHIVE_PATH: non-regular archive entry: ${mode}")
    endforeach()
    if(entries MATCHES ";")
        message(FATAL_ERROR "QDCXX_DEPS_ARCHIVE_PATH: list separator in archive entry")
    endif()
    string(REPLACE "\r" "" entries "${entries}")
    string(REPLACE "\n" ";" entries "${entries}")
    foreach(entry IN LISTS entries)
        if(entry STREQUAL "")
            continue()
        endif()
        string(FIND "${entry}" "${rootName}/" prefix)
        if(NOT prefix EQUAL 0 OR entry MATCHES "(^|/)\\.\\.(/|$)|[\\\\:\r\n]")
            message(FATAL_ERROR "QDCXX_DEPS_ARCHIVE_PATH: unsafe archive entry: ${entry}")
        endif()
    endforeach()
    set(${output} "${archive}" PARENT_SCOPE)
endfunction()
qdcxxDepsArchive("asio-1.38.2.tar.gz" "https://github.com/chriskohlhoff/asio/archive/refs/tags/asio-1-38-2.tar.gz"
    "${profile}/asio-1.38.2.sources.json" "${asioRoot}" asioArchive)
qdcxxDepsArchive("c-ares-1.34.9.tar.gz" "https://github.com/c-ares/c-ares/releases/download/v1.34.9/c-ares-1.34.9.tar.gz"
    "${profile}/c-ares-1.34.9-qdcxx2.sources.json" "c-ares-1.34.9" caresArchive)
execute_process(COMMAND "${PATCH_EXECUTABLE}" --version RESULT_VARIABLE patchStatus OUTPUT_VARIABLE patchVersion ERROR_VARIABLE patchError)
if(NOT patchStatus EQUAL 0 OR NOT patchVersion MATCHES "GNU patch")
    message(FATAL_ERROR "QDCXX_DEPS_PATCH_TOOL: GNU patch required: ${patchError}")
endif()
file(MAKE_DIRECTORY "${stage}")
file(ARCHIVE_EXTRACT INPUT "${asioArchive}" DESTINATION "${stage}" PATTERNS "${asioRoot}/include/" "${asioRoot}/include/*" "${asioRoot}/LICENSE_1_0.txt")
file(ARCHIVE_EXTRACT INPUT "${caresArchive}" DESTINATION "${stage}")
qdcxxDepsTree("${stage}")
execute_process(COMMAND "${PATCH_EXECUTABLE}" --batch --forward --fuzz=0 --binary -p1 --directory "${stage}/c-ares-1.34.9"
    --input "${profile}/c-ares-1.34.9-qdcxx2.patch" RESULT_VARIABLE patched OUTPUT_VARIABLE patchOutput ERROR_VARIABLE patchError)
message(STATUS "${patchOutput}")
if(NOT patched EQUAL 0 OR "${patchOutput}${patchError}" MATCHES "[Ff]uzz|offset")
    message(FATAL_ERROR "QDCXX_DEPS_PATCH_FAILED: exact cumulative patch failed: ${patchError}")
endif()
qdcxxDepsPublishDirectory("${stage}/c-ares-1.34.9" "${stage}/${caresRoot}")
qdcxxVerifyRuntimeSdk("${profile}/asio-1.38.2.sources.json" "${stage}/${asioRoot}" "include")
qdcxxVerifyRuntimeSdk("${profile}/c-ares-1.34.9-qdcxx2.sources.json" "${stage}/${caresRoot}" "")
file(WRITE "${stage}/qdcxx-runtime-deps.json" "${receipt}")
qdcxxDepsPublishDirectory("${stage}" "${DESTINATION}")
message(STATUS "Runtime dependency sources ready: ${DESTINATION}")
message(STATUS "ORG_TTLDTOR_QDCXX_ASIO_INCLUDE=${DESTINATION}/${asioRoot}/include")
message(STATUS "ORG_TTLDTOR_QDCXX_CARES_SOURCE=${DESTINATION}/${caresRoot}")
