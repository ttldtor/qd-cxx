cmake_minimum_required(VERSION 3.25)
if(HELP)
    if(LANGUAGE STREQUAL "ru")
        message("Зафиксировать локальный static IPF SDK после явной сборки/CTest/install. Запуск: cmake -DSDK_ROOT=/явный/sdk -P tools/deps/SealIpfTransferSdk.cmake\nHELP=ON не требует inputs, не создаёт files; LANGUAGE=en (по умолчанию)/ru. SDK_ROOT обязателен; defaults для рабочего пути нет. Проверяются pinned sources/license и build profile; compiler и сеть не запускаются. Создаются только share/qdcxx-ipf-transfer/seal.json и cooperative seal.lock; существующий seal только проверяется и никогда не перезаписывается. Exit0: успех/help; exit1: неверные inputs/source/artifact/profile. Trusted local SDK без конкурентной подмены путей; seal связывает actual archive/profile SHA256 с источниками, не заменяет тесты и не аутентифицирует недоверенную поставку. Binary hash конкретной сборки не переносим между произвольными build paths. См. IPF-TRANSFER.ru.md.")
    else()
        message("Seal a local static IPF SDK after explicit build/CTest/install. Usage: cmake -DSDK_ROOT=/explicit/sdk -P tools/deps/SealIpfTransferSdk.cmake\nHELP=ON requires no inputs and creates no files; LANGUAGE=en (default)/ru. SDK_ROOT is required with no working-path default. Verifies pinned sources/license and build profile; no compiler or network runs. Writes only share/qdcxx-ipf-transfer/seal.json and cooperative seal.lock; an existing seal is only verified, never overwritten. Exit0: success/help; exit1: invalid inputs/source/artifact/profile. Trusted local SDK without concurrent path replacement required; seal binds actual archive/profile SHA256 to sources, does not replace tests or authenticate an untrusted delivery. A per-build binary hash is not portable across arbitrary build paths. See IPF-TRANSFER.md.")
    endif()
    return()
endif()
if(NOT DEFINED SDK_ROOT OR SDK_ROOT STREQUAL "")
    message(FATAL_ERROR "QDCXX_IPF_SDK: supply SDK_ROOT; use -DHELP=ON")
endif()
cmake_path(ABSOLUTE_PATH SDK_ROOT NORMALIZE)
# Reuse only the verifier: no acquisition or build script executes.
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/VerifyIpfTransferSdk.cmake")
qdcxxIpfSdkPath("${SDK_ROOT}")
qdcxxIpfSdkPath("${SDK_ROOT}/share/qdcxx-ipf-transfer/seal.json")
qdcxxIpfSdkPath("${SDK_ROOT}/share/qdcxx-ipf-transfer/seal.lock")
if(NOT IS_DIRECTORY "${SDK_ROOT}/share/qdcxx-ipf-transfer")
    message(FATAL_ERROR "QDCXX_IPF_SDK: installed metadata directory required")
endif()
file(LOCK "${SDK_ROOT}/share/qdcxx-ipf-transfer/seal.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
    message(FATAL_ERROR "QDCXX_IPF_SDK: seal is locked: ${locked}")
endif()
set(manifest "${CMAKE_CURRENT_LIST_DIR}/../../cmake/ipf-transfer-profile/boost-1.92.0.sources.json")
file(SHA256 "${manifest}" expectedSourceHash)
set(metadata "${SDK_ROOT}/share/qdcxx-ipf-transfer")
qdcxxVerifyIpfTransferSources("${manifest}" "${SDK_ROOT}/source")
file(SHA256 "${metadata}/boost-1.92.0.sources.json" installedSourceHash)
if(NOT installedSourceHash STREQUAL expectedSourceHash)
    message(FATAL_ERROR "QDCXX_IPF_SDK: installed source manifest differs")
endif()
file(READ "${metadata}/build-profile.json" profile)
string(JSON platform GET "${profile}" platform)
string(JSON sourceBinding GET "${profile}" sourceManifestSha256)
string(JSON archive GET "${profile}" archive)
if(NOT platform MATCHES "^(windows-x64-msvc1942-release-md|linux-x64-gcc13.3-debug-asan-ubsan)$" OR
    NOT sourceBinding STREQUAL expectedSourceHash OR NOT archive MATCHES "^lib/(qdcxx_boost_url\\.lib|libqdcxx_boost_url\\.a)$")
    message(FATAL_ERROR "QDCXX_IPF_SDK: invalid source/platform/archive profile")
endif()
if(EXISTS "${metadata}/seal.json")
    qdcxxVerifyIpfTransferSdk("${SDK_ROOT}" "${expectedSourceHash}" "${platform}")
    return()
endif()
file(SHA256 "${SDK_ROOT}/${archive}" archiveHash)
file(SHA256 "${metadata}/build-profile.json" profileHash)
file(GLOB_RECURSE sdkFiles LIST_DIRECTORIES FALSE RELATIVE "${SDK_ROOT}" "${SDK_ROOT}/*")
list(REMOVE_ITEM sdkFiles "share/qdcxx-ipf-transfer/seal.json" "share/qdcxx-ipf-transfer/seal.lock")
list(SORT sdkFiles)
set(entries "")
set(separator "")
foreach(relative IN LISTS sdkFiles)
    if(relative MATCHES "[;\\\\:\"\t\r\n]")
        message(FATAL_ERROR "QDCXX_IPF_SDK: invalid package path")
    endif()
    qdcxxIpfSdkPath("${SDK_ROOT}/${relative}")
    file(SHA256 "${SDK_ROOT}/${relative}" hash)
    string(APPEND entries "${separator}{\"path\":\"${relative}\",\"sha256\":\"${hash}\"}")
    set(separator ",")
endforeach()
file(WRITE "${metadata}/seal.json" "{\"schemaVersion\":1,\"archiveSha256\":\"${archiveHash}\",\"buildProfileSha256\":\"${profileHash}\",\"files\":[${entries}]}\n")
qdcxxVerifyIpfTransferSdk("${SDK_ROOT}" "${expectedSourceHash}" "${platform}")