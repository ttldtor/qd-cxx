cmake_minimum_required(VERSION 3.25)
# Standalone caller: cmake -DTEST_ROOT=/fresh/tests [-DARCHIVE_CACHE=/verified/archive/cache] -P tools/deps/TestsIpfTransfer.cmake.
# Produces retained per-case logs. No compiler runs; optional source provisioning is offline.
if(HELP)
    if(LANGUAGE STREQUAL "ru")
        message("Проверить source provision/seal CLI IPF dependency. Запуск: cmake -DTEST_ROOT=/новый/каталог [-DARCHIVE_CACHE=/архивы] -P tools/deps/TestsIpfTransfer.cmake\nTEST_ROOT обязателен и должен отсутствовать; ARCHIVE_CACHE не задан по умолчанию. Без cache проверяются help EN/RU, OFF, ошибки inputs/cache/locks/partial/overlap без сети. С cache дополнительно выполняются offline provision/readback/source-corruption. Компилятор не запускается; тесты не удаляют данные, сохраняют логи и owned fixtures в TEST_ROOT. HELP=ON не требует inputs и не создаёт files; LANGUAGE=en (по умолчанию)/ru. Exit0: выполненные проверки успешны; exit1: invalid input/unexpected result. CMake3.25+, trusted local paths; symlink case явно NOT_CHECKED, если платформа запрещает создание ссылки.")
    else()
        message("Test IPF dependency source provision/seal CLIs. Usage: cmake -DTEST_ROOT=/fresh/tests [-DARCHIVE_CACHE=/archives] -P tools/deps/TestsIpfTransfer.cmake\nTEST_ROOT is required and must be absent; ARCHIVE_CACHE has no default. Without cache: EN/RU help, OFF and input/cache/lock/partial/overlap failures, no network. With cache: offline provision/readback/source-corruption as well. No compiler runs; tests delete nothing and retain logs/owned fixtures under TEST_ROOT. HELP=ON needs no inputs and creates no files; LANGUAGE=en (default)/ru. Exit0: executed cases passed; exit1: invalid input/unexpected result. Requires CMake3.25+ and trusted local paths; symlink case is explicitly NOT_CHECKED if the platform denies link creation.")
    endif()
    return()
endif()
if(NOT DEFINED TEST_ROOT OR TEST_ROOT STREQUAL "")
    message(FATAL_ERROR "Supply fresh TEST_ROOT; use -DHELP=ON")
endif()
cmake_path(ABSOLUTE_PATH TEST_ROOT NORMALIZE)
if(EXISTS "${TEST_ROOT}" OR IS_SYMLINK "${TEST_ROOT}")
    message(FATAL_ERROR "TEST_ROOT must be fresh")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/cwd")
set(helper "${CMAKE_CURRENT_LIST_DIR}/ProvisionIpfTransfer.cmake")
function(check name expected pattern)
    execute_process(COMMAND "${CMAKE_COMMAND}" ${ARGN} -P "${helper}" WORKING_DIRECTORY "${TEST_ROOT}/cwd"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${TEST_ROOT}/${name}.log" "COMMAND: ${CMAKE_COMMAND};${ARGN};-P;${helper}\nEXIT: ${result}\n${output}${error}")
    if(NOT result EQUAL expected OR NOT "${output}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Unexpected ${name}: exit=${result}\n${output}${error}")
    endif()
    message(STATUS "${name}: expected exit ${result}")
endfunction()
check(help-no-input 0 DESTINATION -DHELP=ON)
check(off-no-input 0 disabled -DENABLED=OFF)
foreach(language IN ITEMS en ru)
    check("help-${language}" 0 DESTINATION -DHELP=ON "-DLANGUAGE=${language}" "-DDESTINATION=${TEST_ROOT}/help-victim" "-DARCHIVE_CACHE=${TEST_ROOT}/help-cache")
    execute_process(COMMAND "${CMAKE_COMMAND}" -DHELP=ON "-DLANGUAGE=${language}" "-DSDK_ROOT=${TEST_ROOT}/seal-victim" -P "${CMAKE_CURRENT_LIST_DIR}/SealIpfTransferSdk.cmake"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error WORKING_DIRECTORY "${TEST_ROOT}/cwd")
    file(WRITE "${TEST_ROOT}/seal-help-${language}.log" "EXIT: ${status}\n${output}${error}")
    if(NOT status EQUAL 0 OR NOT "${output}${error}" MATCHES "SDK_ROOT" OR EXISTS "${TEST_ROOT}/seal-victim")
        message(FATAL_ERROR "Seal help failed or wrote files")
    endif()
endforeach()
check(off-inputs 0 disabled -DENABLED=OFF "-DDESTINATION=${TEST_ROOT}/off-victim" "-DARCHIVE_CACHE=${TEST_ROOT}/off-cache")
foreach(victim IN ITEMS help-victim help-victim.lock help-victim.partial help-cache off-victim off-victim.lock off-victim.partial off-cache seal-victim)
    if(EXISTS "${TEST_ROOT}/${victim}")
        message(FATAL_ERROR "Help/OFF touched ${victim}")
    endif()
endforeach()
file(GLOB helpArtifacts "${TEST_ROOT}/cwd/*")
if(helpArtifacts)
    message(FATAL_ERROR "Help/OFF wrote invocation files")
endif()
check(no-input 1 QDCXX_IPF_DEPS_INPUT)
check(language 1 QDCXX_IPF_DEPS_INPUT -DLANGUAGE=unknown)
check(timeout 1 QDCXX_IPF_DEPS_INPUT "-DDESTINATION=${TEST_ROOT}/timeout" -DDOWNLOAD_TIMEOUT=0)
check(offline-missing 1 QDCXX_IPF_DEPS_CACHE_MISSING "-DDESTINATION=${TEST_ROOT}/missing" "-DARCHIVE_CACHE=${TEST_ROOT}/missing-cache" -DOFFLINE=ON)
file(MAKE_DIRECTORY "${TEST_ROOT}/bad-cache")
file(WRITE "${TEST_ROOT}/bad-cache/boost_1_92_0.tar.gz" "retain-corrupt-archive")
check(corrupt-archive 1 QDCXX_IPF_DEPS_ARCHIVE_CORRUPT "-DDESTINATION=${TEST_ROOT}/corrupt" "-DARCHIVE_CACHE=${TEST_ROOT}/bad-cache" -DOFFLINE=ON)
file(READ "${TEST_ROOT}/bad-cache/boost_1_92_0.tar.gz" retained)
if(NOT retained STREQUAL "retain-corrupt-archive")
    message(FATAL_ERROR "Corrupt archive was overwritten")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/stale.partial")
file(WRITE "${TEST_ROOT}/stale.partial/sentinel" "retain")
check(stale 1 QDCXX_IPF_DEPS_PARTIAL "-DDESTINATION=${TEST_ROOT}/stale")
file(MAKE_DIRECTORY "${TEST_ROOT}/incomplete")
check(incomplete 1 QDCXX_IPF_DEPS_PARTIAL "-DDESTINATION=${TEST_ROOT}/incomplete")
check(overlap 1 QDCXX_IPF_DEPS_PATH "-DDESTINATION=${TEST_ROOT}/overlap" "-DARCHIVE_CACHE=${TEST_ROOT}/overlap/cache")
file(LOCK "${TEST_ROOT}/busy.lock" GUARD PROCESS TIMEOUT 0)
check(destination-lock 1 QDCXX_IPF_DEPS_BUSY "-DDESTINATION=${TEST_ROOT}/busy")
file(LOCK "${TEST_ROOT}/busy.lock" RELEASE)
file(MAKE_DIRECTORY "${TEST_ROOT}/busy-cache")
file(LOCK "${TEST_ROOT}/busy-cache/.qdcxx-ipf-transfer.lock" GUARD PROCESS TIMEOUT 0)
check(cache-lock 1 QDCXX_IPF_DEPS_BUSY "-DDESTINATION=${TEST_ROOT}/cache-busy" "-DARCHIVE_CACHE=${TEST_ROOT}/busy-cache")
file(LOCK "${TEST_ROOT}/busy-cache/.qdcxx-ipf-transfer.lock" RELEASE)
file(MAKE_DIRECTORY "${TEST_ROOT}/link-target")
file(CREATE_LINK "${TEST_ROOT}/link-target" "${TEST_ROOT}/link" SYMBOLIC RESULT linkResult)
if(linkResult STREQUAL "0")
    check(symlink 1 QDCXX_IPF_DEPS_PATH "-DDESTINATION=${TEST_ROOT}/link/sdk")
else()
    message(STATUS "NOT_CHECKED: symlink creation unavailable: ${linkResult}")
endif()
if(DEFINED ARCHIVE_CACHE)
    check(provision 0 "sources ready" "-DDESTINATION=${TEST_ROOT}/sources" "-DARCHIVE_CACHE=${ARCHIVE_CACHE}" -DOFFLINE=ON)
    file(SHA256 "${TEST_ROOT}/sources.receipt.json" receiptBefore)
    check(readback 0 "sources reverified" "-DDESTINATION=${TEST_ROOT}/sources" -DOFFLINE=ON -DARCHIVE_CACHE=/missing)
    file(SHA256 "${TEST_ROOT}/sources.receipt.json" receiptAfter)
    if(NOT receiptBefore STREQUAL receiptAfter)
        message(FATAL_ERROR "Readback modified receipt")
    endif()
    file(WRITE "${TEST_ROOT}/sources/LICENSE_1_0.txt" "retain-corrupt-source")
    check(source-corrupt 1 "source hash mismatch" "-DDESTINATION=${TEST_ROOT}/sources" -DOFFLINE=ON)
    file(READ "${TEST_ROOT}/sources/LICENSE_1_0.txt" corruptRetained)
    if(NOT corruptRetained STREQUAL "retain-corrupt-source")
        message(FATAL_ERROR "Corrupt source was repaired")
    endif()
endif()
message(STATUS "IPF dependency CLI checks complete; logs retained: ${TEST_ROOT}")
