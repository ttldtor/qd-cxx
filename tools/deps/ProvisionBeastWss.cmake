cmake_minimum_required(VERSION 3.25)

if(DEFINED LANGUAGE AND NOT LANGUAGE MATCHES "^(en|ru)$")
    message(FATAL_ERROR "LANGUAGE must be en or ru")
endif()
if(HELP)
    if(LANGUAGE STREQUAL "ru")
        message("Подготовить заголовки Boost для внутреннего профиля Beast WSS из проверенного локального архива.\nЗапуск: cmake -DDESTINATION=/новый/каталог -DARCHIVE=/кэш/boost_1_92_0.tar.gz -P tools/deps/ProvisionBeastWss.cmake\nHELP=ON выводит справку без рабочих параметров и изменений файлов; LANGUAGE=en (по умолчанию) или ru. ENABLED=OFF пропускает подготовку. ARCHIVE нужен для нового DESTINATION. Существующий каталог проверяется заново без архива.\nПроверяются SHA-256 архива и все извлекаемые файлы. Сеть, компилятор и глобальные настройки не используются. Создаются блокировка и временный каталог рядом с DESTINATION. Повреждённые входы и незавершённые каталоги сохраняются.\nКод 0: успех, справка или OFF. Код 1: ошибка параметров, файлов или проверки. Подробнее в BEAST-WSS.ru.md.")
    else()
        message("Prepare the private Beast WSS Boost headers from a verified local archive.\nUsage: cmake -DDESTINATION=/new/directory -DARCHIVE=/cache/boost_1_92_0.tar.gz -P tools/deps/ProvisionBeastWss.cmake\nHELP=ON prints help without provision inputs or file writes; LANGUAGE=en (default) or ru. ENABLED=OFF skips provisioning. ARCHIVE is required for a new DESTINATION. An existing destination is reverified without the archive.\nChecks the archive SHA-256 and each extracted file. No network, compiler or global settings are used. Creates a lock and a staging directory beside DESTINATION. Corrupt inputs and incomplete staging are retained.\nExit 0: success, help or OFF. Exit 1: invalid input, file or verification failure. See BEAST-WSS.md.")
    endif()
    return()
endif()
if(DEFINED ENABLED AND NOT ENABLED)
    return()
endif()
if(NOT DEFINED DESTINATION OR DESTINATION STREQUAL "")
    message(FATAL_ERROR "Supply DESTINATION; use -DHELP=ON")
endif()

# Reject aliases for mutable paths and the exact cached input. Callers keep the directories trusted.
function(requireDirectPath path)
    if(path MATCHES "[;\r\n]")
        message(FATAL_ERROR "Unsupported path: ${path}")
    endif()
    set(current "${path}")
    while(NOT current STREQUAL "")
        if(IS_SYMLINK "${current}")
            message(FATAL_ERROR "Redirected path: ${current}")
        endif()
        if(EXISTS "${current}")
            file(REAL_PATH "${current}" real)
            if(WIN32)
                string(TOLOWER "${real}" real)
                string(TOLOWER "${current}" spelling)
            else()
                set(spelling "${current}")
            endif()
            if(NOT real STREQUAL spelling)
                message(FATAL_ERROR "Redirected path: ${current}")
            endif()
        endif()
        cmake_path(GET current PARENT_PATH parent)
        if(parent STREQUAL current)
            break()
        endif()
        set(current "${parent}")
    endwhile()
endfunction()

cmake_path(ABSOLUTE_PATH DESTINATION NORMALIZE)
cmake_path(GET DESTINATION PARENT_PATH parent)
if(parent STREQUAL DESTINATION)
    message(FATAL_ERROR "DESTINATION cannot be a filesystem root")
endif()
set(stage "${DESTINATION}.partial")
set(lock "${DESTINATION}.lock")
foreach(path IN ITEMS "${DESTINATION}" "${stage}" "${lock}")
    requireDirectPath("${path}")
endforeach()
file(MAKE_DIRECTORY "${parent}")
file(LOCK "${lock}" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
    message(FATAL_ERROR "Beast WSS destination is busy: ${locked}")
endif()
if(EXISTS "${stage}")
    message(FATAL_ERROR "Incomplete staging retained: ${stage}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/VerifyTlsSdk.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/beast-wss-profile/Profile.cmake")
if(EXISTS "${DESTINATION}")
    qdcxxVerifyBeastWssSources("${DESTINATION}")
    return()
endif()
if(NOT DEFINED ARCHIVE OR ARCHIVE STREQUAL "")
    message(FATAL_ERROR "Supply the cached Boost ARCHIVE for a new DESTINATION")
endif()
cmake_path(ABSOLUTE_PATH ARCHIVE NORMALIZE)
requireDirectPath("${ARCHIVE}")
if(NOT EXISTS "${ARCHIVE}" OR IS_DIRECTORY "${ARCHIVE}")
    message(FATAL_ERROR "Cached Boost archive is missing: ${ARCHIVE}")
endif()
qdcxxReadBeastWssProfile(profile manifest)
string(JSON archiveHash GET "${profile}" archiveSha256)
file(SHA256 "${ARCHIVE}" hash)
if(NOT hash STREQUAL archiveHash)
    message(FATAL_ERROR "Cached Boost archive SHA-256 mismatch: ${ARCHIVE}")
endif()

string(JSON manifestHash GET "${profile}" sourceManifest sha256)
file(SHA256 "${manifest}" hash)
if(NOT hash STREQUAL manifestHash)
    message(FATAL_ERROR "Beast WSS source manifest SHA-256 mismatch")
endif()
file(STRINGS "${manifest}" rows ENCODING UTF-8)
set(patterns)
foreach(row IN LISTS rows)
    if(NOT row MATCHES "^[0-9a-f]+\t(boost/[A-Za-z0-9_./-]+|LICENSE_1_0\\.txt)$")
        message(FATAL_ERROR "Invalid Beast WSS manifest entry")
    endif()
    set(relative "${CMAKE_MATCH_1}")
    if(relative MATCHES "(^|/)\\.\\.?(/|$)|//|/$")
        message(FATAL_ERROR "Invalid Beast WSS manifest path")
    endif()
    list(APPEND patterns "boost_1_92_0/${relative}")
endforeach()
if(NOT patterns)
    message(FATAL_ERROR "Empty Beast WSS source manifest")
endif()

file(MAKE_DIRECTORY "${stage}")
file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${stage}" PATTERNS ${patterns})
set(extracted "${stage}/boost_1_92_0")
requireDirectPath("${extracted}")
qdcxxVerifyBeastWssSources("${extracted}")
file(RENAME "${extracted}" "${DESTINATION}" NO_REPLACE RESULT renamed)
if(NOT renamed STREQUAL "0")
    message(FATAL_ERROR "Could not publish Beast WSS sources: ${renamed}; staging retained")
endif()
file(GLOB remaining "${stage}/*")
cmake_path(IS_PREFIX parent "${stage}" NORMALIZE contained)
requireDirectPath("${stage}")
if(remaining OR NOT contained OR stage STREQUAL parent)
    message(FATAL_ERROR "Owned staging is not empty or within its parent: ${stage}")
endif()
file(REMOVE_RECURSE "${stage}")
message(STATUS "Beast WSS Boost sources ready: ${DESTINATION}")
