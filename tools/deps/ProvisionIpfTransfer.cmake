if(DEFINED LANGUAGE AND NOT LANGUAGE MATCHES "^(en|ru)$")
    message(FATAL_ERROR "QDCXX_IPF_DEPS_INPUT: LANGUAGE must be en or ru")
endif()
if(NOT DEFINED DESTINATION OR DESTINATION STREQUAL "")
    message(FATAL_ERROR "QDCXX_IPF_DEPS_INPUT: supply DESTINATION; use -DHELP=ON")
endif()
if(NOT DEFINED DOWNLOAD_TIMEOUT)
    set(DOWNLOAD_TIMEOUT 120)
endif()
if(NOT DOWNLOAD_TIMEOUT MATCHES "^[1-9][0-9]*$" OR DOWNLOAD_TIMEOUT GREATER 3600)
    message(FATAL_ERROR "QDCXX_IPF_DEPS_INPUT: DOWNLOAD_TIMEOUT must be 1..3600 seconds")
endif()

# Internal path guard: caller paths and cached/extracted entries must not redirect writes or reads.
function(qdcxxIpfDepsPath path)
    if("${path}" MATCHES "[;\r\n]" OR NOT IS_ABSOLUTE "${path}")
        message(FATAL_ERROR "QDCXX_IPF_DEPS_PATH: expected an absolute path without list/control separators: ${path}")
    endif()
    set(current "${path}")
    while(NOT current STREQUAL "")
        if(IS_SYMLINK "${current}")
            message(FATAL_ERROR "QDCXX_IPF_DEPS_PATH: symlink/junction is not allowed: ${current}")
        endif()
        if(EXISTS "${current}")
            file(REAL_PATH "${current}" resolved)
            if(WIN32)
                string(TOLOWER "${current}" expected)
                string(TOLOWER "${resolved}" resolved)
            else()
                set(expected "${current}")
            endif()
            if(NOT resolved STREQUAL expected)
                message(FATAL_ERROR "QDCXX_IPF_DEPS_PATH: redirected path is not allowed: ${current}")
            endif()
        endif()
        cmake_path(GET current PARENT_PATH parent)
        if(parent STREQUAL current)
            break()
        endif()
        set(current "${parent}")
    endwhile()
endfunction()
function(qdcxxIpfDepsTree root)
    qdcxxIpfDepsPath("${root}")
    file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE "${root}/*")
    foreach(entry IN LISTS entries)
        if(IS_SYMLINK "${entry}")
            message(FATAL_ERROR "QDCXX_IPF_DEPS_PATH: symlink/junction in source tree: ${entry}")
        endif()
        file(REAL_PATH "${entry}" resolved)
        if(WIN32)
            string(TOLOWER "${entry}" expected)
            string(TOLOWER "${resolved}" resolved)
        else()
            set(expected "${entry}")
        endif()
        if(NOT expected STREQUAL resolved)
            message(FATAL_ERROR "QDCXX_IPF_DEPS_PATH: redirected source entry: ${entry}")
        endif()
    endforeach()
endfunction()

# Internal publication: directory rename is atomic on supported local filesystems, including DrvFS.
# The caller holds the destination/cache helper locks; external path replacement is outside the contract.
function(qdcxxIpfDepsPublishDirectory source destination)
    qdcxxIpfDepsPath("${source}")
    qdcxxIpfDepsPath("${destination}")
    if(NOT IS_DIRECTORY "${source}" OR EXISTS "${destination}" OR IS_SYMLINK "${destination}")
        message(FATAL_ERROR "QDCXX_IPF_DEPS_PUBLISH: source must be a directory and destination must remain absent: ${destination}")
    endif()
    file(RENAME "${source}" "${destination}" RESULT published)
    if(NOT published STREQUAL "0")
        message(FATAL_ERROR "QDCXX_IPF_DEPS_PUBLISH: ${published}; staging retained")
    endif()
endfunction()
cmake_path(ABSOLUTE_PATH DESTINATION NORMALIZE)
cmake_path(GET DESTINATION PARENT_PATH parent)
if(parent STREQUAL DESTINATION)
    message(FATAL_ERROR "QDCXX_IPF_DEPS_PATH: destination must not be a filesystem root")
endif()
set(stage "${DESTINATION}.partial")
foreach(path IN ITEMS "${DESTINATION}" "${stage}" "${DESTINATION}.lock" "${DESTINATION}.receipt.json")
    qdcxxIpfDepsPath("${path}")
endforeach()
file(MAKE_DIRECTORY "${parent}")
file(LOCK "${DESTINATION}.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
    message(FATAL_ERROR "QDCXX_IPF_DEPS_BUSY: destination is locked: ${locked}")
endif()
set(profile "${CMAKE_CURRENT_LIST_DIR}/../../cmake/ipf-transfer-profile/boost-1.92.0.sources.json")
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/VerifyIpfTransferSdk.cmake")
file(SHA256 "${profile}" manifestHash)
set(receipt "{\"schemaVersion\":1,\"version\":\"1.92.0\",\"sourceManifestSha256\":\"${manifestHash}\"}\n")
if(EXISTS "${stage}")
    message(FATAL_ERROR "QDCXX_IPF_DEPS_PARTIAL: stale staging retained; choose a fresh destination")
endif()
if(EXISTS "${DESTINATION}")
    if(NOT EXISTS "${DESTINATION}.receipt.json")
        message(FATAL_ERROR "QDCXX_IPF_DEPS_PARTIAL: destination lacks completion receipt")
    endif()
    file(READ "${DESTINATION}.receipt.json" actualReceipt)
    if(NOT actualReceipt STREQUAL receipt)
        message(FATAL_ERROR "QDCXX_IPF_DEPS_SOURCE_CORRUPT: completion receipt differs")
    endif()
    qdcxxIpfDepsTree("${DESTINATION}")
    qdcxxVerifyIpfTransferSources("${profile}" "${DESTINATION}")
    message(STATUS "IPF transfer sources reverified")
    return()
endif()
if(EXISTS "${DESTINATION}.receipt.json")
    message(FATAL_ERROR "QDCXX_IPF_DEPS_PARTIAL: orphan completion receipt retained")
endif()
if(NOT DEFINED ARCHIVE_CACHE)
    set(ARCHIVE_CACHE "${parent}/archives")
endif()
cmake_path(ABSOLUTE_PATH ARCHIVE_CACHE NORMALIZE)
qdcxxIpfDepsPath("${ARCHIVE_CACHE}")
foreach(output IN ITEMS "${DESTINATION}" "${stage}")
    cmake_path(IS_PREFIX output "${ARCHIVE_CACHE}" NORMALIZE cacheInside)
    cmake_path(IS_PREFIX ARCHIVE_CACHE "${output}" NORMALIZE outputInside)
    if(cacheInside OR outputInside)
        message(FATAL_ERROR "QDCXX_IPF_DEPS_PATH: cache and destination/staging must not overlap")
    endif()
endforeach()
file(MAKE_DIRECTORY "${ARCHIVE_CACHE}")
qdcxxIpfDepsPath("${ARCHIVE_CACHE}/.qdcxx-ipf-transfer.lock")
file(LOCK "${ARCHIVE_CACHE}/.qdcxx-ipf-transfer.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
    message(FATAL_ERROR "QDCXX_IPF_DEPS_BUSY: cache is locked: ${locked}")
endif()
set(archive "${ARCHIVE_CACHE}/boost_1_92_0.tar.gz")
qdcxxIpfDepsPath("${archive}")
qdcxxIpfDepsPath("${archive}.part")
if(EXISTS "${archive}.part")
    message(FATAL_ERROR "QDCXX_IPF_DEPS_PARTIAL: incomplete download retained")
endif()
file(READ "${profile}" metadata)
string(JSON expected GET "${metadata}" archiveSha256)
if(NOT EXISTS "${archive}")
    if(OFFLINE)
        message(FATAL_ERROR "QDCXX_IPF_DEPS_CACHE_MISSING: offline archive is absent")
    endif()
    file(DOWNLOAD "https://archives.boost.io/release/1.92.0/source/boost_1_92_0.tar.gz" "${archive}.part"
        TLS_VERIFY ON TIMEOUT "${DOWNLOAD_TIMEOUT}" INACTIVITY_TIMEOUT "${DOWNLOAD_TIMEOUT}" STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "QDCXX_IPF_DEPS_DOWNLOAD: ${status}; partial retained")
    endif()
    file(SHA256 "${archive}.part" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "QDCXX_IPF_DEPS_ARCHIVE_CORRUPT: download hash differs; partial retained")
    endif()
    file(RENAME "${archive}.part" "${archive}" NO_REPLACE RESULT renamed)
    if(NOT renamed STREQUAL "0")
        message(FATAL_ERROR "QDCXX_IPF_DEPS_DOWNLOAD: archive publication failed: ${renamed}")
    endif()
endif()
file(SHA256 "${archive}" actual)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "QDCXX_IPF_DEPS_ARCHIVE_CORRUPT: cached archive hash differs; not overwritten")
endif()
# The accepted exact archive is trusted; extract only reviewed regular paths from its finite manifest.
string(JSON count LENGTH "${metadata}" files)
math(EXPR last "${count}-1")
set(patterns)
foreach(index RANGE 0 ${last})
    string(JSON relative GET "${metadata}" files ${index} path)
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.?(/|$)|[;\\\\:\t\r\n*?\[\]]" OR relative STREQUAL "")
        message(FATAL_ERROR "QDCXX_IPF_DEPS_PATH: unsafe manifest extraction path")
    endif()
    list(APPEND patterns "boost_1_92_0/${relative}")
endforeach()
file(MAKE_DIRECTORY "${stage}")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${stage}" PATTERNS ${patterns})
qdcxxIpfDepsTree("${stage}")
qdcxxVerifyIpfTransferSources("${profile}" "${stage}/boost_1_92_0")
qdcxxIpfDepsPublishDirectory("${stage}/boost_1_92_0" "${DESTINATION}")
# Remove only the verified empty staging path created by this invocation, under the destination parent.
cmake_path(IS_PREFIX parent "${stage}" NORMALIZE stageContained)
file(GLOB remainingStageEntries LIST_DIRECTORIES TRUE "${stage}/*")
if(NOT stageContained OR remainingStageEntries OR IS_SYMLINK "${stage}")
    message(FATAL_ERROR "QDCXX_IPF_DEPS_PATH: staging cleanup containment/emptiness check failed")
endif()
qdcxxIpfDepsPath("${stage}")
file(REMOVE_RECURSE "${stage}")
file(WRITE "${DESTINATION}.receipt.json" "${receipt}")
message(STATUS "IPF transfer sources ready: ${DESTINATION}; explicit static build/seal remains separate")