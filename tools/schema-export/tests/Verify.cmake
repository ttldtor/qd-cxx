cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED ACTUAL OR NOT DEFINED EXPECTED)
    message(FATAL_ERROR "Supply ACTUAL and EXPECTED capture directories")
endif()
cmake_path(ABSOLUTE_PATH ACTUAL NORMALIZE)
cmake_path(ABSOLUTE_PATH EXPECTED NORMALIZE)
file(GLOB_RECURSE actual_files RELATIVE "${ACTUAL}" "${ACTUAL}/*")
file(GLOB_RECURSE expected_files RELATIVE "${EXPECTED}" "${EXPECTED}/*")
list(SORT actual_files)
list(SORT expected_files)
if(NOT actual_files STREQUAL expected_files OR NOT actual_files)
    message(FATAL_ERROR "Capture inventory mismatch")
endif()
foreach(path IN LISTS expected_files)
    file(SHA256 "${ACTUAL}/${path}" actual_hash)
    file(SHA256 "${EXPECTED}/${path}" expected_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Capture mismatch: ${path}")
    endif()
endforeach()
message(STATUS "Capture inventory and bytes verified")
