cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../Environment.cmake")
schema_export_require(JAVA_HOME UPSTREAM CLASSPATH_RECEIPT RUN)
schema_export_environment()
schema_export_classpath(receipt classpath)
file(READ "${CLASSPATH_RECEIPT}" expected_receipt)
if(NOT receipt STREQUAL expected_receipt)
    message(FATAL_ERROR "Classpath receipt mismatch")
endif()
schema_export_fresh_run()
file(WRITE "${RUN}/help.json" "[]\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DJAVA_HOME=${JAVA_HOME}" "-DUPSTREAM=${UPSTREAM}"
    "-DCLASSPATH_RECEIPT=${CLASSPATH_RECEIPT}" "-DARGS=${RUN}/help.json" "-DRUN=${RUN}/compiled"
    -P "${CMAKE_CURRENT_LIST_DIR}/../Export.cmake" RESULT_VARIABLE result
    OUTPUT_FILE "${RUN}/compile.stdout" ERROR_FILE "${RUN}/compile.stderr")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Compile failed; see ${RUN}/compile.stderr")
endif()
set(cp "${RUN}/compiled/classes${schema_export_separator}${classpath}")
function(java_test name main)
    execute_process(COMMAND "${schema_export_java}" -Xmx256m -Dfile.encoding=UTF-8
        "-Duser.home=${RUN}/compiled/home" "-Djava.io.tmpdir=${RUN}/compiled/tmp"
        -cp "${cp}" "${main}" ${ARGN} TIMEOUT 30 RESULT_VARIABLE result
        OUTPUT_FILE "${RUN}/${name}.stdout" ERROR_FILE "${RUN}/${name}.stderr")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Java test ${name} failed (${result}); see RUN streams")
    endif()
endfunction()
java_test(projection qdcxx.schemaexport.tests.ProjectionCharacterization)
java_test(exporter qdcxx.schemaexport.ExporterTests "${RUN}/exporter")
foreach(scenario boundary default endpoint endpoint-api xml dxlink xml-properties limits)
    java_test("source-${scenario}" qdcxx.schemaexport.tests.SourceTests "${RUN}/source-${scenario}" "${scenario}")
endforeach()
if(UNIX)
    java_test(source-symlinks qdcxx.schemaexport.tests.SourceTests "${RUN}/source-symlinks" symlinks)
endif()
function(command name expected)
    set(destination "${RUN}/${name}")
    execute_process(COMMAND "${schema_export_java}" -Xmx256m -Dfile.encoding=UTF-8
        "-Duser.home=${RUN}/compiled/home" "-Djava.io.tmpdir=${RUN}/compiled/tmp"
        -cp "${cp}" qdcxx.schemaexport.SchemaExport --provenance "${RUN}/compiled/provenance.json"
        --output "${destination}" ${ARGN} TIMEOUT 30 RESULT_VARIABLE result
        OUTPUT_FILE "${RUN}/${name}.stdout" ERROR_FILE "${RUN}/${name}.stderr")
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: expected ${expected}, got ${result}")
    endif()
    if(NOT expected EQUAL 0 AND EXISTS "${destination}")
        message(FATAL_ERROR "${name}: rejected command published a destination")
    endif()
endfunction()
command(default-a 0 --source default --record Quote --record Profile)
command(default-b 0 --source default --record Quote --record Profile)
foreach(file schema.json provenance.json)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${RUN}/default-a/${file}" "${RUN}/default-b/${file}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Fresh-JVM deterministic ${file} comparison failed")
    endif()
endforeach()
command(all-unsupported 4 --source default)
command(missing-record 5 --source default --record Missing)
command(duplicate-record 2 --source default --record Quote --record Quote)
command(duplicate-source 2 --source default --source default)
command(unknown-key 5 --source default --startup dxfeed.address=invalid)
command(duplicate-setting 2 --source default --startup dxscheme.nanoTime=true --startup dxscheme.nanoTime=false)
command(ineffective 5 --source default --set dxscheme.nanoTime=true)
command(tiny 4 --source default --record Quote --startup dxscheme.wide=false)
command(sequence 0 --source default --record Quote --startup dxscheme.enabled.Sequence=Quote)
command(nano 0 --source default --record Quote --startup dxscheme.nanoTime=true)
command(explicit 0 --source default --record Quote --startup dxscheme.nanoTime=true --startup dxscheme.enabled.Sequence=Profile)
command(integer 0 --source default --record Quote --record Profile --startup dxscheme.price=int --startup dxscheme.size=int --startup dxscheme.shares=int)
file(READ "${RUN}/sequence/schema.json" sequence)
file(READ "${RUN}/nano/schema.json" nano)
file(READ "${RUN}/explicit/schema.json" explicit)
if(NOT sequence MATCHES "Sequence" OR sequence MATCHES "TimeNanoPart" OR NOT nano MATCHES "Sequence"
    OR NOT nano MATCHES "TimeNanoPart" OR explicit MATCHES "Sequence" OR NOT explicit MATCHES "TimeNanoPart")
    message(FATAL_ERROR "Configured field selection mismatch")
endif()
file(WRITE "${RUN}/settings.properties" "dxscheme.nanoTime=false\ndxscheme.enabled.Sequence=Quote\n")
command(endpoint-file 0 --source endpoint --record Quote --startup dxscheme.nanoTime=true --properties "${RUN}/settings.properties")
command(endpoint-api 0 --source endpoint --record Quote --properties "${RUN}/settings.properties" --set dxscheme.nanoTime=true --set dxscheme.enabled.Sequence=Profile)
file(READ "${RUN}/endpoint-file/schema.json" from_file)
file(READ "${RUN}/endpoint-api/schema.json" from_api)
if(NOT from_file STREQUAL sequence OR NOT from_api STREQUAL explicit)
    message(FATAL_ERROR "Endpoint source precedence mismatch")
endif()
file(SIZE "${RUN}/default-a/schema.json" bytes)
command(bytes-exact 0 --source default --record Quote --record Profile --max-schema-bytes "${bytes}")
math(EXPR over "${bytes} - 1")
command(bytes-over 6 --source default --record Quote --record Profile --max-schema-bytes "${over}")
command(sidecar-over 6 --source default --record Quote --max-sidecar-bytes 1)
message(STATUS "Projection, exporter, eight source scenarios and command checks passed")
