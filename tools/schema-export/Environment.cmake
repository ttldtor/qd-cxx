cmake_minimum_required(VERSION 3.25)

set(schema_export_modules dxlib mars dxfeed-promise dxfeed-api dxlib-qd-sandbox auth proto
    qd-core proto-ssl qd-rmi dxfeed-impl dxfeed-scheme dxfeed-ipf-filter qds-file)
cmake_path(GET CMAKE_CURRENT_LIST_DIR PARENT_PATH schema_export_tools)
cmake_path(GET schema_export_tools PARENT_PATH schema_export_repo)
set(schema_export_directory "${CMAKE_CURRENT_LIST_DIR}")

function(schema_export_arguments)
    foreach(index RANGE 1 ${CMAKE_ARGC})
        if("${CMAKE_ARGV${index}}" MATCHES "^-D([^:=]+)(:[^=]+)?=")
            if(NOT CMAKE_MATCH_1 IN_LIST ARGN)
                message(FATAL_ERROR "Unknown launcher setting: ${CMAKE_MATCH_1}")
            endif()
        endif()
    endforeach()
endfunction()

function(schema_export_require)
    foreach(key IN LISTS ARGN)
        if(NOT DEFINED ${key} OR "${${key}}" STREQUAL "")
            message(FATAL_ERROR "Required launcher setting: -D${key}=<path>")
        endif()
        if("${${key}}" MATCHES "[;\r\n]")
            message(FATAL_ERROR "Launcher paths must not contain semicolons or line breaks")
        endif()
        cmake_path(ABSOLUTE_PATH ${key} NORMALIZE OUTPUT_VARIABLE absolute)
        set(${key} "${absolute}" PARENT_SCOPE)
    endforeach()
endfunction()

function(schema_export_git output)
    execute_process(COMMAND "${schema_export_git_executable}" -C "${UPSTREAM}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE value ERROR_VARIABLE error TIMEOUT 180
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Cannot verify locked upstream checkout")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

macro(schema_export_environment)
    foreach(key JAVA_TOOL_OPTIONS _JAVA_OPTIONS JDK_JAVA_OPTIONS)
        if(DEFINED ENV{${key}} AND NOT "$ENV{${key}}" STREQUAL "")
            message(FATAL_ERROR "Unset ${key} for an isolated schema export")
        endif()
    endforeach()
    find_program(schema_export_git_executable git REQUIRED)
    file(READ "${schema_export_repo}/upstream.lock" lock)
    foreach(key repository version commit)
        string(REGEX MATCH "${key} = \"([^\"]+)\"" match "${lock}")
        if(NOT match)
            message(FATAL_ERROR "Malformed upstream.lock")
        endif()
        set(schema_export_${key} "${CMAKE_MATCH_1}")
    endforeach()
    schema_export_git(actual remote get-url origin)
    if(NOT actual STREQUAL schema_export_repository)
        message(FATAL_ERROR "Upstream origin mismatch")
    endif()
    schema_export_git(actual rev-parse HEAD)
    if(NOT actual STREQUAL schema_export_commit)
        message(FATAL_ERROR "Upstream revision mismatch")
    endif()
    schema_export_git(actual rev-parse "refs/tags/qd-qds-${schema_export_version}^{commit}")
    if(NOT actual STREQUAL schema_export_commit)
        message(FATAL_ERROR "Upstream tag mismatch")
    endif()
    schema_export_git(actual status --porcelain --untracked-files=all)
    if(NOT actual STREQUAL "")
        message(FATAL_ERROR "Upstream source must be clean")
    endif()
    if(WIN32)
        set(schema_export_suffix ".exe")
        set(schema_export_separator ";")
    else()
        set(schema_export_suffix "")
        set(schema_export_separator ":")
    endif()
    set(schema_export_java "${JAVA_HOME}/bin/java${schema_export_suffix}")
    set(schema_export_javac "${JAVA_HOME}/bin/javac${schema_export_suffix}")
    execute_process(COMMAND "${schema_export_java}" -version RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT "${result}" STREQUAL "0" OR NOT error MATCHES "version \"1\\.8\\.")
        message(FATAL_ERROR "Explicit JAVA_HOME must provide JDK 8")
    endif()
    execute_process(COMMAND "${schema_export_javac}" -version RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT "${result}" STREQUAL "0" OR NOT "${output}${error}" MATCHES "javac 1\\.8\\.")
        message(FATAL_ERROR "Explicit JAVA_HOME must provide javac 8")
    endif()
endmacro()

function(schema_export_fresh_run)
    if(EXISTS "${RUN}" OR IS_SYMLINK "${RUN}")
        message(FATAL_ERROR "RUN must be a new scratch directory")
    endif()
    file(MAKE_DIRECTORY "${RUN}")
endfunction()

# Ordinal relative-path order and LF delimiters make the receipt independent of host paths.
function(schema_export_hash_tree root digest count)
    if(NOT IS_DIRECTORY "${root}" OR IS_SYMLINK "${root}")
        message(FATAL_ERROR "Missing or symbolic classpath directory")
    endif()
    file(GLOB_RECURSE entries LIST_DIRECTORIES true RELATIVE "${root}" "${root}/*")
    list(SORT entries COMPARE STRING CASE SENSITIVE ORDER ASCENDING)
    set(chain "")
    set(file_count 0)
    set(byte_count 0)
    foreach(entry IN LISTS entries)
        if(IS_SYMLINK "${root}/${entry}" OR entry MATCHES "[;\t\r\n]")
            message(FATAL_ERROR "Unsupported classpath entry")
        endif()
        if(IS_DIRECTORY "${root}/${entry}")
            continue()
        endif()
        file(SIZE "${root}/${entry}" size)
        math(EXPR byte_count "${byte_count} + ${size}")
        math(EXPR file_count "${file_count} + 1")
        if(file_count GREATER 50000 OR byte_count GREATER 536870912 OR size GREATER 16777216)
            message(FATAL_ERROR "Classpath receipt budget exceeded")
        endif()
        file(SHA256 "${root}/${entry}" hash)
        string(APPEND chain "${entry}\t${hash}\n")
    endforeach()
    if(file_count EQUAL 0)
        message(FATAL_ERROR "Empty classpath directory")
    endif()
    string(SHA256 hash "${chain}")
    set(${digest} "${hash}" PARENT_SCOPE)
    set(${count} "${file_count}" PARENT_SCOPE)
endfunction()

function(schema_export_classpath receipt classpath)
    set(json "{\"version\":1,\"revision\":\"${schema_export_commit}\",\"modules\":[")
    set(separator "")
    set(paths)
    foreach(module IN LISTS schema_export_modules)
        set(root "${UPSTREAM}/${module}/target/classes")
        schema_export_hash_tree("${root}" hash count)
        string(APPEND json "${separator}{\"name\":\"${module}\",\"count\":${count},\"sha256\":\"${hash}\"}")
        set(separator ",")
        list(APPEND paths "${root}")
    endforeach()
    string(APPEND json "]}\n")
    list(JOIN paths "${schema_export_separator}" joined)
    set(${receipt} "${json}" PARENT_SCOPE)
    set(${classpath} "${joined}" PARENT_SCOPE)
endfunction()
