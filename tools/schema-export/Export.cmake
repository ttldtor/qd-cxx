cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/Environment.cmake")
schema_export_arguments(JAVA_HOME UPSTREAM CLASSPATH_RECEIPT ARGS RUN)
schema_export_require(JAVA_HOME UPSTREAM CLASSPATH_RECEIPT ARGS RUN)
schema_export_environment()
foreach(input CLASSPATH_RECEIPT ARGS)
    if(NOT EXISTS "${${input}}" OR IS_DIRECTORY "${${input}}")
        message(FATAL_ERROR "${input} must identify an existing file")
    endif()
    file(SIZE "${${input}}" size)
    if(size GREATER 65536)
        message(FATAL_ERROR "${input} exceeds 65536 bytes")
    endif()
endforeach()
schema_export_classpath(receipt classpath)
file(READ "${CLASSPATH_RECEIPT}" supplied_receipt)
if(NOT receipt STREQUAL supplied_receipt)
    message(FATAL_ERROR "Classpath receipt mismatch; rerun explicit Prepare.cmake")
endif()
file(READ "${ARGS}" json)
string(JSON type ERROR_VARIABLE error TYPE "${json}")
if(error OR NOT type STREQUAL "ARRAY")
    message(FATAL_ERROR "ARGS must contain a JSON array of strings")
endif()
string(JSON count LENGTH "${json}")
if(count GREATER 256)
    message(FATAL_ERROR "ARGS exceeds 256 arguments")
endif()
set(argument_code "")
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON type TYPE "${json}" ${index})
        if(NOT type STREQUAL "STRING")
            message(FATAL_ERROR "ARGS must contain only strings")
        endif()
        string(JSON argument GET "${json}" ${index})
        if(argument MATCHES "^--provenance(=|$)")
            message(FATAL_ERROR "--provenance is reserved for the verified launcher")
        endif()
        # Only generated variable names enter the code; values remain quoted data, including empty
        # strings, semicolons and leading newlines that a CMake list/bracket argument would alter.
        set(schema_export_argument_${index} "${argument}")
        string(APPEND argument_code " \"\${schema_export_argument_${index}}\"")
    endforeach()
endif()
schema_export_fresh_run()
file(MAKE_DIRECTORY "${RUN}/classes" "${RUN}/home" "${RUN}/tmp")
file(GLOB sources "${schema_export_directory}/*.java" "${schema_export_directory}/tests/*.java")
list(SORT sources COMPARE STRING CASE SENSITIVE ORDER ASCENDING)
if(NOT sources)
    message(FATAL_ERROR "No exporter Java sources")
endif()
set(chain "")
file(GLOB provenance_sources "${schema_export_directory}/*.java" "${schema_export_directory}/*.cmake"
    "${schema_export_directory}/tests/*.java" "${schema_export_directory}/tests/*.cmake")
list(SORT provenance_sources COMPARE STRING CASE SENSITIVE ORDER ASCENDING)
foreach(source IN LISTS provenance_sources)
    file(SHA256 "${source}" hash)
    file(RELATIVE_PATH relative "${schema_export_directory}" "${source}")
    string(APPEND chain "${relative}\t${hash}\n")
endforeach()
string(SHA256 source_hash "${chain}")
string(SHA256 classpath_hash "${receipt}")
file(WRITE "${RUN}/provenance.json"
    "{\"revision\":\"${schema_export_commit}\",\"exporterSha256\":\"${source_hash}\",\"classpathSha256\":\"${classpath_hash}\",\"classpath\":${receipt}}\n")
execute_process(COMMAND "${schema_export_javac}" -J-Xmx256m -encoding UTF-8 -cp "${classpath}"
    -d "${RUN}/classes" ${sources} TIMEOUT 60 RESULT_VARIABLE result
    OUTPUT_FILE "${RUN}/javac.stdout" ERROR_FILE "${RUN}/javac.stderr")
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Exporter compilation failed (${result}); see RUN/javac.stdout and RUN/javac.stderr")
endif()
set(ENV{TZ} "UTC")
set(launch_code [[execute_process(COMMAND "${schema_export_java}" -Xmx256m -Dfile.encoding=UTF-8 -Duser.language=en
    -Duser.country=US -Duser.timezone=UTC "-Duser.home=${RUN}/home" "-Djava.io.tmpdir=${RUN}/tmp"
    -cp "${RUN}/classes${schema_export_separator}${classpath}" qdcxx.schemaexport.SchemaExport
    --provenance "${RUN}/provenance.json"]])
string(APPEND launch_code "${argument_code}")
string(APPEND launch_code [[ WORKING_DIRECTORY "${RUN}" TIMEOUT 30 RESULT_VARIABLE result)]])
cmake_language(EVAL CODE "${launch_code}")
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Schema export failed (${result})")
endif()
