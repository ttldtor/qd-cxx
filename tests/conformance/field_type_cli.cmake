# Original Java fields and original tape boundaries independently define every output row.
file(MAKE_DIRECTORY "${RUN}")
set(fixtures "${ROOT}/tests/fixtures/encoding/field-types/expected")
foreach(stem IN ITEMS mixed-stream mixed-raw)
    if(stem STREQUAL mixed-raw)
        set(mode raw-message-v1)
    else()
        set(mode legacy)
    endif()
    foreach(format IN ITEMS tsv human)
        set(args --input "${fixtures}/${stem}.qtp" --profile oracle-field-types-v1 --tape-mode "${mode}" --output-format "${format}")
        set(output "${RUN}/${stem}.${format}")
        execute_process(COMMAND "${PROGRAM}" ${args} RESULT_VARIABLE code OUTPUT_FILE "${output}" ERROR_VARIABLE error)
        if(NOT code EQUAL 0 OR NOT error STREQUAL "")
            message(FATAL_ERROR "typed CLI ${stem}/${format}: ${code}: ${error}")
        endif()
        execute_process(COMMAND "${COMPARATOR}" "${fixtures}" "${stem}" "${format}" "${output}" RESULT_VARIABLE code ERROR_VARIABLE error)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "independent typed comparison ${stem}/${format}: ${error}")
        endif()
        file(READ "${output}" baseline)
        string(LENGTH "${baseline}" length)
        foreach(chunk IN ITEMS 1 7 137)
            execute_process(COMMAND "${PROGRAM}" ${args} --chunk-size "${chunk}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
            if(NOT code EQUAL 0 OR NOT out STREQUAL baseline OR NOT error STREQUAL "")
                message(FATAL_ERROR "typed chunk equivalence ${chunk}")
            endif()
        endforeach()
        foreach(version IN ITEMS 1 2)
            execute_process(COMMAND "${PROGRAM}" ${args} --diagnostics-version "${version}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
            if(NOT code EQUAL 0 OR NOT out STREQUAL baseline OR NOT error STREQUAL "")
                message(FATAL_ERROR "typed diagnostic selection changes success")
            endif()
        endforeach()
        execute_process(COMMAND "${PROGRAM}" ${args} --max-output "${length}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
        if(NOT code EQUAL 0 OR NOT out STREQUAL baseline OR NOT error STREQUAL "")
            message(FATAL_ERROR "exact output budget")
        endif()
        math(EXPR short "${length}-1")
        execute_process(COMMAND "${PROGRAM}" ${args} --max-output "${short}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
        if(NOT code EQUAL 6 OR out MATCHES "(^|\n)(complete\t|Complete:)" OR NOT error MATCHES "write")
            message(FATAL_ERROR "short output budget publishes completion")
        endif()
        foreach(option IN ITEMS --field-string-bytes --field-string-units --max-field-bytes --max-field-units --max-owned-field-units)
            execute_process(COMMAND "${PROGRAM}" ${args} "${option}" 0 RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
            if(NOT code EQUAL 6 OR out MATCHES "(^|\n)(complete\t|Complete:)")
                message(FATAL_ERROR "zero field budget ${option}")
            endif()
        endforeach()
    endforeach()
endforeach()

execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE code OUTPUT_VARIABLE help ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR help STREQUAL "" OR NOT error STREQUAL "")
    message(FATAL_ERROR "no-arg help")
endif()
execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT out STREQUAL help OR NOT error STREQUAL "")
    message(FATAL_ERROR "standalone help equivalence")
endif()
foreach(args IN ITEMS "--input;missing" "--input;missing;--profile" "--input;missing;--profile;unknown" "--input;missing;--profile;oracle-field-types-v1;--profile;oracle-field-types-v1" "--input;missing;--profile;oracle-field-types-v1;--field-string-units;-1")
    execute_process(COMMAND "${PROGRAM}" ${args} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
    if(NOT code EQUAL 2 OR NOT out STREQUAL "" OR NOT error MATCHES "usage")
        message(FATAL_ERROR "invalid profile args reached IO: ${args}")
    endif()
endforeach()

# Exact comparison rejects grammar, nullable, value and equal-time frame-association mutations.
file(READ "${RUN}/mixed-raw.tsv" baseline)
string(REGEX MATCHALL "field-record\t[^\n]+\n" records "${baseline}")
list(GET records 0 first)
list(GET records 1 second)
string(REGEX MATCH "field-record\t([0-9]+)" match "${second}")
set(second_frame "${CMAKE_MATCH_1}")
foreach(mutation IN ITEMS unit null-empty tag raw missing-field missing-record duplicate unknown columns early-complete duplicate-complete frame)
    set(changed "${baseline}")
    if(mutation STREQUAL unit)
        string(REPLACE "00410000d83dde00d800000a" "00420000d83dde00d800000a" changed "${changed}")
    elseif(mutation STREQUAL null-empty)
        string(REPLACE "10:0:null" "10:0:empty" changed "${changed}")
    elseif(mutation STREQUAL tag)
        string(REPLACE "40:1:-" "72:1:-" changed "${changed}")
    elseif(mutation STREQUAL raw)
        string(REPLACE "40:-101:-" "40:-102:-" changed "${changed}")
    elseif(mutation STREQUAL missing-field)
        string(REPLACE "40:1:-," "" changed "${changed}")
    elseif(mutation STREQUAL missing-record)
        string(REPLACE "${first}" "" changed "${changed}")
    elseif(mutation STREQUAL duplicate)
        string(REPLACE "${first}" "${first}${first}" changed "${changed}")
    elseif(mutation STREQUAL unknown)
        string(REPLACE "${first}" "unknown\t1\n${first}" changed "${changed}")
    elseif(mutation STREQUAL columns)
        string(REPLACE "field-record\t" "field-record\textra\t" changed "${changed}")
    elseif(mutation STREQUAL early-complete)
        string(REGEX MATCH "complete\t[^\n]+\n" completion "${changed}")
        string(REPLACE "${completion}" "" changed "${changed}")
        string(REPLACE "${first}" "${completion}${first}" changed "${changed}")
    elseif(mutation STREQUAL duplicate-complete)
        string(REGEX MATCH "complete\t[^\n]+\n" completion "${changed}")
        string(APPEND changed "${completion}")
    elseif(mutation STREQUAL frame)
        string(REGEX REPLACE "^field-record\t[0-9]+" "field-record\t${second_frame}" moved "${first}")
        string(REPLACE "${first}" "${moved}" changed "${changed}")
    endif()
    if(changed STREQUAL baseline)
        message(FATAL_ERROR "ineffective mutation ${mutation}")
    endif()
    file(WRITE "${RUN}/mutation.tsv" "${changed}")
    execute_process(COMMAND "${COMPARATOR}" "${fixtures}" mixed-raw tsv "${RUN}/mutation.tsv" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
    if(code EQUAL 0)
        message(FATAL_ERROR "accepted mutation ${mutation}")
    endif()
endforeach()
execute_process(COMMAND "${COMPARATOR}" "${fixtures}" mixed-raw tsv "${RUN}/mixed-raw.tsv" RESULT_VARIABLE code ERROR_VARIABLE error)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "baseline after negative comparisons: ${error}")
endif()
