# Original Java fields and original tape boundaries independently define every output row.
file(MAKE_DIRECTORY "${RUN}")
set(fixtures "${ROOT}/tests/fixtures/events/mapping/expected/default")
foreach(stem IN ITEMS Profile-stream Profile-raw Profile-wire-omitted)
    if(stem STREQUAL Profile-raw)
        set(mode raw-message-v1)
    else()
        set(mode legacy)
    endif()
    foreach(format IN ITEMS tsv human)
        set(args --input "${fixtures}/${stem}.qtp" --profile default-profile-v1 --tape-mode "${mode}" --output-format "${format}")
        set(output "${RUN}/${stem}.${format}")
        execute_process(COMMAND "${PROGRAM}" ${args} RESULT_VARIABLE code OUTPUT_FILE "${output}" ERROR_VARIABLE error)
        if(NOT code EQUAL 0 OR NOT error STREQUAL "")
            message(FATAL_ERROR "Profile CLI ${stem}/${format}: ${code}: ${error}")
        endif()
        execute_process(COMMAND "${COMPARATOR}" "${fixtures}" "${stem}" "${format}" "${output}" RESULT_VARIABLE code ERROR_VARIABLE error)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "independent Profile comparison ${stem}/${format}: ${error}")
        endif()
        file(READ "${output}" baseline)
        string(LENGTH "${baseline}" length)
        foreach(chunk IN ITEMS 1 7 137)
            execute_process(COMMAND "${PROGRAM}" ${args} --chunk-size "${chunk}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
            if(NOT code EQUAL 0 OR NOT out STREQUAL baseline OR NOT error STREQUAL "")
                message(FATAL_ERROR "Profile chunk equivalence ${chunk}")
            endif()
        endforeach()
        foreach(version IN ITEMS 1 2)
            execute_process(COMMAND "${PROGRAM}" ${args} --diagnostics-version "${version}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
            if(NOT code EQUAL 0 OR NOT out STREQUAL baseline OR NOT error STREQUAL "")
                message(FATAL_ERROR "Profile diagnostic selection changes success")
            endif()
        endforeach()
        execute_process(COMMAND "${PROGRAM}" ${args} --max-output "${length}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
        if(NOT code EQUAL 0 OR NOT out STREQUAL baseline OR NOT error STREQUAL "")
            message(FATAL_ERROR "exact output budget")
        endif()
        math(EXPR short "${length}-1")
        execute_process(COMMAND "${PROGRAM}" ${args} --max-output "${short}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
        if(NOT code EQUAL 6 OR out MATCHES "(^|\n)(complete\t|Complete:)" OR NOT error MATCHES "write")
            message(FATAL_ERROR "short output budget publishes completion")
        endif()
        if(NOT stem STREQUAL "Profile-wire-omitted")
        foreach(option IN ITEMS --field-string-bytes --field-string-units --max-field-bytes --max-field-units --max-owned-field-units)
            execute_process(COMMAND "${PROGRAM}" ${args} "${option}" 0 RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
            if(NOT code EQUAL 6 OR out MATCHES "(^|\n)(complete\t|Complete:)")
                message(FATAL_ERROR "zero field budget ${option}")
            endif()
        endforeach()
        endif()
    endforeach()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/cli_help.cmake")
qdcxx_assert_cli_help("${PROGRAM}")
foreach(args IN ITEMS "--input;missing" "--input;missing;--profile" "--input;missing;--profile;unknown" "--input;missing;--profile;default-profile-v1;--profile;default-profile-v1" "--input;missing;--profile;default-profile-v1;--field-string-units;-1")
    execute_process(COMMAND "${PROGRAM}" ${args} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
    if(NOT code EQUAL 2 OR NOT out STREQUAL "" OR NOT error MATCHES "usage")
        message(FATAL_ERROR "invalid profile args reached IO: ${args}")
    endif()
endforeach()


# Negative controls operate on temporary output only. Every event cell and each raw field is checked.
file(READ "${RUN}/Profile-raw.tsv" baseline)
string(REGEX MATCH "profile\t0\t[^\n]+\n" event "${baseline}")
string(REGEX MATCH "profile-record\t[^\n]+\n" raw "${baseline}")
if(event STREQUAL "" OR raw STREQUAL "")
    message(FATAL_ERROR "missing complete first Profile pair")
endif()
string(REPLACE "\t" ";" cells "${event}")
foreach(index RANGE 1 20)
    set(mutated "${cells}")
    list(GET cells ${index} value)
    if((index GREATER_EQUAL 2 AND index LESS_EQUAL 5) OR (index GREATER_EQUAL 7 AND index LESS_EQUAL 12))
        set(value "0000000000000001")
    elseif(index EQUAL 16 OR index EQUAL 17)
        set(value "empty")
    else()
        string(STRIP "${value}" value)
        math(EXPR value "${value}+1")
    endif()
    # Preserve the final row terminator when mutating the last event cell.
    if(index EQUAL 20)
        string(APPEND value "\n")
    endif()
    list(REMOVE_AT mutated ${index})
    list(INSERT mutated ${index} "${value}")
    list(JOIN mutated "\t" changed_row)
    string(REPLACE "${event}" "${changed_row}" changed "${baseline}")
    file(WRITE "${RUN}/mutation.tsv" "${changed}")
    execute_process(COMMAND "${COMPARATOR}" "${fixtures}" Profile-raw tsv "${RUN}/mutation.tsv" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
    if(code EQUAL 0 OR changed STREQUAL baseline)
        message(FATAL_ERROR "event cell ${index} mutation accepted or ineffective")
    endif()
endforeach()
string(REPLACE "\t" ";" raw_cells "${raw}")
list(GET raw_cells 6 fields)
string(REPLACE "," ";" fields "${fields}")
foreach(index RANGE 0 15)
    set(mutated "${fields}")
    list(REMOVE_AT mutated ${index})
    list(INSERT mutated ${index} "8:42:-")
    list(JOIN mutated "," values)
    set(mutated_row "${raw_cells}")
    list(REMOVE_AT mutated_row 6)
    list(APPEND mutated_row "${values}")
    list(JOIN mutated_row "\t" changed_row)
    string(REPLACE "${raw}" "${changed_row}" changed "${baseline}")
    file(WRITE "${RUN}/mutation.tsv" "${changed}")
    execute_process(COMMAND "${COMPARATOR}" "${fixtures}" Profile-raw tsv "${RUN}/mutation.tsv" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
    if(code EQUAL 0 OR changed STREQUAL baseline)
        message(FATAL_ERROR "raw field ${index} mutation accepted or ineffective")
    endif()
endforeach()
foreach(stem IN ITEMS Profile-stream Profile-raw Profile-wire-omitted)
    foreach(format IN ITEMS tsv human)
        file(READ "${RUN}/${stem}.${format}" baseline)
        foreach(mutation IN ITEMS unknown trailing duplicate missing null-empty flags time decimal units)
            set(changed "${baseline}")
            if(mutation STREQUAL unknown)
                set(changed "unknown\n${baseline}")
            elseif(mutation STREQUAL trailing)
                string(APPEND changed "unknown\n")
            elseif(mutation STREQUAL duplicate)
                string(APPEND changed "${baseline}")
            elseif(mutation STREQUAL missing)
                string(REGEX REPLACE "[^\n]+\n$" "" changed "${changed}")
            elseif(mutation STREQUAL null-empty)
                string(REPLACE "null" "empty" changed "${changed}")
            elseif(mutation STREQUAL flags)
                if(stem STREQUAL Profile-wire-omitted)
                    continue()
                endif()
                string(REPLACE "1985229334" "1985229335" changed "${changed}")
            elseif(mutation STREQUAL time)
                if(stem STREQUAL Profile-wire-omitted)
                    continue()
                endif()
                string(REPLACE "-3000" "-3001" changed "${changed}")
            elseif(mutation STREQUAL decimal)
                if(format STREQUAL human)
                    string(REPLACE "NaN" "0" changed "${changed}")
                else()
                    string(REPLACE "7ff8000000000000" "0000000000000000" changed "${changed}")
                endif()
            elseif(mutation STREQUAL units)
                if(stem STREQUAL Profile-wire-omitted)
                    continue()
                endif()
                if(format STREQUAL human)
                    string(REPLACE "\\uD800" "\\uD801" changed "${changed}")
                else()
                    string(REPLACE "00410000d8000058dfff" "00410000d8010058dfff" changed "${changed}")
                endif()
            endif()
            if(changed STREQUAL baseline)
                message(FATAL_ERROR "ineffective ${stem}/${format}/${mutation}")
            endif()
            file(WRITE "${RUN}/mutation.${format}" "${changed}")
            execute_process(COMMAND "${COMPARATOR}" "${fixtures}" "${stem}" "${format}" "${RUN}/mutation.${format}" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
            if(code EQUAL 0)
                message(FATAL_ERROR "accepted ${stem}/${format}/${mutation}")
            endif()
        endforeach()
        execute_process(COMMAND "${COMPARATOR}" "${fixtures}" "${stem}" "${format}" "${RUN}/${stem}.${format}" RESULT_VARIABLE code ERROR_VARIABLE error)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "baseline after negative checks: ${error}")
        endif()
    endforeach()
endforeach()
foreach(args IN ITEMS "--input;missing;--profile;default-profile-v1;--max-event-units;-1" "--input;missing;--profile;default-profile-v1;--max-event-units;18446744073709551616" "--input;missing;--profile;default-profile-v1;--max-event-units;1;--max-event-units;1" "--input;missing;--profile;default-profile-v1;--help")
    execute_process(COMMAND "${PROGRAM}" ${args} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
    if(NOT code EQUAL 2 OR NOT out STREQUAL "" OR NOT error MATCHES "usage")
        message(FATAL_ERROR "invalid Profile limit args reached IO: ${args}")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" --input "${fixtures}/Profile-stream.qtp" --profile default-profile-v1 --max-event-units 0 RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
if(NOT code EQUAL 6 OR out MATCHES "(^|\n)complete\t" OR NOT error MATCHES "mapping")
    message(FATAL_ERROR "zero event ownership budget")
endif()
