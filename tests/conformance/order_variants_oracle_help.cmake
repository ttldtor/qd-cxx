# Internal caller: cmake -DPWSH=<pwsh> -P tests/conformance/order_variants_oracle_help.cmake.
# Checks both new launchers without operational inputs or Java work; contract failures are terminal.
cmake_minimum_required(VERSION 3.25)

if(NOT PWSH)
    find_program(PWSH pwsh REQUIRED)
endif()
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
foreach(name IN ITEMS Invoke-Oracle.ps1 Invoke-FieldTimeOracle.ps1)
    set(launcher "${repo}/tools/upstream/order-variants-oracle/${name}")
    foreach(mode IN ITEMS noargs help ru invalid)
        set(args)
        if(mode STREQUAL "help")
            set(args -Help)
        elseif(mode STREQUAL "ru")
            set(args -HelpRu)
        elseif(mode STREQUAL "invalid")
            set(args -Mode Verify)
        endif()
        execute_process(COMMAND "${PWSH}" -NoProfile -File "${launcher}" ${args}
            RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
        if(mode STREQUAL "invalid")
            if(code EQUAL 0 OR NOT err MATCHES "Required inputs missing")
                message(FATAL_ERROR "${name}: incomplete invocation did not reject with an input error: ${code}: ${err}")
            endif()
        else()
            if(NOT code EQUAL 0 OR NOT err STREQUAL "" OR out STREQUAL "")
                message(FATAL_ERROR "${name}: help failed: ${mode}: ${code}: ${err}")
            endif()
            foreach(required IN ITEMS RunDirectory JavaHome Logger Capture Verify)
                if(NOT out MATCHES "${required}")
                    message(FATAL_ERROR "${name}: ${mode} help lacks ${required}")
                endif()
            endforeach()
            if(mode STREQUAL "noargs")
                set(noargs "${out}")
            elseif(mode STREQUAL "help" AND NOT out STREQUAL noargs)
                message(FATAL_ERROR "${name}: no-argument and -Help outputs differ")
            endif()
            if(mode STREQUAL "ru")
                if(NOT out MATCHES "Exit0" OR NOT out MATCHES "Exit1")
                    message(FATAL_ERROR "${name}: Russian help lacks exit contract")
                endif()
            elseif(NOT out MATCHES "128MiB" OR NOT out MATCHES "60-second")
                message(FATAL_ERROR "${name}: English full help lacks resource/time limits")
            endif()
        endif()
    endforeach()
endforeach()
message(STATUS "Both variant oracles: noargs/EN/RU full help and incomplete invocation PASS (8 subprocesses)")
