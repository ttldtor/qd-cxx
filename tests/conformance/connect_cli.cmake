cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED PROGRAM OR NOT DEFINED RUN)
    message(FATAL_ERROR "PROGRAM and private RUN are required")
endif()
file(MAKE_DIRECTORY "${RUN}")
execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE noargs OUTPUT_VARIABLE first ERROR_VARIABLE errors TIMEOUT 5)
if(NOT noargs EQUAL 0 OR NOT errors STREQUAL "" OR first STREQUAL "")
    message(FATAL_ERROR "no-argument help contract failed: ${noargs}; ${errors}")
endif()
execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE status OUTPUT_VARIABLE second ERROR_VARIABLE errors TIMEOUT 5)
if(NOT status EQUAL 0 OR NOT errors STREQUAL "" OR NOT first STREQUAL second)
    message(FATAL_ERROR "standalone --help differs from no-argument help")
endif()
execute_process(COMMAND "${PROGRAM}" --help-ru RESULT_VARIABLE status OUTPUT_VARIABLE russian ERROR_VARIABLE errors TIMEOUT 5)
if(NOT status EQUAL 0 OR NOT errors STREQUAL "" OR russian STREQUAL "" OR russian STREQUAL first)
    message(FATAL_ERROR "standalone Russian help contract failed")
endif()
string(FIND "${russian}" "ограниченный клиент STREAM" russianText)
if(russianText EQUAL -1)
    message(FATAL_ERROR "Russian native help is not the expected UTF-8 text")
endif()
foreach(arguments IN ITEMS "--unknown" "--help;--symbol;IBM" "--host;127.0.0.1;--port;1" "--port;0" "--security;tls" "--security;synthetic-secret" "--connect-timeout-ms;2147483648" "--poll-interval-ms;0")
    execute_process(COMMAND "${PROGRAM}" ${arguments} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
    if(status EQUAL 0 OR NOT output STREQUAL "" OR errors STREQUAL "")
        message(FATAL_ERROR "invalid/incomplete arguments activated work")
    endif()
    string(FIND "${errors}" "synthetic-secret" secret)
    if(NOT secret EQUAL -1)
        message(FATAL_ERROR "invalid arguments leaked a synthetic secret")
    endif()
endforeach()
file(WRITE "${RUN}/help-en.txt" "${first}")
file(WRITE "${RUN}/help-ru.txt" "${russian}")
if(UNIX AND EXISTS "/dev/full")
    execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE status OUTPUT_FILE "/dev/full" ERROR_VARIABLE errors TIMEOUT 5)
    if(status EQUAL 0)
        message(FATAL_ERROR "failed help sink reported success")
    endif()
endif()
# CTest supplies explicit build availability; standalone callers may omit these optional checks.
function(expect_recovery_refusal expected)
    execute_process(COMMAND "${PROGRAM}" --mode recovery --host 127.0.0.1 --port 1 --symbol ALPHA ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
    string(FIND "${errors}" "${expected}" reason)
    string(FIND "${errors}" "MUST-NOT-OPEN" leakedPath)
    if(NOT result EQUAL 2 OR NOT output STREQUAL "" OR reason EQUAL -1 OR NOT leakedPath EQUAL -1)
        message(FATAL_ERROR "disabled recovery feature did not refuse before working setup")
    endif()
endfunction()
if(DEFINED RECOVERY_ENABLED AND NOT RECOVERY_ENABLED)
    expect_recovery_refusal("subscription recovery is unavailable" --schema-json MUST-NOT-OPEN --record-id 0)
elseif(DEFINED RECOVERY_ENABLED AND RECOVERY_ENABLED)
    if(DEFINED JSON_ENABLED AND NOT JSON_ENABLED)
        expect_recovery_refusal("native binary JSON schema loading is unavailable" --schema-json MUST-NOT-OPEN --record-id 0)
    endif()
    if(DEFINED TLS_ENABLED AND NOT TLS_ENABLED)
        expect_recovery_refusal("verified TLS recovery is unavailable" --security tls --tls-trust-pem MUST-NOT-OPEN --tls-reference feed.invalid)
    endif()
endif()
message(STATUS "CLI help, invalid/incomplete input, sink failures and explicitly selected feature-OFF refusals passed")
