# Internal CTest helper: PROGRAM is the built demo; no SDK, DNS, sockets or input files are needed.
if(NOT DEFINED PROGRAM OR NOT EXISTS "${PROGRAM}")
    message(FATAL_ERROR "PROGRAM must name the built feed demo")
endif()
foreach(language IN ITEMS noargs en)
    set(arguments)
    if(language STREQUAL "en")
        list(APPEND arguments --help)
    endif()
    execute_process(COMMAND "${PROGRAM}" ${arguments} RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT code STREQUAL "0" OR NOT output MATCHES "--address" OR
       NOT output MATCHES "--duration-ms" OR NOT output MATCHES "7300" OR NOT error STREQUAL "")
        message(FATAL_ERROR "${language} help failed: ${code}; ${output}; ${error}")
    endif()
    if(language STREQUAL "noargs")
        set(default_help "${output}")
    elseif(language STREQUAL "en" AND NOT output STREQUAL default_help)
        message(FATAL_ERROR "No-argument help must equal standalone --help")
    endif()
endforeach()
foreach(argument IN ITEMS --unknown --duration-ms)
    execute_process(COMMAND "${PROGRAM}" "${argument}" RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT code STREQUAL "2")
        message(FATAL_ERROR "Invalid arguments must return 2: ${code}; ${output}; ${error}")
    endif()
endforeach()
if(EXISTS "/dev/full")
    execute_process(COMMAND "${PROGRAM}" --help OUTPUT_FILE /dev/full RESULT_VARIABLE code
        ERROR_VARIABLE error TIMEOUT 5)
    if(NOT code STREQUAL "1")
        message(FATAL_ERROR "Failed help output must return 1: ${code}; ${error}")
    endif()
endif()
foreach(option IN ITEMS --address --symbol --duration-ms)
    if(option STREQUAL "--duration-ms")
        set(value "10")
    else()
        set(value "value")
    endif()
    execute_process(COMMAND "${PROGRAM}" --run "${option}" "${value}" "${option}" "${value}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT code STREQUAL "2" OR NOT output STREQUAL "")
        message(FATAL_ERROR "Duplicate ${option} was not rejected before connecting: ${code}; ${output}; ${error}")
    endif()
endforeach()
string(REPEAT "x" 4097 long_address)
string(REPEAT "x" 129 long_symbol)
foreach(option IN ITEMS --address --symbol)
    if(option STREQUAL "--address")
        set(value "${long_address}")
    else()
        set(value "${long_symbol}")
    endif()
    execute_process(COMMAND "${PROGRAM}" --run "${option}" "${value}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT code STREQUAL "2" OR NOT output STREQUAL "")
        message(FATAL_ERROR "Oversized ${option} was not rejected before connecting: ${code}")
    endif()
endforeach()
