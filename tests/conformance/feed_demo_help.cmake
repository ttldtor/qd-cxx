# Internal CTest helper: PROGRAM is the built demo; no SDK, DNS, sockets or input files are needed.
if(NOT DEFINED PROGRAM OR NOT EXISTS "${PROGRAM}")
    message(FATAL_ERROR "PROGRAM must name the built feed demo")
endif()
foreach(language IN ITEMS noargs en ru)
    set(arguments)
    if(language STREQUAL "en")
        list(APPEND arguments --help)
    elseif(language STREQUAL "ru")
        list(APPEND arguments --help-ru)
    endif()
    execute_process(COMMAND "${PROGRAM}" ${arguments} RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT code STREQUAL "0" OR NOT output MATCHES "--address" OR
       NOT output MATCHES "--duration-ms" OR NOT output MATCHES "7300" OR NOT error STREQUAL "")
        message(FATAL_ERROR "${language} help failed: ${code}; ${output}; ${error}")
    endif()
    if(language STREQUAL "noargs")
        set(default_help "${output}")
    elseif(language STREQUAL "en" AND NOT output STREQUAL default_help)
        message(FATAL_ERROR "No-argument help must equal standalone --help")
    endif()
endforeach()
foreach(argument IN ITEMS --unknown --duration-ms)
    execute_process(COMMAND "${PROGRAM}" "${argument}" RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT code STREQUAL "2")
        message(FATAL_ERROR "Invalid arguments must return 2: ${code}; ${output}; ${error}")
    endif()
endforeach()
