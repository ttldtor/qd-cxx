# CTest invokes help and refusals without operational input or any Java/network work.
set(launcher "${ORG_TTLDTOR_QDCXX_SELECTOR_SOURCE}/tools/upstream/selector-oracle/Invoke-Oracle.ps1")
foreach(mode IN ITEMS noargs en ru invalid_paths incomplete invalid_work_path)
    set(arguments)
    if(mode STREQUAL "en")
        set(arguments -Help)
    elseif(mode STREQUAL "ru")
        set(arguments -HelpRu)
    elseif(mode STREQUAL "invalid_paths")
        set(arguments -Help -Upstream X:/not-present -JavaHome X:/not-present -Logger X:/not-present -RunDirectory X:/not-present)
    elseif(mode STREQUAL "incomplete")
        set(arguments -Mode Verify)
    elseif(mode STREQUAL "invalid_work_path")
        set(arguments -Mode Verify -Upstream X:/not-present -JavaHome X:/not-present -Logger X:/not-present -RunDirectory X:/not-present)
    endif()
    execute_process(COMMAND "${ORG_TTLDTOR_QDCXX_SELECTOR_ORACLE_PWSH}" -NoProfile -File "${launcher}" ${arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    if(mode STREQUAL "incomplete" OR mode STREQUAL "invalid_work_path")
        if(NOT result EQUAL 1 OR NOT error MATCHES "Help")
            message(FATAL_ERROR "Selector invalid invocation lacked actionable help: ${result} ${output} ${error}")
        endif()
    elseif(NOT result EQUAL 0 OR NOT output MATCHES "[Hh]elp|[Сс]правк|SYNOPSIS")
        message(FATAL_ERROR "Selector help ${mode} failed: ${result} ${output} ${error}")
    endif()
    if(mode STREQUAL "noargs")
        set(noargs "${output}")
    elseif(mode STREQUAL "en" AND NOT output STREQUAL noargs)
        message(FATAL_ERROR "Selector noargs and explicit help differ")
    endif()
endforeach()
