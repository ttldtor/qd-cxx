# Portable process checks: actual CLI stdout is parsed by the strict C++ comparator.
file(MAKE_DIRECTORY "${RUN}")
set(fixtures "${ROOT}/tests/fixtures/protocol/raw-tape/expected")
set(accepted raw-synthetic raw-hs raw-quote connector-quote connector-default timing-sequence
    heartbeat-absent heartbeat-preserves-time explicit-zero-empty empty-envelope opt-absent opt-empty opt-hs
    matrix-MESSAGE--1-5 matrix-MESSAGE-5-5)
file(GLOB boundaries RELATIVE "${fixtures}" "${fixtures}/boundary-*.qtp")
foreach(boundary IN LISTS boundaries)
    string(REGEX REPLACE "\\.qtp$" "" stem "${boundary}")
    list(APPEND accepted "${stem}")
endforeach()
foreach(stem IN LISTS accepted)
    if(stem MATCHES "quote|connector-default")
        set(profile default-quote-v1)
    else()
        set(profile oracle-sre-v1)
    endif()
    set(arguments --input "${fixtures}/${stem}.qtp" --profile "${profile}" --tape-mode raw-message-v1)
    execute_process(COMMAND "${PROGRAM}" ${arguments} RESULT_VARIABLE code OUTPUT_FILE "${RUN}/${stem}.tsv" ERROR_VARIABLE error)
    if(NOT code EQUAL 0 OR NOT error STREQUAL "")
        message(FATAL_ERROR "RAW ${stem} failed: ${code}: ${error}")
    endif()
    file(READ "${RUN}/${stem}.tsv" baseline)
    execute_process(COMMAND "${COMPARATOR}" "${fixtures}" "${stem}" "${RUN}/${stem}.tsv" RESULT_VARIABLE code ERROR_VARIABLE error)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "RAW strict ${stem} comparison: ${error}")
    endif()
    foreach(version IN ITEMS 1 2)
        execute_process(COMMAND "${PROGRAM}" ${arguments} --diagnostics-version "${version}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
        if(NOT code EQUAL 0 OR NOT out STREQUAL baseline OR NOT error STREQUAL "")
            message(FATAL_ERROR "Successful diagnostics-version changes output: ${stem}/${version}")
        endif()
    endforeach()
    if(stem MATCHES "^(raw-synthetic|raw-quote|connector-quote|timing-sequence)$")
        foreach(chunk IN ITEMS 1 7 137)
            execute_process(COMMAND "${PROGRAM}" ${arguments} --chunk-size "${chunk}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
            if(NOT code EQUAL 0 OR NOT out STREQUAL baseline OR NOT error STREQUAL "")
                message(FATAL_ERROR "RAW chunk output changed: ${stem}/${chunk}")
            endif()
        endforeach()
        foreach(format IN ITEMS tsv human)
            execute_process(COMMAND "${PROGRAM}" ${arguments} --output-format "${format}" RESULT_VARIABLE code OUTPUT_VARIABLE full ERROR_VARIABLE error)
            if(NOT code EQUAL 0 OR NOT error STREQUAL "")
                message(FATAL_ERROR "RAW ${format} failed: ${stem}")
            endif()
            if(format STREQUAL human)
                foreach(needle IN ITEMS "qdcxx-tape-inspect human 3 profile=${profile} tape-mode=raw-message-v1 identities=local" "RAW_DATA (5)" "Heartbeat: frame=" "Timing: frame=")
                    string(FIND "${full}" "${needle}" position)
                    if(position LESS 0)
                        message(FATAL_ERROR "Missing human grammar: ${needle}")
                    endif()
                endforeach()
                if(stem MATCHES quote)
                    foreach(needle IN ITEMS "timestampMs=1600000000123 eventTimeSequence=6871947674115899392 eventTimeMs=1600000000123" "Bid.Time=1700000000000 ms" "Bid.Price=100.25 (type:120 raw:2566530)" "eventTime=1600000000123")
                        string(FIND "${full}" "${needle}" position)
                        if(position LESS 0)
                            message(FATAL_ERROR "Human exact Quote timing/value absent: ${needle}")
                        endif()
                    endforeach()
                endif()
                if(stem STREQUAL raw-synthetic)
                    string(FIND "${full}" "fields={R.y=10, R.x=11, R.z=12}" position)
                    if(position LESS 0)
                        message(FATAL_ERROR "Human S/R/E exact local order differs")
                    endif()
                endif()
                foreach(version IN ITEMS 1 2)
                    execute_process(COMMAND "${PROGRAM}" ${arguments} --output-format human --diagnostics-version "${version}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
                    if(NOT code EQUAL 0 OR NOT out STREQUAL full OR NOT error STREQUAL "")
                        message(FATAL_ERROR "Human diagnostic version changed success")
                    endif()
                endforeach()
            endif()
            string(LENGTH "${full}" exact)
            math(EXPR short "${exact}-1")
            math(EXPR extra "${exact}+1")
            foreach(bound IN ITEMS 0 "${short}" "${exact}" "${extra}")
                execute_process(COMMAND "${PROGRAM}" ${arguments} --output-format "${format}" --max-output "${bound}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
                if(bound LESS exact)
                    if(NOT code EQUAL 6 OR out MATCHES "complete\t|Complete:")
                        message(FATAL_ERROR "Output budget falsely succeeds: ${stem}/${format}/${bound}")
                    endif()
                elseif(NOT code EQUAL 0 OR NOT out STREQUAL full OR NOT error STREQUAL "")
                    message(FATAL_ERROR "Sufficient output budget changes output")
                endif()
            endforeach()
        endforeach()
    endif()
endforeach()

execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE code OUTPUT_VARIABLE help ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR help STREQUAL "" OR NOT error STREQUAL "")
    message(FATAL_ERROR "No-argument help failed")
endif()
execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT out STREQUAL help OR NOT error STREQUAL "")
    message(FATAL_ERROR "Help differs from no arguments")
endif()
foreach(args IN ITEMS "--input;missing;--tape-mode" "--input;missing;--tape-mode;unknown" "--input;missing;--tape-mode;legacy;--tape-mode;raw-message-v1" "--input;missing;--max-timing-events;-1")
    execute_process(COMMAND "${PROGRAM}" --profile oracle-sre-v1 ${args} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
    if(NOT code EQUAL 2 OR NOT out STREQUAL "" OR NOT error MATCHES "usage")
        message(FATAL_ERROR "Invalid arguments reached input IO: ${args}")
    endif()
endforeach()
file(WRITE "${RUN}/empty.qtp" "")
file(WRITE "${RUN}/malformed.qtp" "x")
foreach(pair IN ITEMS "${RUN}/missing.qtp;3" "${RUN}/empty.qtp;5" "${RUN}/malformed.qtp;5" "${fixtures}/unsupported-message.qtp;4")
    list(GET pair 0 input)
    list(GET pair 1 expected)
    foreach(version IN ITEMS 1 2)
        execute_process(COMMAND "${PROGRAM}" --input "${input}" --profile oracle-sre-v1 --tape-mode raw-message-v1 --diagnostics-version "${version}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
        if(NOT code EQUAL expected OR out MATCHES "complete\t")
            message(FATAL_ERROR "File error class changed: ${input}: ${code}: ${error}")
        endif()
        if(version EQUAL 1)
            set(prefix "^incomplete\t${expected}\t")
        else()
            set(prefix "^incomplete-v2\t${expected}\t")
        endif()
        if(NOT error MATCHES "${prefix}")
            message(FATAL_ERROR "Diagnostic grammar changed: ${error}")
        endif()
    endforeach()
endforeach()

# Both profiles and formats retain byte/exit/diagnostic equivalence in omitted/explicit legacy mode.
foreach(profile IN ITEMS oracle-sre-v1 default-quote-v1)
    foreach(format IN ITEMS tsv human)
        foreach(version IN ITEMS 1 2)
            foreach(input IN ITEMS "${fixtures}/raw-synthetic.qtp" "${fixtures}/raw-quote.qtp" "${ROOT}/tests/fixtures/protocol/quote/expected/default-quote.qtp" "${fixtures}/stream-synthetic.qtp")
                set(arguments --input "${input}" --profile "${profile}" --output-format "${format}" --diagnostics-version "${version}")
                execute_process(COMMAND "${PROGRAM}" ${arguments} RESULT_VARIABLE omitted_code OUTPUT_VARIABLE omitted ERROR_VARIABLE omitted_error)
                execute_process(COMMAND "${PROGRAM}" ${arguments} --tape-mode legacy RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error)
                if(NOT code STREQUAL omitted_code OR NOT out STREQUAL omitted OR NOT error STREQUAL omitted_error)
                    message(FATAL_ERROR "Explicit legacy differs: ${profile}/${format}/${version}/${input}")
                endif()
            endforeach()
        endforeach()
    endforeach()
endforeach()

# A comparator that misses these changes cannot serve as semantic acceptance.
file(READ "${RUN}/raw-quote.tsv" baseline)
set(mutations
    "timestampMs"
    "timing"
    "field"
    "order"
    "arity"
    "unknown"
    "completion")
foreach(mutation IN LISTS mutations)
    set(changed "${baseline}")
    if(mutation STREQUAL timestampMs)
        string(REPLACE "1600000000123" "1600000000124" changed "${changed}")
    elseif(mutation STREQUAL timing)
        string(REPLACE "6871947674115899392" "6871947674115899393" changed "${changed}")
    elseif(mutation STREQUAL field)
        string(REPLACE "120:2566530" "120:2566531" changed "${changed}")
    elseif(mutation STREQUAL order)
        string(REPLACE "56:1700000000,2:78" "2:78,56:1700000000" changed "${changed}")
    elseif(mutation STREQUAL arity)
        string(REPLACE "descriptor-v3\t" "descriptor-v3\textra\t" changed "${changed}")
    elseif(mutation STREQUAL unknown)
        string(APPEND changed "unknown\t0\n")
    else()
        string(REGEX REPLACE "complete\t[^\n]*\n" "" changed "${changed}")
    endif()
    if(changed STREQUAL baseline)
        message(FATAL_ERROR "Mutation did not modify baseline: ${mutation}")
    endif()
    string(REGEX REPLACE "\n$" "" changed "${changed}")
    file(CONFIGURE OUTPUT "${RUN}/mutated-${mutation}.tsv" CONTENT "@changed@" @ONLY NEWLINE_STYLE UNIX)
    execute_process(COMMAND "${COMPARATOR}" "${fixtures}" raw-quote "${RUN}/mutated-${mutation}.tsv" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
    if(code EQUAL 0)
        message(FATAL_ERROR "Strict comparator accepted ${mutation} mutation")
    endif()
endforeach()
file(READ "${RUN}/timing-sequence.tsv" timing_baseline)
string(REGEX MATCH "record\t15\t6\t[^\n]*\n" migrated "${timing_baseline}")
if(migrated STREQUAL "")
    message(FATAL_ERROR "Missing migration target")
endif()
string(REPLACE "${migrated}" "" changed "${timing_baseline}")
string(REPLACE "record\t15\t" "record\t14\t" migrated "${migrated}")
string(REPLACE "frame\t15\t" "${migrated}frame\t15\t" changed "${changed}")
string(REGEX REPLACE "\n$" "" changed "${changed}")
file(CONFIGURE OUTPUT "${RUN}/mutated-frame-migration.tsv" CONTENT "@changed@" @ONLY NEWLINE_STYLE UNIX)
execute_process(COMMAND "${COMPARATOR}" "${fixtures}" timing-sequence "${RUN}/mutated-frame-migration.tsv" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(code EQUAL 0)
    message(FATAL_ERROR "Strict comparator accepted equal-timestamp frame migration")
endif()
execute_process(COMMAND "${COMPARATOR}" "${fixtures}" timing-sequence "${RUN}/timing-sequence.tsv" RESULT_VARIABLE code ERROR_VARIABLE error)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Unchanged timing baseline failed: ${error}")
endif()
execute_process(COMMAND "${COMPARATOR}" "${fixtures}" raw-quote "${RUN}/raw-quote.tsv" RESULT_VARIABLE code ERROR_VARIABLE error)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Unchanged post-mutation baseline failed: ${error}")
endif()
list(LENGTH accepted count)
message(STATUS "RAW CLI: ${count} exact Java projections, legacy/profile/diagnostic cross, output budgets and eight rejecting mutations passed")
