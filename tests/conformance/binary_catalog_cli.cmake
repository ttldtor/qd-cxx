cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED PROGRAM OR NOT DEFINED ROOT)
    message(FATAL_ERROR "PROGRAM and ROOT are required")
endif()
execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE noArgs OUTPUT_VARIABLE help ERROR_VARIABLE helpError)
execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE helpCode OUTPUT_VARIABLE explicitHelp ERROR_VARIABLE explicitError)
if(NOT noArgs EQUAL 0 OR NOT helpCode EQUAL 0 OR NOT help STREQUAL explicitHelp OR NOT helpError STREQUAL "" OR NOT explicitError STREQUAL "")
    message(FATAL_ERROR "No-argument/help equivalence failed")
endif()
foreach(option --field-payload-encoded-bytes --field-payload-bytes --max-payload-encoded-bytes --max-payload-work-bytes --max-owned-payload-bytes --max-snapshot-units)
    string(FIND "${help}" "${option}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Missing broad budget help: ${option}")
    endif()
endforeach()
set(input "${ROOT}/tests/fixtures/encoding/field-types/expected/objects/composer-9-content.qtp")
execute_process(COMMAND "${PROGRAM}" --input "${input}" --wire-schema binary-catalog-v1 --tape-mode binary-catalog-v1 RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT error STREQUAL "" OR NOT output MATCHES "format\tqdcxx-tape-inspect\t8\tbinary-catalog-v1\tbinary-catalog-v1" OR NOT output MATCHES "complete\t")
    message(FATAL_ERROR "Default broad preset failed: ${code}: ${error}")
endif()
foreach(option --field-payload-encoded-bytes --field-payload-bytes --max-payload-encoded-bytes --max-payload-work-bytes --max-owned-payload-bytes --max-snapshot-units)
    execute_process(COMMAND "${PROGRAM}" --input "${input}" --wire-schema binary-catalog-v1 --tape-mode binary-catalog-v1 "${option}" 0 RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code EQUAL 6 OR output MATCHES "complete\t")
        message(FATAL_ERROR "Explicit zero was not a finite stop: ${option}: ${code}")
    endif()
    execute_process(COMMAND "${PROGRAM}" --input "${ROOT}/does-not-exist.qtp" --wire-schema ordinary-v1 "${option}" 0 RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code EQUAL 2)
        message(FATAL_ERROR "Old modes accepted a broad-only override: ${option}")
    endif()
endforeach()
foreach(schema ordinary-v1 binary-catalog-v1)
    if(schema STREQUAL "ordinary-v1")
        set(mode binary-catalog-v1)
    else()
        set(mode legacy)
    endif()
    execute_process(COMMAND "${PROGRAM}" --input "${ROOT}/does-not-exist.qtp" --wire-schema "${schema}" --tape-mode "${mode}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code EQUAL 2)
        message(FATAL_ERROR "Mismatched broad schema/mode reached input IO")
    endif()
endforeach()
message(STATUS "PASS: explicit binary preset, all six zero overrides, old-profile refusal and no-IO help/usage")
