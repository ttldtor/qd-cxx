cmake_minimum_required(VERSION 3.25)
foreach(required PROGRAM ROOT RUN JSON_ENABLED)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${RUN}")

# Every child terminates independently, without interactive windows.
function(invoke name expected)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic WORKING_DIRECTORY "${RUN}" TIMEOUT 30)
    file(WRITE "${RUN}/${name}.stdout" "${output}")
    file(WRITE "${RUN}/${name}.stderr" "${diagnostic}")
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: exit ${status}, expected ${expected}: ${diagnostic}")
    endif()
    if(NOT expected EQUAL 0 AND NOT diagnostic MATCHES "^tape-write-error\t1\t[^\t\n]+\t[^\t\n]+\tpublished=[01]\n$")
        message(FATAL_ERROR "${name}: unexpected content-free diagnostic")
    endif()
    set(lastOutput "${output}" PARENT_SCOPE)
    set(lastDiagnostic "${diagnostic}" PARENT_SCOPE)
endfunction()

invoke(no-arguments 0)
set(help "${lastOutput}")
if(help STREQUAL "" OR NOT lastDiagnostic STREQUAL "")
    message(FATAL_ERROR "No-argument help streams")
endif()
invoke(help 0 --help)
if(NOT help STREQUAL lastOutput OR NOT lastDiagnostic STREQUAL "")
    message(FATAL_ERROR "Help equivalence")
endif()
set(base --input "${RUN}/absent-input.qtp" --output "${RUN}/absent-output.qtp"
    --tape-mode raw-message-v1 --profile oracle-sre-v1)
invoke(unknown 2 --unknown value)
invoke(incomplete 2 --input)
invoke(mixed-help 2 --help --input value)
invoke(equal-spelling 2 --input=value)
invoke(positional 2 value)
invoke(source-conflict 2 ${base} --schema missing.json)
invoke(duplicate 2 ${base} --input again)
invoke(unsupported-mode 4 --input missing --output missing-output --profile oracle-sre-v1 --tape-mode legacy)
invoke(unsupported-profile 4 --input missing --output missing-output --profile other --tape-mode raw-message-v1)

set(options
    --max-input-bytes 16777216 --max-output-bytes 16777216 --max-frame-bytes 1048576
    --max-frames 65536 --max-records 1048576 --max-fields 8388608 --max-values 8388608
    --max-descriptions 1024 --max-description-fields 16384 --max-name-units 1024
    --max-description-name-units 1048576 --max-construction-units 67108864
    --max-admission-work-units 67108864 --max-admission-scratch-bytes 16777216
    --max-admission-scratch-units 4194304 --max-writer-work-units 67108864
    --max-descriptor-properties 16 --max-descriptor-messages 1 --descriptor-string-bytes 65536
    --descriptor-string-units 16384 --max-descriptor-units 65536 --max-timing-events 65536
    --symbol-units 16384 --max-symbol-units 4194304 --field-string-bytes 65536
    --field-string-units 16384 --max-field-bytes 16777216 --max-field-units 4194304
    --max-owned-field-units 4194304 --max-scratch-bytes 1048585 --max-scratch-units 32768
    --max-schema-bytes 1048576 --max-schema-depth 16 --max-schema-records 1024
    --max-schema-fields 16384 --max-schema-lookups 32768 --max-schema-name-units 1024
    --max-schema-total-name-units 1048576)
list(LENGTH options optionElements)
if(NOT optionElements EQUAL 76)
    message(FATAL_ERROR "Expected 38 native options")
endif()
foreach(index RANGE 0 74 2)
    math(EXPR valueIndex "${index}+1")
    list(GET options ${index} option)
    list(GET options ${valueIndex} default)
    string(FIND "${help}" "  ${option} ${default}\n" found)
    if(found LESS 0)
        message(FATAL_ERROR "Missing exact help default ${option}")
    endif()
    string(SUBSTRING "${option}" 2 -1 name)
    invoke("${name}-overflow" 2 ${base} "${option}" 18446744073709551616)
    invoke("${name}-sign" 2 ${base} "${option}" +1)
    invoke("${name}-suffix" 2 ${base} "${option}" 1x)
    execute_process(COMMAND "${PROGRAM}" ${base} "${option}" 0 RESULT_VARIABLE zeroStatus
        OUTPUT_VARIABLE zeroOutput ERROR_VARIABLE zeroDiagnostic TIMEOUT 30)
    if(NOT zeroStatus EQUAL 3 AND NOT zeroStatus EQUAL 6)
        message(FATAL_ERROR "${option}: zero was not accepted (${zeroStatus})")
    endif()
endforeach()
invoke(text-sum-overflow 6 ${base} --max-descriptor-units 18446744073709551615)

if(NOT JSON_ENABLED)
    invoke(loader-disabled 4 --input missing --output missing-output --schema missing.json --tape-mode raw-message-v1)
    if(NOT lastDiagnostic MATCHES "LOADER_DISABLED")
        message(FATAL_ERROR "Loader availability must precede source I/O")
    endif()
else()
    set(overlong "${ROOT}/tests/fixtures/protocol/tape-write/contracts/overlong-int.qtp")
    set(overlongOutput "${RUN}/overlong-normalized.qtp")
    if(EXISTS "${overlongOutput}")
        file(REMOVE "${overlongOutput}")
    endif()
    invoke(overlong-compact-int 0 --input "${overlong}" --output "${overlongOutput}"
        --schema "${ROOT}/tests/fixtures/protocol/tape-write/contracts/schema.json" --tape-mode raw-message-v1)
    file(READ "${overlong}" overlongHex HEX)
    string(SUBSTRING "${overlongHex}" 0 96 descriptorHex)
    file(READ "${overlongOutput}" normalizedHex HEX)
    if(NOT normalizedHex STREQUAL "${descriptorHex}09022505456d70747900010500")
        message(FATAL_ERROR "Overlong compact-int signed-low32 semantics were not normalized")
    endif()
endif()

set(corpus "${ROOT}/tests/conformance/protocol/tape-write/writer-evidence/inputs")
if(JSON_ENABLED)
    file(WRITE "${RUN}/all-types.json" "{\"formatVersion\":1,\"profile\":{\"id\":\"qdcxx-native\",\"version\":1},\"records\":[{\"id\":0,\"name\":\"AllTypes\",\"hasTime\":false,\"fields\":[{\"serialTypeId\":2},{\"serialTypeId\":8},{\"serialTypeId\":10},{\"serialTypeId\":40},{\"serialTypeId\":56},{\"serialTypeId\":72},{\"serialTypeId\":88},{\"serialTypeId\":120}],\"lookups\":[{\"name\":\"OutgoingChar\",\"fieldId\":0},{\"name\":\"OutgoingCount\",\"fieldId\":1},{\"name\":\"OutgoingText\",\"fieldId\":2},{\"name\":\"OutgoingShort\",\"fieldId\":3},{\"name\":\"OutgoingSeconds\",\"fieldId\":4},{\"name\":\"OutgoingSequence\",\"fieldId\":5},{\"name\":\"OutgoingDate\",\"fieldId\":6},{\"name\":\"OutgoingWide\",\"fieldId\":7}]}]}")
    file(WRITE "${RUN}/empty-schema.json" "{\"formatVersion\":1,\"profile\":{\"id\":\"qdcxx-native\",\"version\":1},\"records\":[]}")
    foreach(case all-types contract descriptor-opaque)
        if(case STREQUAL "contract")
            set(schema "${ROOT}/tests/fixtures/protocol/tape-write/contracts/schema.json")
        elseif(case STREQUAL "all-types")
            set(schema "${RUN}/all-types.json")
        else()
            set(schema "${RUN}/empty-schema.json")
        endif()
        set(destination "${RUN}/${case}.qtp")
        if(EXISTS "${destination}")
            file(REMOVE "${destination}")
        endif()
        invoke("${case}-rewrite" 0 --input "${corpus}/${case}/tape.qtp" --output "${destination}"
            --schema "${schema}" --tape-mode raw-message-v1)
        file(SHA256 "${corpus}/${case}/tape.qtp" before)
        file(SHA256 "${destination}" after)
        if(NOT before STREQUAL after)
            message(FATAL_ERROR "Already canonical native ${case} actions changed")
        endif()
    endforeach()
endif()
foreach(event quote profile)
    set(source "${corpus}/standard-${event}/tape.qtp")
    set(destination "${RUN}/standard-${event}.qtp")
    if(EXISTS "${destination}")
        file(REMOVE "${destination}")
    endif()
    file(SHA256 "${source}" before)
    invoke("${event}-rewrite" 0 --input "${source}" --output "${destination}"
        --tape-mode raw-message-v1 --profile "default-${event}-v1")
    if(NOT lastOutput STREQUAL "" OR NOT lastDiagnostic STREQUAL "" OR NOT EXISTS "${destination}")
        message(FATAL_ERROR "Successful rewrite must publish silently")
    endif()
    file(SHA256 "${source}" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Input changed")
    endif()
    file(SHA256 "${destination}" oldOutput)
    invoke("${event}-existing" 3 --input "${source}" --output "${destination}"
        --tape-mode raw-message-v1 --profile "default-${event}-v1")
    file(SHA256 "${destination}" oldOutputAfter)
    if(NOT oldOutput STREQUAL oldOutputAfter)
        message(FATAL_ERROR "Existing output changed")
    endif()
    invoke("${event}-same-path" 3 --input "${source}" --output "${source}"
        --tape-mode raw-message-v1 --profile "default-${event}-v1")
    invoke("${event}-input-limit" 6 --input "${source}" --output "${RUN}/${event}-limit.qtp"
        --tape-mode raw-message-v1 --profile "default-${event}-v1" --max-input-bytes 0)
    invoke("${event}-output-limit" 6 --input "${source}" --output "${RUN}/${event}-output-limit.qtp"
        --tape-mode raw-message-v1 --profile "default-${event}-v1" --max-output-bytes 0)
endforeach()
if(JSON_ENABLED AND DEFINED ADMISSION_PRODUCER)
    file(MAKE_DIRECTORY "${RUN}/description-heavy")
    execute_process(COMMAND "${ADMISSION_PRODUCER}" "${ROOT}/tests/fixtures/protocol/tape-write/contracts"
        "${RUN}/description-heavy" RESULT_VARIABLE producerStatus OUTPUT_VARIABLE producerOutput
        ERROR_VARIABLE producerError TIMEOUT 30)
    file(WRITE "${RUN}/description-heavy-producer.stdout" "${producerOutput}")
    file(WRITE "${RUN}/description-heavy-producer.stderr" "${producerError}")
    if(NOT producerStatus EQUAL 0 OR NOT producerOutput MATCHES "description-heavy-peak-units\t([0-9]+)")
        message(FATAL_ERROR "Description-heavy producer failed or omitted measured peak")
    endif()
    set(peak "${CMAKE_MATCH_1}")
    math(EXPR below "${peak}-1")
    math(EXPR above "${peak}+1")
    set(source "${RUN}/description-heavy/description-heavy.qtp")
    set(schema "${RUN}/description-heavy/description-heavy.json")
    file(SHA256 "${source}" beforeHeavy)
    foreach(boundary 0 ${below} ${peak} ${above})
        if(boundary LESS peak)
            set(expected 6)
        else()
            set(expected 0)
        endif()
        set(destination "${RUN}/description-heavy-${boundary}.qtp")
        if(EXISTS "${destination}")
            file(REMOVE "${destination}")
        endif()
        invoke("description-heavy-${boundary}" ${expected} --input "${source}" --output "${destination}"
            --schema "${schema}" --tape-mode raw-message-v1 --max-admission-scratch-units "${boundary}")
        if(expected EQUAL 6 AND EXISTS "${destination}")
            message(FATAL_ERROR "Rejected description-heavy admission published output")
        endif()
        file(SHA256 "${source}" afterHeavy)
        if(NOT beforeHeavy STREQUAL afterHeavy)
            message(FATAL_ERROR "Description-heavy input changed")
        endif()
    endforeach()
endif()
