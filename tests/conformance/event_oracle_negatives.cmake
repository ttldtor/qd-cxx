file(MAKE_DIRECTORY "${RUN}")
file(COPY "${FIXTURE}/" DESTINATION "${RUN}/expected")
set(observation "${RUN}/expected/default/observations.tsv")
file(READ "${observation}" baseline)
file(SHA256 "${FIXTURE}/default/observations.tsv" original_hash)
foreach(kind quote profile flags string time tag sequence nano default representation unknown duplicate trailing)
    set(case default)
    if(kind STREQUAL sequence OR kind STREQUAL nano)
        set(case both)
    elseif(kind STREQUAL default)
        set(case minimal)
    elseif(kind STREQUAL representation)
        set(case numeric-int)
    endif()
    set(observation "${RUN}/expected/${case}/observations.tsv")
    file(READ "${FIXTURE}/${case}/observations.tsv" baseline)
    set(changed "${baseline}")
    if(kind STREQUAL unknown)
        string(REPLACE "complete\t" "unknown\t0\ncomplete\t" changed "${baseline}")
    elseif(kind STREQUAL duplicate)
        string(APPEND changed "${baseline}")
    elseif(kind STREQUAL trailing)
        string(APPEND changed "complete\tduplicate\n")
    elseif(kind STREQUAL tag)
        string(REPLACE "\t120\t" "\t8\t" changed "${baseline}")
    else()
        string(REPLACE "\n" ";" rows "${baseline}")
        set(changed "")
        set(done FALSE)
        foreach(row IN LISTS rows)
            if(NOT done AND (((kind STREQUAL quote OR kind STREQUAL sequence OR kind STREQUAL nano) AND row MATCHES "^quote\tQuote-stream-read\t0\t") OR
                (NOT kind STREQUAL quote AND NOT kind STREQUAL sequence AND NOT kind STREQUAL nano AND row MATCHES "^profile\tProfile-stream-read\t0\t")))
                string(REPLACE "\t" ";" cells "${row}")
                if(kind STREQUAL sequence OR kind STREQUAL nano)
                    if(kind STREQUAL sequence)
                        set(index 13)
                    else()
                        set(index 14)
                    endif()
                    set(value 1)
                elseif(kind STREQUAL flags)
                    set(index 17)
                    set(value 0)
                elseif(kind STREQUAL string)
                    set(index 18)
                    set(value null)
                elseif(kind STREQUAL time)
                    set(index 22)
                    set(value 1)
                else()
                    if(kind STREQUAL quote)
                        set(index 6)
                    else()
                        set(index 4)
                    endif()
                    set(value 3fe0000000000000)
                endif()
                list(REMOVE_AT cells ${index})
                list(INSERT cells ${index} "${value}")
                list(JOIN cells "\t" row)
                set(done TRUE)
            endif()
            if(NOT row STREQUAL "")
                string(APPEND changed "${row}\n")
            endif()
        endforeach()
        if(NOT done)
            message(FATAL_ERROR "Mutation target absent: ${kind}")
        endif()
    endif()
    if(changed STREQUAL baseline)
        message(FATAL_ERROR "No mutation: ${kind}")
    endif()
    file(WRITE "${observation}" "${changed}")
    execute_process(COMMAND "${PROGRAM}" "${RUN}/expected" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${RUN}/${kind}.log" "${output}${error}")
    if(result EQUAL 0)
        message(FATAL_ERROR "Accepted mutated event evidence: ${kind}")
    endif()
    file(WRITE "${observation}" "${baseline}")
endforeach()
execute_process(COMMAND "${PROGRAM}" "${FIXTURE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${RUN}/baseline.log" "${output}${error}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Unchanged event evidence failed")
endif()
file(SHA256 "${FIXTURE}/default/observations.tsv" final_hash)
if(NOT original_hash STREQUAL final_hash)
    message(FATAL_ERROR "Source expectation changed")
endif()
