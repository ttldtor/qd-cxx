cmake_minimum_required(VERSION 3.25)

foreach(required PROGRAM CHECKER FIXTURES RUN_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT EXISTS "${PROGRAM}" OR NOT EXISTS "${CHECKER}")
    message(FATAL_ERROR "Harness executable missing")
endif()
file(MAKE_DIRECTORY "${RUN_DIR}")

# Bracket arguments preserve empty strings, semicolons, quotes and Unicode exactly.
# JSON is used only to adapt the immutable fixture manifest, never to derive observations.
function(inspection_quote output value)
    set(equal "=")
    while("${value}" MATCHES "]${equal}]")
        string(APPEND equal "=")
    endwhile()
    set(${output} "[${equal}[${value}]${equal}]" PARENT_SCOPE)
endfunction()

function(inspection_arg output value)
    inspection_quote(quoted "${value}")
    set(${output} "${${output}} ${quoted}" PARENT_SCOPE)
endfunction()

function(inspection_run arguments)
    inspection_quote(program "${PROGRAM}")
    inspection_quote(out "${RUN_DIR}/actual.out")
    inspection_quote(err "${RUN_DIR}/actual.err")
    cmake_language(EVAL CODE "execute_process(COMMAND ${program} ${arguments} OUTPUT_FILE ${out} ERROR_FILE ${err} RESULT_VARIABLE result TIMEOUT 30)")
    if(NOT "${result}" MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Harness launch/timeout failure: ${result}")
    endif()
    set(code "${result}" PARENT_SCOPE)
endfunction()

function(inspection_check)
    inspection_quote(checker "${CHECKER}")
    set(arguments "")
    math(EXPR last "${ARGC}-1")
    foreach(i RANGE 0 ${last})
        inspection_arg(arguments "${ARGV${i}}")
    endforeach()
    cmake_language(EVAL CODE "execute_process(COMMAND ${checker} ${arguments} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)")
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Comparator rejected (${ARGV}): ${result}\n${output}${error}")
    endif()
endfunction()

# CMake WRITE uses text mode on Windows. Hex transports only decoded JSON expectation
# bytes to a binary writer; actual stdout/stderr are always compared untouched.
function(inspection_write path content)
    string(HEX "${content}" encoded)
    file(WRITE "${path}.hex" "${encoded}")
    inspection_check(materialize "${path}.hex" "${path}")
endfunction()

function(inspection_manifest path format)
    file(SIZE "${path}" bytes)
    if(bytes GREATER 4194304)
        message(FATAL_ERROR "Manifest exceeds 4 MiB adapter budget")
    endif()
    file(READ "${path}" document)
    string(JSON actual GET "${document}" format)
    string(JSON count LENGTH "${document}" cases)
    if(NOT actual STREQUAL format OR count LESS 1 OR count GREATER 1000)
        message(FATAL_ERROR "manifest-selection: invalid format or empty/oversized cases")
    endif()
    set(names)
    math(EXPR last "${count}-1")
    foreach(i RANGE 0 ${last})
        foreach(field name input stdout stderr)
            string(JSON type TYPE "${document}" cases ${i} ${field})
            if(NOT type STREQUAL "STRING")
                message(FATAL_ERROR "Manifest ${field} must be a string")
            endif()
        endforeach()
        string(JSON name GET "${document}" cases ${i} name)
        if(name IN_LIST names)
            message(FATAL_ERROR "Duplicate case: ${name}")
        endif()
        list(APPEND names "${name}")
        string(JSON type TYPE "${document}" cases ${i} exit)
        string(JSON exit GET "${document}" cases ${i} exit)
        if(NOT type STREQUAL "NUMBER" OR NOT exit MATCHES "^[0-9]+$")
            message(FATAL_ERROR "Manifest exit must be a nonnegative integer")
        endif()
        string(JSON type TYPE "${document}" cases ${i} args)
        string(JSON args LENGTH "${document}" cases ${i} args)
        if(NOT type STREQUAL "ARRAY" OR args GREATER 100)
            message(FATAL_ERROR "Manifest arguments exceed adapter contract")
        endif()
    endforeach()
    set(document "${document}" PARENT_SCOPE)
    set(caseCount "${count}" PARENT_SCOPE)
endfunction()

function(inspection_case index mode)
    foreach(field name input stdout stderr exit)
        string(JSON ${field} GET "${document}" cases ${index} ${field})
    endforeach()
    set(path "${FIXTURES}/${input}")
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Missing fixture: ${path}")
    endif()
    set(arguments "")
    inspection_arg(arguments --profile)
    inspection_arg(arguments oracle-sre-v1)
    inspection_arg(arguments --input)
    inspection_arg(arguments "${path}")
    if(mode STREQUAL "human")
        inspection_arg(arguments --output-format)
        inspection_arg(arguments human)
    endif()
    set(base "${arguments}")
    string(JSON argsCount LENGTH "${document}" cases ${index} args)
    set(tail "")
    if(argsCount GREATER 0)
        math(EXPR end "${argsCount}-1")
        foreach(a RANGE 0 ${end})
            string(JSON type TYPE "${document}" cases ${index} args ${a})
            if(NOT type STREQUAL "STRING")
                message(FATAL_ERROR "Manifest operand must be a string")
            endif()
            string(JSON value GET "${document}" cases ${index} args ${a})
            inspection_arg(tail "${value}")
        endforeach()
    endif()
    inspection_write("${RUN_DIR}/expected.out" "${stdout}")
    inspection_write("${RUN_DIR}/expected.err" "${stderr}")
    if(mode STREQUAL "tsv")
        inspection_check(validate "${mode}" "${exit}" "${RUN_DIR}/expected.out" "${RUN_DIR}/expected.err")
    endif()
    file(SIZE "${path}" length)
    math(EXPR larger "${length}+1")
    set(sizes 1 2 3 7 16 4096 ${larger})
    list(REMOVE_DUPLICATES sizes)
    list(SORT sizes COMPARE NATURAL)
    if(QUICK)
        set(sizes 4096)
    endif()
    if(PREPARE_ONLY)
        set(sizes)
    endif()
    foreach(size IN LISTS sizes)
        set(arguments "${base}")
        inspection_arg(arguments --chunk-size)
        inspection_arg(arguments "${size}")
        inspection_run("${arguments} ${tail}")
        inspection_exact("${mode}" "${exit}")
    endforeach()
    if(NOT PREPARE_ONLY)
        message(STATUS "case ${mode}/${name}: chunks=${sizes}; exit=${exit}")
    endif()
    foreach(value name path stdout stderr exit base tail argsCount sizes)
        set(${value} "${${value}}" PARENT_SCOPE)
    endforeach()
endfunction()

function(inspection_exact mode expectedCode)
    if(NOT "${code}" STREQUAL "${expectedCode}")
        message(FATAL_ERROR "Exit mismatch: ${code}, expected ${expectedCode}")
    endif()
    inspection_check(exact "${mode}" "${code}" "${RUN_DIR}/actual.out" "${RUN_DIR}/actual.err" "${RUN_DIR}/expected.out" "${RUN_DIR}/expected.err")
endfunction()

function(inspection_hashes output root)
    file(GLOB_RECURSE paths LIST_DIRECTORIES false "${root}/*")
    list(SORT paths)
    set(hashes "")
    foreach(path IN LISTS paths)
        file(SHA256 "${path}" digest)
        string(APPEND hashes "${path}\t${digest}\n")
    endforeach()
    set(${output} "${hashes}" PARENT_SCOPE)
endfunction()

function(inspection_usage arguments)
    inspection_run("${arguments}")
    inspection_write("${RUN_DIR}/expected.out" "")
    inspection_write("${RUN_DIR}/expected.err" "incomplete\t2\tusage\t-\t-\t-\t-\t-\t-\t-\t-\n")
    inspection_exact(tsv 2)
endfunction()
