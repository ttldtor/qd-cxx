include("${CMAKE_CURRENT_LIST_DIR}/inspection_cli_common.cmake")
inspection_hashes(before "${FIXTURES}")
inspection_manifest("${FIXTURES}/designed.json" qdcxx-human-designed-v1)
math(EXPR last "${caseCount}-1")
foreach(i RANGE 0 ${last})
    inspection_case(${i} human)
    if(exit EQUAL 0 AND argsCount EQUAL 0)
        string(LENGTH "${stdout}" bytes)
        set(arguments "${base} [=[--max-output]=]")
        inspection_arg(arguments "${bytes}")
        inspection_run("${arguments}")
        inspection_exact(human 0)
        set(prefix 0)
        set(remaining "${stdout}")
        while(NOT remaining STREQUAL "")
            string(FIND "${remaining}" "\n" end)
            if(end LESS 0)
                message(FATAL_ERROR "Expected human row has no LF")
            endif()
            math(EXPR rowBytes "${end}+1")
            math(EXPR almost "${prefix}+${rowBytes}-1")
            set(limits ${prefix} ${almost})
            list(REMOVE_DUPLICATES limits)
            foreach(limit IN LISTS limits)
                inspection_run("${base} [=[--max-output]=] [=[${limit}]=]")
                if(NOT code EQUAL 6)
                    message(FATAL_ERROR "Human row budget exit: ${name}/${limit}: ${code}")
                endif()
                string(SUBSTRING "${stdout}" 0 ${prefix} expectedPrefix)
                inspection_write("${RUN_DIR}/prefix.out" "${expectedPrefix}")
                inspection_check(bytes "${RUN_DIR}/actual.out" "${RUN_DIR}/prefix.out")
                inspection_check(validate human 6 "${RUN_DIR}/actual.out" "${RUN_DIR}/actual.err")
                file(READ "${RUN_DIR}/actual.err" error)
                if(NOT error MATCHES "^incomplete\t6\twrite\t")
                    message(FATAL_ERROR "Human budget diagnostic reason")
                endif()
            endforeach()
            math(EXPR prefix "${prefix}+${rowBytes}")
            string(SUBSTRING "${remaining}" ${rowBytes} -1 remaining)
        endwhile()
        message(STATUS "human output budget: ${name}=${bytes}")
    endif()
endforeach()
set(humanCount "${caseCount}")
set(humanRoot "${FIXTURES}")
get_filename_component(parent "${FIXTURES}" DIRECTORY)
set(FIXTURES "${parent}/offline-inspection")
inspection_hashes(legacyBefore "${FIXTURES}")
inspection_manifest("${FIXTURES}/designed.json" qdcxx-offline-designed-v1)
math(EXPR last "${caseCount}-1")
foreach(i RANGE 0 ${last})
    # Populate the independent expectation and argument adapter without an extra full schedule.
    set(PREPARE_ONLY TRUE)
    inspection_case(${i} tsv)
    unset(PREPARE_ONLY)
    foreach(size IN ITEMS 1 7 4096)
        foreach(format IN ITEMS "" "[=[--output-format]=] [=[tsv]=]")
            inspection_run("${base} ${tail} [=[--chunk-size]=] [=[${size}]=] ${format}")
            inspection_exact(tsv "${exit}")
        endforeach()
    endforeach()
    message(STATUS "legacy TSV/${name}: chunks=1,7,4096; default+explicit; exit=${exit}")
endforeach()
set(base "[=[--profile]=] [=[oracle-sre-v1]=] [=[--input]=]")
inspection_arg(base "${FIXTURES}/expected/composed.qtp")
inspection_run("${base}")
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Legacy composed default exit")
endif()
inspection_check(validate tsv 0 "${RUN_DIR}/actual.out" "${RUN_DIR}/actual.err")
file(COPY_FILE "${RUN_DIR}/actual.out" "${RUN_DIR}/expected.out")
file(WRITE "${RUN_DIR}/expected.err" "")
inspection_run("${base} [=[--output-format]=] [=[tsv]=]")
inspection_exact(tsv 0)
foreach(tail IN ITEMS "[=[--output-format]=]" "[=[--output-format]=] [=[]=]" "[=[--output-format]=] [=[auto]=]"
    "[=[--output-format]=] [=[HUMAN]=]" "[=[--output-format]=] [=[human]=] [=[--output-format]=] [=[tsv]=]"
    "[=[--output-format]=] [=[tsv]=] [=[--output-format]=] [=[tsv]=]" "[=[--output-format=human]=]")
    inspection_usage("${base} ${tail}")
endforeach()
inspection_run("[=[--help]=]")
file(READ "${RUN_DIR}/actual.out" help)
if(NOT code EQUAL 0 OR NOT help MATCHES "--output-format tsv\\|human" OR NOT help MATCHES "not QD tape")
    message(FATAL_ERROR "Human help contract")
endif()
inspection_hashes(legacyAfter "${FIXTURES}")
inspection_hashes(after "${humanRoot}")
if(NOT before STREQUAL after OR NOT legacyBefore STREQUAL legacyAfter)
    message(FATAL_ERROR "Read-only fixtures changed")
endif()
message(STATUS "human: ${humanCount} cases, row budgets and ${caseCount} legacy cases passed; fixtures unchanged")
