# Exercise the C++ fixture reader against changed evidence without rewriting originals.
file(MAKE_DIRECTORY "${RUN}")
file(READ "${FIXTURE}" baseline)
foreach(mutation IN ITEMS bytes units null-empty raw tag consumed unknown columns duplicate missing early-complete duplicate-complete)
    set(changed "${baseline}")
    if(mutation STREQUAL bytes)
        string(REPLACE "0041\t0141" "0041\t0142" changed "${changed}")
    elseif(mutation STREQUAL units)
        string(REPLACE "0041\t0141" "0042\t0141" changed "${changed}")
    elseif(mutation STREQUAL null-empty)
        string(REPLACE "value-0\tnull\t7f" "value-0\t-\t7f" changed "${changed}")
    elseif(mutation STREQUAL raw)
        string(REGEX REPLACE "(int-read\t40\t[^\n]*\t)[0-9-]+(\tok\t)" "\\1123456\\2" changed "${changed}")
    elseif(mutation STREQUAL tag)
        string(REPLACE "int-read\t40\t" "int-read\t41\t" changed "${changed}")
    elseif(mutation STREQUAL consumed)
        string(REPLACE "EOFException\t0" "EOFException\t1" changed "${changed}")
    elseif(mutation STREQUAL unknown)
        string(REPLACE "string-write\t" "unknown\t" changed "${changed}")
    elseif(mutation STREQUAL columns)
        string(REPLACE "string-write\t" "string-write\textra\t" changed "${changed}")
    elseif(mutation STREQUAL duplicate)
        string(REPLACE "string-write\tvalue-0\tnull\t7f\n" "string-write\tvalue-0\tnull\t7f\nstring-write\tvalue-0\tnull\t7f\n" changed "${changed}")
    elseif(mutation STREQUAL missing)
        string(REPLACE "string-write\tvalue-0\tnull\t7f\n" "" changed "${changed}")
    elseif(mutation STREQUAL early-complete)
        string(REPLACE "case\tprimitives\n" "case\tprimitives\ncomplete\tprimitives\n" changed "${changed}")
    else()
        string(APPEND changed "complete\tprimitives\n")
    endif()
    if(changed STREQUAL baseline)
        message(FATAL_ERROR "ineffective primitive mutation: ${mutation}")
    endif()
    file(WRITE "${RUN}/${mutation}.tsv" "${changed}")
    execute_process(COMMAND "${PROGRAM}" "${RUN}/${mutation}.tsv" RESULT_VARIABLE code OUTPUT_FILE "${RUN}/${mutation}.log" ERROR_VARIABLE error)
    if(code EQUAL 0)
        message(FATAL_ERROR "accepted primitive mutation: ${mutation}")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" "${FIXTURE}" RESULT_VARIABLE code OUTPUT_FILE "${RUN}/baseline.log" ERROR_VARIABLE error)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "primitive baseline after mutations: ${error}")
endif()
