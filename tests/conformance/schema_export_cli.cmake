# Exercise the actual exporter output through the existing external-schema CLI.
set(fixtures "${ROOT}/tests/fixtures/schema/export/expected")
foreach(scenario IN ITEMS custom set-before)
    foreach(mode IN ITEMS stream raw)
        if(scenario STREQUAL custom)
            set(tapes "${mode}.qtp")
        else()
            set(tapes "Quote-${mode}.qtp" "Profile-${mode}.qtp")
        endif()
        set(mode_args)
        if(mode STREQUAL raw)
            set(mode_args --tape-mode raw-message-v1)
        endif()
        foreach(tape IN LISTS tapes)
            foreach(format IN ITEMS tsv human)
                set(baseline "")
                foreach(chunk IN ITEMS 65536 1)
                    execute_process(COMMAND "${PROGRAM}" --schema "${fixtures}/${scenario}/schema.json"
                        --input "${fixtures}/${scenario}/${tape}" --output-format "${format}"
                        --chunk-size "${chunk}" ${mode_args}
                        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
                    if(NOT code EQUAL 0 OR NOT error STREQUAL "" OR NOT output MATCHES "external-schema-v1")
                        message(FATAL_ERROR "Exported CLI failed ${scenario}/${tape}/${format}/${chunk}: ${code} ${error}")
                    endif()
                    if(chunk EQUAL 1 AND NOT baseline STREQUAL output)
                        message(FATAL_ERROR "Input chunk scheduling changed inspection")
                    endif()
                    set(baseline "${output}")
                    if(scenario STREQUAL custom AND (NOT output MATCHES "1234567890123" OR NOT output MATCHES "-7"))
                        message(FATAL_ERROR "Custom/extra values missing")
                    endif()
                endforeach()
            endforeach()
        endforeach()
    endforeach()
endforeach()
