include("${CMAKE_CURRENT_LIST_DIR}/inspection_cli_common.cmake")
# FIXTURES denotes the offline root; its sibling human root retains the original manifests.
inspection_hashes(before "${FIXTURES}")
get_filename_component(parent "${FIXTURES}" DIRECTORY)
set(humanRoot "${parent}/human-inspection")
inspection_hashes(humanBefore "${humanRoot}")
inspection_check(selftest)
set(offlineRoot "${FIXTURES}")
foreach(suite IN ITEMS offline human)
    if(suite STREQUAL "offline")
        set(FIXTURES "${offlineRoot}")
        set(target two-data)
        set(mode tsv)
    else()
        set(FIXTURES "${humanRoot}")
        set(target lone-high)
        set(mode human)
    endif()
    inspection_manifest("${FIXTURES}/designed.json" "qdcxx-${suite}-designed-v1")
    math(EXPR last "${caseCount}-1")
    set(found FALSE)
    foreach(i RANGE 0 ${last})
        string(JSON name GET "${document}" cases ${i} name)
        if(name STREQUAL target)
            set(QUICK TRUE)
            inspection_case(${i} "${mode}")
            unset(QUICK)
            file(COPY_FILE "${RUN_DIR}/actual.out" "${RUN_DIR}/${suite}.out")
            file(COPY_FILE "${RUN_DIR}/actual.err" "${RUN_DIR}/${suite}.err")
            set(found TRUE)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Mutation target missing")
    endif()
endforeach()
set(FIXTURES "${offlineRoot}")
set(arguments "[=[--profile]=] [=[oracle-sre-v1]=] [=[--input]=]")
inspection_arg(arguments "${FIXTURES}/expected/composed.qtp")
inspection_run("${arguments}")
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Mutation baseline process failed")
endif()
inspection_check(validate tsv 0 "${RUN_DIR}/actual.out" "${RUN_DIR}/actual.err")
file(COPY_FILE "${RUN_DIR}/actual.out" "${RUN_DIR}/java.out")
execute_process(COMMAND "${CHECKER}" mutations "${RUN_DIR}/offline.out" "${RUN_DIR}/offline.err"
    "${RUN_DIR}/human.out" "${RUN_DIR}/human.err" "${FIXTURES}/expected/offline-inspection.tsv"
    "${FIXTURES}/expected/composed.qtp" "${RUN_DIR}/java.out" "${RUN_DIR}/mutations"
    RESULT_VARIABLE result OUTPUT_VARIABLE proof ERROR_VARIABLE error TIMEOUT 30)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Mutation validation failure: ${result}\n${proof}${error}")
endif()
file(WRITE "${RUN_DIR}/empty-selection.json" "{\"format\":\"qdcxx-offline-designed-v1\",\"cases\":[]}")
file(SHA256 "${RUN_DIR}/empty-selection.json" emptyBefore)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DPROGRAM=${PROGRAM}" "-DCHECKER=${CHECKER}" "-DFIXTURES=${FIXTURES}"
    "-DRUN_DIR=${RUN_DIR}/empty-run" "-DMANIFEST=${RUN_DIR}/empty-selection.json" -DQUICK=ON
    -P "${CMAKE_CURRENT_LIST_DIR}/offline_cli.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT "${result}" STREQUAL "1" OR NOT error MATCHES "manifest-selection: invalid format or empty/oversized cases")
    message(FATAL_ERROR "Empty selection failed at wrong stage: ${result}\n${output}${error}")
endif()
file(SHA256 "${RUN_DIR}/empty-selection.json" emptyAfter)
if(NOT emptyBefore STREQUAL emptyAfter)
    message(FATAL_ERROR "Temporary empty selection changed")
endif()
string(APPEND proof "offline\tempty-selection\trejected at manifest-selection; temporary expectation unchanged\n")
# Exercise exit mismatch in the same adapter branch used by all process comparisons.
inspection_quote(common "${CMAKE_CURRENT_LIST_DIR}/inspection_cli_common.cmake")
file(WRITE "${RUN_DIR}/exit-negative.cmake" "include(${common})\nset(code 1)\ninspection_exact(tsv 0)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DPROGRAM=${PROGRAM}" "-DCHECKER=${CHECKER}" "-DFIXTURES=${FIXTURES}"
    "-DRUN_DIR=${RUN_DIR}/exit-run" -P "${RUN_DIR}/exit-negative.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT "${result}" STREQUAL "1" OR NOT error MATCHES "Exit mismatch: 1, expected 0")
    message(FATAL_ERROR "Exit mutation failed at wrong stage: ${result}\n${output}${error}")
endif()
string(APPEND proof "harness\texit-only\trejected at exact exit comparison\n")
# The restored complete baseline must still pass after all mutations.
execute_process(COMMAND "${CMAKE_COMMAND}" "-DPROGRAM=${PROGRAM}" "-DCHECKER=${CHECKER}" "-DFIXTURES=${FIXTURES}"
    "-DPROCESS_HELPER=${PROCESS_HELPER}"
    "-DRUN_DIR=${RUN_DIR}/restored" -P "${CMAKE_CURRENT_LIST_DIR}/offline_cli.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Restored full offline baseline failed: ${result}\n${output}${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DPROGRAM=${PROGRAM}" "-DCHECKER=${CHECKER}" "-DFIXTURES=${humanRoot}"
    "-DRUN_DIR=${RUN_DIR}/restored-human" -P "${CMAKE_CURRENT_LIST_DIR}/human_cli.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Restored full human baseline failed: ${result}\n${output}${error}")
endif()
inspection_hashes(after "${FIXTURES}")
inspection_hashes(humanAfter "${humanRoot}")
if(NOT before STREQUAL after OR NOT humanBefore STREQUAL humanAfter)
    message(FATAL_ERROR "Mutation run rewrote original fixtures")
endif()
file(WRITE "${RUN_DIR}/mutations.tsv" "suite\tlabel\tresult\n${proof}")
message(STATUS "${proof}")
