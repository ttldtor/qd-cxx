# Internal caller: CTest attachment_fixture_negatives. Inputs: PROGRAM, FIXTURE and owned RUN.
# Copies immutable fixtures, changes null to engaged-empty, and requires the consumer to reject it.
# Zero consumer exit, missing expected assertion or fixture-copy failure fails this check.
foreach(required PROGRAM FIXTURE RUN)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(MAKE_DIRECTORY "${RUN}")
file(COPY "${FIXTURE}/" DESTINATION "${RUN}")
file(READ "${RUN}/oracle.tsv" table)
set(original "event\tMessage-null\t109\tMessage\t249\tnull\t")
set(mutated "event\tMessage-null\t109\tMessage\t249\tempty\t")
string(FIND "${table}" "${original}" found)
if(found LESS 0)
    message(FATAL_ERROR "Expected null fixture row is missing")
endif()
string(REPLACE "${original}" "${mutated}" table "${table}")
file(WRITE "${RUN}/oracle.tsv" "${table}")
execute_process(COMMAND "${PROGRAM}" "${RUN}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result STREQUAL "0" OR NOT output MATCHES "fields.back\\(\\).bytes == expected")
    message(FATAL_ERROR "Null/empty mutation was not rejected by intended assertion: ${result}\n${output}\n${error}")
endif()
message(STATUS "Null/empty oracle mutation rejected by public generic consumer")
