cmake_minimum_required(VERSION 3.25)
foreach(required DRIVER PROBE ROOT RUN_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if((DEFINED REAL_UNCRUSTIFY AND NOT REAL_UNCRUSTIFY STREQUAL "" AND (NOT DEFINED REAL_CLANG_FORMAT OR REAL_CLANG_FORMAT STREQUAL ""))
    OR (DEFINED REAL_CLANG_FORMAT AND NOT REAL_CLANG_FORMAT STREQUAL "" AND (NOT DEFINED REAL_UNCRUSTIFY OR REAL_UNCRUSTIFY STREQUAL "")))
    message(FATAL_ERROR "Real formatter configuration requires both REAL_UNCRUSTIFY and REAL_CLANG_FORMAT")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef runToken)
set(RUN_DIR "${RUN_DIR}/run-${runToken} space;имя")
file(MAKE_DIRECTORY "${RUN_DIR}/repo/src/a" "${RUN_DIR}/repo/src/b" "${RUN_DIR}/repo/tools/dev"
    "${RUN_DIR}/repo/examples/subscriptions" "${RUN_DIR}/repo/tools/subscribe")
set(repo "${RUN_DIR}/repo")
file(COPY "${ROOT}/.clang-format" "${ROOT}/.uncrustify.cfg" DESTINATION "${repo}")
function(run expected mode)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${repo}" "-DUNCRUSTIFY=${uncrustify}"
        "-DCLANG_FORMAT=${clang}" "-DMODE=${mode}" "-DFILES=${RUN_DIR}/files.json" -P "${DRIVER}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(expected STREQUAL "pass" AND NOT result STREQUAL "0")
        message(FATAL_ERROR "Expected pass: ${result}\n${output}${error}")
    elseif(expected STREQUAL "fail" AND result STREQUAL "0")
        message(FATAL_ERROR "Expected rejection: ${output}${error}")
    endif()
    file(GLOB leftovers "${repo}/.work/format-portable-*")
    if(leftovers)
        message(FATAL_ERROR "Temporary files leaked: ${leftovers}")
    endif()
    message(STATUS "format case ${case}: ${expected}")
endfunction()
get_filename_component(extension "${PROBE}" EXT)
set(uncrustify "${RUN_DIR}/uncrustify${extension}")
set(clang "${RUN_DIR}/clang-format${extension}")
file(COPY_FILE "${PROBE}" "${uncrustify}")
file(COPY_FILE "${PROBE}" "${clang}")
file(WRITE "${uncrustify}.mode" "normal")
file(WRITE "${clang}.mode" "normal")
file(WRITE "${RUN_DIR}/files.json" "[\"src/a/same.cpp\",\"src/b/same.cpp\",\"src/space имя;name.cpp\",\"tools/dev/developer.hpp\",\"examples/subscriptions/example.cpp\",\"examples/subscriptions/example.hpp\",\"tools/subscribe/main.cpp\",\"tools/subscribe/main.hpp\"]")
foreach(path "src/a/same.cpp" "src/b/same.cpp" "src/space имя;name.cpp" "tools/dev/developer.hpp"
    "examples/subscriptions/example.cpp" "examples/subscriptions/example.hpp" "tools/subscribe/main.cpp" "tools/subscribe/main.hpp")
    file(WRITE "${repo}/${path}" "BAD ${path}\n")
endforeach()
set(case fake-pipeline)
run(pass Format)
foreach(path "src/a/same.cpp" "src/b/same.cpp" "src/space имя;name.cpp" "tools/dev/developer.hpp"
    "examples/subscriptions/example.cpp" "examples/subscriptions/example.hpp" "tools/subscribe/main.cpp" "tools/subscribe/main.hpp")
    file(READ "${repo}/${path}" contents)
    if(NOT contents STREQUAL "GOOD ${path}\n")
        message(FATAL_ERROR "Split, omitted or collided path: ${path}: ${contents}")
    endif()
endforeach()
set(case idempotence)
run(pass Format)
run(pass Check)
file(WRITE "${repo}/src/a/same.cpp" "BAD sentinel\n")
file(SHA256 "${repo}/src/a/same.cpp" original)
set(case readonly-mismatch)
run(fail Check)
file(SHA256 "${repo}/src/a/same.cpp" after)
if(NOT original STREQUAL after)
    message(FATAL_ERROR "Check modified input")
endif()
# Caller cache variables are not owned cleanup state, including after a local
# variable is cleared. Both early validation and late mismatch must preserve it.
set(callerTemp "${RUN_DIR}/caller-owned-temp")
set(cleanupFailures "")
foreach(failureMode Invalid Check)
    file(MAKE_DIRECTORY "${callerTemp}")
    file(WRITE "${callerTemp}/sentinel.txt" "caller-owned sentinel\n")
    file(SHA256 "${callerTemp}/sentinel.txt" sentinelBefore)
    file(SHA256 "${repo}/.clang-format" configBefore)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${repo}" "-DUNCRUSTIFY=${uncrustify}"
        "-DCLANG_FORMAT=${clang}" "-DMODE=${failureMode}" "-DFILES=${RUN_DIR}/files.json"
        "-DtempRoot=${callerTemp}" -P "${DRIVER}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT result STREQUAL "1")
        message(FATAL_ERROR "Expected rejection of caller-temp ${failureMode}: ${result}: ${output}${error}")
    endif()
    if(NOT EXISTS "${callerTemp}/sentinel.txt")
        string(APPEND cleanupFailures " ${failureMode}")
        message(STATUS "format caller-temp ${failureMode}: sentinel removed")
    else()
        file(SHA256 "${callerTemp}/sentinel.txt" sentinelAfter)
        if(NOT sentinelBefore STREQUAL sentinelAfter)
            string(APPEND cleanupFailures " ${failureMode}")
        endif()
        message(STATUS "format caller-temp ${failureMode}: sentinel preserved")
    endif()
    file(SHA256 "${repo}/src/a/same.cpp" after)
    file(SHA256 "${repo}/.clang-format" configAfter)
    if(NOT original STREQUAL after OR NOT configBefore STREQUAL configAfter)
        message(FATAL_ERROR "Caller-temp failure modified repository input")
    endif()
endforeach()
if(NOT cleanupFailures STREQUAL "")
    message(FATAL_ERROR "Cleanup removed caller-owned directory:${cleanupFailures}")
endif()
foreach(tool uncrustify clang)
    foreach(mode wrong-version version-nonzero warning error unknown invalid nonzero interrupted delete-output)
        set(case "${tool}-${mode}")
        file(WRITE "${${tool}}.mode" "${mode}")
        run(fail Format)
        file(SHA256 "${repo}/src/a/same.cpp" after)
        if(NOT original STREQUAL after)
            message(FATAL_ERROR "Failed pipeline published input")
        endif()
        file(WRITE "${${tool}}.mode" "normal")
    endforeach()
endforeach()
message(STATUS "Portable formatter core scenarios passed")

# Path validation must finish before the first formatter process is started.
file(WRITE "${repo}/src/keep.cpp" "GOOD protected\n")
file(WRITE "${repo}/outside.cpp" "BAD protected\n")
file(MAKE_DIRECTORY "${repo}/src/generated" "${repo}/src/fixtures" "${repo}/src/upstream")
foreach(directory generated fixtures upstream)
    file(WRITE "${repo}/src/${directory}/protected.cpp" "BAD protected\n")
endforeach()
set(newExcludedPaths "examples/other/protected.cpp" "tools/other/protected.hpp"
    "examples/subscriptions/generated/protected.cpp" "tools/subscribe/fixtures/protected.hpp"
    "tools/subscribe/upstream/protected.cpp")
foreach(path IN LISTS newExcludedPaths)
    get_filename_component(directory "${repo}/${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(WRITE "${repo}/${path}" "BAD protected\n")
endforeach()
set(paths "[\"../outside.cpp\",\"outside.cpp\",\"src/keep.txt\",\"src/generated/protected.cpp\",\"src/fixtures/protected.cpp\",\"src/upstream/protected.cpp\",\"src/missing.cpp\",\"src/line\\nname.cpp\",\"src/line\\rname.cpp\",\"examples/other/protected.cpp\",\"tools/other/protected.hpp\",\"examples/subscriptions/generated/protected.cpp\",\"tools/subscribe/fixtures/protected.hpp\",\"tools/subscribe/upstream/protected.cpp\"]")
string(JSON pathCount LENGTH "${paths}")
math(EXPR pathLast "${pathCount}-1")
foreach(i RANGE 0 ${pathLast})
    string(JSON path GET "${paths}" ${i})
    # Preserve escaped JSON spelling for controls without list conversion.
    string(REPLACE "\\" "\\\\" escaped "${path}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    file(WRITE "${RUN_DIR}/files.json" "[\"src/keep.cpp\",\"${escaped}\"]")
    file(SHA256 "${uncrustify}.calls" beforeCalls)
    set(case "path-rejection-${i}")
    run(fail Format)
    file(SHA256 "${uncrustify}.calls" afterCalls)
    if(NOT beforeCalls STREQUAL afterCalls)
        message(FATAL_ERROR "Rejected inventory invoked formatter: ${i}")
    endif()
endforeach()
foreach(manifest "{}" "[]" "[1]" "[" "[\"src/keep.cpp\",null]")
    file(WRITE "${RUN_DIR}/files.json" "${manifest}")
    set(case invalid-manifest)
    run(fail Format)
endforeach()
file(WRITE "${RUN_DIR}/files.json" "[\"src/keep.cpp\"]")
foreach(config .clang-format .uncrustify.cfg)
    file(RENAME "${repo}/${config}" "${repo}/${config}.saved")
    set(case "missing-${config}")
    run(fail Format)
    file(RENAME "${repo}/${config}.saved" "${repo}/${config}")
endforeach()
set(savedUncrustify "${uncrustify}")
set(uncrustify "${RUN_DIR}/absent-tool")
set(case missing-tool)
run(fail Format)
set(uncrustify "${savedUncrustify}")
set(case invalid-mode)
run(fail Invalid)

# Directory symlinks on Windows use junctions, which do not require Developer Mode.
# Linux checks both source-file links and executable links in addition to directories.
file(MAKE_DIRECTORY "${RUN_DIR}/external")
file(WRITE "${RUN_DIR}/external/protected.cpp" "BAD external sentinel\n")
file(SHA256 "${RUN_DIR}/external/protected.cpp" externalBefore)
if(WIN32)
    file(TO_NATIVE_PATH "${repo}/src/escape" aliasNative)
    file(TO_NATIVE_PATH "${RUN_DIR}/external" targetNative)
    execute_process(COMMAND cmd /c mklink /J "${aliasNative}" "${targetNative}"
        RESULT_VARIABLE linked OUTPUT_QUIET ERROR_VARIABLE linkError)
else()
    file(CREATE_LINK "${RUN_DIR}/external" "${repo}/src/escape" SYMBOLIC RESULT linked)
endif()
if(NOT linked STREQUAL "0")
    message(FATAL_ERROR "Cannot establish required source alias control: ${linkError}${linked}")
endif()
file(WRITE "${RUN_DIR}/files.json" "[\"src/escape/protected.cpp\"]")
set(case resolved-external-source)
run(fail Format)
if(WIN32)
    file(TO_NATIVE_PATH "${repo}/src/protected-alias" aliasNative)
    file(TO_NATIVE_PATH "${repo}/src/generated" targetNative)
    execute_process(COMMAND cmd /c mklink /J "${aliasNative}" "${targetNative}"
        RESULT_VARIABLE linked OUTPUT_QUIET ERROR_VARIABLE linkError)
else()
    file(CREATE_LINK "${repo}/src/generated" "${repo}/src/protected-alias" SYMBOLIC RESULT linked)
endif()
if(NOT linked STREQUAL "0")
    message(FATAL_ERROR "Cannot establish protected alias control: ${linkError}${linked}")
endif()
file(WRITE "${RUN_DIR}/files.json" "[\"src/protected-alias/protected.cpp\"]")
set(case resolved-protected-source)
run(fail Format)
if(NOT WIN32)
    file(CREATE_LINK "${uncrustify}" "${RUN_DIR}/formatter-link${extension}" SYMBOLIC RESULT linked)
    if(NOT linked STREQUAL "0")
        message(FATAL_ERROR "Cannot establish executable symlink: ${linked}")
    endif()
    set(uncrustify "${RUN_DIR}/formatter-link${extension}")
    file(WRITE "${RUN_DIR}/files.json" "[\"src/keep.cpp\"]")
    set(case executable-symlink)
    run(pass Check)
    set(uncrustify "${savedUncrustify}")
    file(CREATE_LINK "${RUN_DIR}/external/protected.cpp" "${repo}/src/file-alias.cpp" SYMBOLIC RESULT linked)
    if(NOT linked STREQUAL "0")
        message(FATAL_ERROR "Cannot establish source symlink: ${linked}")
    endif()
    file(WRITE "${RUN_DIR}/files.json" "[\"src/file-alias.cpp\"]")
    set(case resolved-file-source)
    run(fail Format)
    file(REMOVE "${repo}/src/file-alias.cpp")
else()
    message(STATUS "Windows file-symlink cases omitted; required junction controls executed")
endif()
file(SHA256 "${RUN_DIR}/external/protected.cpp" externalAfter)
if(NOT externalBefore STREQUAL externalAfter)
    message(FATAL_ERROR "Protected external source changed")
endif()

execute_process(COMMAND git init --quiet "${repo}" RESULT_VARIABLE initialized)
if(NOT initialized STREQUAL "0")
    message(FATAL_ERROR "Cannot initialize isolated discovery repository")
endif()
file(WRITE "${repo}/.gitignore" ".work/\nsrc/ignored.cpp\nsrc/escape/\nsrc/protected-alias/\n")
file(WRITE "${repo}/src/ignored.cpp" "BAD ignored\n")
if(NOT WIN32)
    file(WRITE "${repo}/src/tab\tname.cpp" "BAD tab\n")
endif()
# Quotes and tabs are valid POSIX filenames and exercise Git C-quoting.
if(NOT WIN32)
    file(WRITE "${repo}/src/quote\"name.cpp" "BAD quote\n")
endif()
function(discover expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${repo}" "-DUNCRUSTIFY=${uncrustify}"
        "-DCLANG_FORMAT=${clang}" -DMODE=Format -P "${DRIVER}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(expected STREQUAL "pass" AND NOT result STREQUAL "0")
        message(FATAL_ERROR "Discovery failed: ${output}${error}")
    elseif(expected STREQUAL "fail" AND result STREQUAL "0")
        message(FATAL_ERROR "Discovery accepted invalid filename inventory")
    endif()
    message(STATUS "format case ${case}: ${expected}")
endfunction()
set(case git-discovery)
discover(pass)
if(NOT WIN32)
    foreach(path "src/tab\tname.cpp" "src/quote\"name.cpp")
        file(READ "${repo}/${path}" contents)
        if(NOT contents MATCHES "^GOOD")
            message(FATAL_ERROR "Git quoted filename omitted: ${path}")
        endif()
    endforeach()
endif()
foreach(path "src/a/same.cpp" "src/b/same.cpp" "src/space имя;name.cpp" "tools/dev/developer.hpp"
    "examples/subscriptions/example.cpp" "examples/subscriptions/example.hpp" "tools/subscribe/main.cpp" "tools/subscribe/main.hpp")
    file(READ "${repo}/${path}" contents)
    if(contents MATCHES "BAD|U_DONE")
        message(FATAL_ERROR "Discovery omitted filename: ${path}")
    endif()
endforeach()
foreach(path "src/ignored.cpp" "src/generated/protected.cpp" "src/fixtures/protected.cpp" "src/upstream/protected.cpp" ${newExcludedPaths})
    file(READ "${repo}/${path}" contents)
    if(NOT contents MATCHES "BAD")
        message(FATAL_ERROR "Discovery formatted excluded filename: ${path}")
    endif()
endforeach()
if(NOT WIN32)
    foreach(control "\n" "\r")
        file(WRITE "${repo}/src/line${control}name.cpp" "BAD newline\n")
        file(SHA256 "${uncrustify}.calls" beforeCalls)
        set(case git-control-filename)
        discover(fail)
        file(SHA256 "${uncrustify}.calls" afterCalls)
        if(NOT beforeCalls STREQUAL afterCalls)
            message(FATAL_ERROR "Control filename rejection invoked formatter")
        endif()
        file(REMOVE "${repo}/src/line${control}name.cpp")
    endforeach()
endif()

if(NOT WIN32)
    file(WRITE "${repo}/src/back\\slash.cpp" "BAD backslash\n")
    file(SHA256 "${uncrustify}.calls" beforeCalls)
    set(case git-backslash-filename)
    discover(fail)
    file(SHA256 "${uncrustify}.calls" afterCalls)
    if(NOT beforeCalls STREQUAL afterCalls)
        message(FATAL_ERROR "Backslash filename rejection invoked formatter")
    endif()
endif()
if(DEFINED REAL_UNCRUSTIFY AND NOT REAL_UNCRUSTIFY STREQUAL "" AND DEFINED REAL_CLANG_FORMAT AND NOT REAL_CLANG_FORMAT STREQUAL "")
    set(uncrustify "${REAL_UNCRUSTIFY}")
    set(clang "${REAL_CLANG_FORMAT}")
    file(WRITE "${RUN_DIR}/files.json" "[\"src/real.cpp\"]")
    file(WRITE "${repo}/src/real.cpp" "#include \"aaa.hpp\"\n#include \"real.hpp\"\nint main(){int x=1;if(x){x++;}return x;}\n")
    file(SHA256 "${repo}/src/real.cpp" original)
    set(case real-readonly-mismatch)
    run(fail Check)
    file(SHA256 "${repo}/src/real.cpp" after)
    if(NOT original STREQUAL after)
        message(FATAL_ERROR "Real Check wrote source")
    endif()
    set(case real-format-check-idempotence)
    run(pass Format)
    file(READ "${repo}/src/real.cpp" formatted)
    if(NOT formatted MATCHES "^#include \\\"real.hpp\\\"")
        message(FATAL_ERROR "Source basename was lost: corresponding header is not first")
    endif()
    run(pass Check)
    file(SHA256 "${repo}/src/real.cpp" original)
    run(pass Format)
    file(SHA256 "${repo}/src/real.cpp" after)
    if(NOT original STREQUAL after)
        message(FATAL_ERROR "Real pipeline is not idempotent")
    endif()
endif()
message(STATUS "Portable formatter acceptance passed")




if(NOT MUTATION_CHILD)
    foreach(tool REAL_UNCRUSTIFY REAL_CLANG_FORMAT)
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DDRIVER=${DRIVER}" "-DPROBE=${PROBE}" "-DROOT=${ROOT}"
            "-DRUN_DIR=${RUN_DIR}/partial-tools" "-D${tool}=absent" -DMUTATION_CHILD=ON -P "${CMAKE_CURRENT_LIST_FILE}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
        if(result STREQUAL "0" OR NOT "${error}" MATCHES "requires both")
            message(FATAL_ERROR "Partial real formatter configuration was not rejected")
        endif()
        message(STATUS "format case partial-${tool}: fail")
    endforeach()
    file(READ "${DRIVER}" originalDriver)
    foreach(mutation check-writes wrong-pipeline ignored-version ignored-diagnostic unsafe-protected)
        set(mutated "${originalDriver}")
        if(mutation STREQUAL "check-writes")
            string(REPLACE "if(MODE STREQUAL \"Format\")" "if(TRUE)" mutated "${mutated}")
        elseif(mutation STREQUAL "wrong-pipeline")
            string(REPLACE "COMMAND \"\${CLANG_FORMAT}\" --Werror" "COMMAND \"\${UNCRUSTIFY}\" --Werror" mutated "${mutated}")
        elseif(mutation STREQUAL "ignored-version")
            string(REPLACE "OR NOT \"\${output}\${error}\" MATCHES \"\${version}\"" "" mutated "${mutated}")
        elseif(mutation STREQUAL "ignored-diagnostic")
            string(REPLACE "OR diagnostic MATCHES \"warning|error|unknown|invalid\"" "" mutated "${mutated}")
        else()
            string(REPLACE "OR relative MATCHES \"(^|/)(upstream|generated|fixtures)/\"" "" mutated "${mutated}")
        endif()
        if(mutated STREQUAL originalDriver)
            message(FATAL_ERROR "Mutation did not alter driver: ${mutation}")
        endif()
        file(WRITE "${RUN_DIR}/${mutation}.cmake" "${mutated}")
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DDRIVER=${RUN_DIR}/${mutation}.cmake"
            "-DPROBE=${PROBE}" "-DROOT=${ROOT}" "-DRUN_DIR=${RUN_DIR}/mutation-${mutation}"
            -DMUTATION_CHILD=ON -P "${CMAKE_CURRENT_LIST_FILE}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
        file(WRITE "${RUN_DIR}/${mutation}.log" "${output}${error}")
        if(result STREQUAL "0" OR NOT "${result}" MATCHES "^[0-9]+$"
            OR NOT "${output}${error}" MATCHES "Expected rejection|Check modified input|Split, omitted or collided path")
            message(FATAL_ERROR "Mutation survived or failed to execute: ${mutation}: ${result}")
        endif()
        message(STATUS "format mutation rejected: ${mutation}")
    endforeach()
    set(uncrustify "${savedUncrustify}")
    set(clang "${RUN_DIR}/clang-format${extension}")
    file(WRITE "${RUN_DIR}/files.json" "[\"src/keep.cpp\"]")
    set(case restored-baseline)
    run(pass Check)
endif()
