cmake_minimum_required(VERSION 3.25)
execute_process(COMMAND "${CTEST}" --test-dir "${BUILD}" -C "${CONFIG}" --show-only=json-v1
    RESULT_VARIABLE result OUTPUT_FILE "${OUTPUT}" ERROR_VARIABLE error TIMEOUT 30)
if(NOT result EQUAL 0 OR NOT error STREQUAL "")
    message(FATAL_ERROR "CTest inventory failed: ${result}: ${error}")
endif()
file(READ "${OUTPUT}" current)
file(READ "${CMAKE_CURRENT_LIST_DIR}/evidence/baseline-ctest.json" baseline)
set(qtp inspection_checker_contract inspection_cli_negatives inspection_process_contract qtp_argument_contract
    offline_inspection_cli offline_inspection_injected_io human_inspection_cli human_inspection_injected_io)
set(tape profile_inspection_io profile_inspection_cli field_type_inspection_io field_type_inspection_cli
    raw_tape_inspection_cli raw_tape_inspection_io quote_inspection_io quote_inspection_cli
    tape_inspection_io tape_inspection_cli tape_argument_contract)
string(JSON count LENGTH "${baseline}" tests)
math(EXPR last "${count}-1")
set(required tooling_logger_contract tooling_format_contract tooling_coverage_contract tooling_audit_contract)
foreach(i RANGE 0 ${last})
    string(JSON name GET "${baseline}" tests ${i} name)
    if((QTP OR NOT name IN_LIST qtp) AND (TAPE OR NOT name IN_LIST tape))
        list(APPEND required "${name}")
    endif()
endforeach()
string(JSON count LENGTH "${current}" tests)
math(EXPR last "${count}-1")
set(names)
foreach(i RANGE 0 ${last})
    string(JSON name GET "${current}" tests ${i} name)
    list(APPEND names "${name}")
    string(JSON test GET "${current}" tests ${i})
    if(test MATCHES "\"name\"[ \n]*:[ \n]*\"DISABLED\"[ \n]*,[ \n]*\"value\"[ \n]*:[ \n]*true")
        message(FATAL_ERROR "Disabled CTest: ${name}")
    endif()
endforeach()
list(SORT required)
list(SORT names)
if(NOT names STREQUAL required)
    message(FATAL_ERROR "Changed CTest inventory. Expected ${required}; observed ${names}")
endif()
message(STATUS "PASS exact applicable CTest inventory: ${count}")
