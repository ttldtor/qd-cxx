cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED MANIFEST)
    set(MANIFEST "${CMAKE_CURRENT_LIST_DIR}/coverage.json")
endif()
file(READ "${MANIFEST}" inventory)
string(JSON schema ERROR_VARIABLE error GET "${inventory}" schema)
if(error OR NOT schema STREQUAL "qdcxx-tooling-coverage-v1")
    message(FATAL_ERROR "Invalid tooling coverage schema")
endif()
# Required identities are independent of the editable manifest; count-only checks would miss substitutions.
set(required_bootstrap clean-standalone record-success record-failure native-argv raw-streams controlled-lifetimes missing-coverage)
set(required_logger argv-empty argv-space argv-unicode argv-semicolon argv-quotes argv-backslashes argv-option windows-acp-1252 child-tz-only parent-environment cwd-inheritance utf8-split utf8-invalid utf8-truncated utf8-bom-retained utf16-bom-bytes newlines-split newlines-universal empty-lines separate-final-fragments concurrent-large-streams per-stream-order stdout-log-equality utc-milliseconds lf-no-file-bom command-exit-records exit-zero exit-37 missing-executable unwritable-log late-write-failure flush-failure closed-console linux-dev-full orphan-pipes failure-after-root-exit five-second-cleanup no-live-owned-descendants help-equivalence invalid-arguments signal-exit cancellation-limits mutation-argv mutation-decoding mutation-exit restored-baseline stalled-open-console stalled-log-fifo stalled-stderr-diagnostic same-session-process-group)
set(required_formatter real-format-check idempotence mismatch-read-only missing-tool wrong-uncrustify-version wrong-clang-version missing-config uncrustify-warning clang-diagnostic nonzero-exit interrupted-pipeline successful-file-publication-only cleanup tracked-discovery new-source-discovery developer-source-discovery unicode-path space-path semicolon-path same-basename cr-lf-rejection protected-segments unsupported-extension traversal outside-roots source-alias-escape executable-symlink exact-native-provenance no-interpreters caller-temp-cache-preserved)
set(required_guard python-path python-absolute python-descendant-swallow powershell-path powershell-absolute powershell-descendant-swallow allowed-baseline missing-trace-each empty-trace extra-trace malformed-trace wrong-root old-suite-inventory old-inner-cases old-mutations production-eight-combinations no-doctest-production guarded-bootstrap guarded-real-format guarded-logger formatter-powershell-descendant)
set(required_offline_mutations value symbol local-id name complete-count offset row-type row-arity number-syntax hex-syntax missing-complete double-complete trailing-row empty-selection java-value java-unknown java-completion)
set(required_human_mutations label value escape escape-lookalike completion-count missing-completion double-completion trailing-output frame-offset)
set(required_optional_setup wrong-sha256 tampered-cache interrupted-download truncated-zip missing-executable cold-missing-executable parent-slash parent-backslash parent-mixed absolute-slash absolute-backslash absolute-drive absolute-unc alternate-stream device-name trailing-dot unix-symlink windows-reparse case-duplicate extraction-conflict filesystem-junction existing-installation-junction locked-cold-acquisition locked-warm-acquisition wrong-version-Uncrustify wrong-version-ClangFormat formatting-defect-read-only format-check-idempotence)
set(groups bootstrap logger formatter guard offline_mutations human_mutations optional_setup)
string(JSON group_count LENGTH "${inventory}" groups)
list(LENGTH groups expected_group_count)
if(NOT group_count EQUAL expected_group_count)
    message(FATAL_ERROR "Coverage group inventory changed")
endif()
# Check every group count before walking identities. Missing-entry controls then
# fail cheaply, while the intact inventory still validates every name and owner.
foreach(group IN LISTS groups)
    string(JSON count ERROR_VARIABLE error LENGTH "${inventory}" groups "${group}")
    list(LENGTH required_${group} required_count)
    if(error OR NOT count EQUAL required_count)
        message(FATAL_ERROR "Missing or extra coverage entry in ${group}")
    endif()
endforeach()
set(total 0)
foreach(group IN LISTS groups)
    list(LENGTH required_${group} count)
    set(found)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON id ERROR_VARIABLE error GET "${inventory}" groups "${group}" ${index} id)
        if(error OR NOT id IN_LIST required_${group} OR id IN_LIST found)
            message(FATAL_ERROR "Unknown or duplicate coverage entry in ${group}: ${id}")
        endif()
        string(JSON owner ERROR_VARIABLE error GET "${inventory}" groups "${group}" ${index} owner)
        if(error OR owner STREQUAL "")
            message(FATAL_ERROR "Missing coverage owner: ${group}/${id}")
        endif()
        list(APPEND found "${id}")
        math(EXPR total "${total} + 1")
    endforeach()
endforeach()
if(NOT VALIDATE_ONLY)
    if(NOT DEFINED RUN)
        message(FATAL_ERROR "Negative coverage checks require -DRUN=<private test directory>")
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(negative_dir "${RUN}/coverage-${nonce}")
    file(MAKE_DIRECTORY "${negative_dir}")
    foreach(group IN LISTS groups)
        list(LENGTH required_${group} count)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON mutated REMOVE "${inventory}" groups "${group}" ${index})
            file(WRITE "${negative_dir}/missing.json" "${mutated}\n")
            execute_process(COMMAND "${CMAKE_COMMAND}" "-DMANIFEST=${negative_dir}/missing.json"
                -DVALIDATE_ONLY=ON -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result
                OUTPUT_VARIABLE output ERROR_VARIABLE error)
            if(result EQUAL 0 OR NOT error MATCHES "Missing or extra coverage entry")
                message(FATAL_ERROR "Missing-entry control did not reject ${group}/${index}: ${output} ${error}")
            endif()
        endforeach()
    endforeach()
    file(REMOVE "${negative_dir}/missing.json")
    file(REMOVE_RECURSE "${negative_dir}")
    message(STATUS "PASS coverage: ${total} named entries; every single missing-entry mutation rejected")
else()
    message(STATUS "PASS coverage inventory: ${total} named entries")
endif()
