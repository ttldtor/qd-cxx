cmake_minimum_required(VERSION 3.25)
foreach(required GUARD PROBE RUN)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${RUN}")
if(NOT DEFINED TRACE_ROOT)
    set(TRACE_ROOT "${RUN}")
endif()
file(MAKE_DIRECTORY "${TRACE_ROOT}")
if(WIN32)
    set(suffix .exe)
else()
    set(suffix "")
endif()
function(check name expected)
    execute_process(COMMAND "${GUARD}" --deny-interpreters "${TRACE_ROOT}/${name}.exec.tsv" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: expected ${expected}, got ${result}: ${error}")
    endif()
    file(READ "${TRACE_ROOT}/${name}.exec.tsv" trace)
    if(expected EQUAL 97)
        if(NOT trace MATCHES "DENIED\t")
            message(FATAL_ERROR "${name}: missing denial")
        endif()
    elseif(trace MATCHES "DENIED\t" OR NOT trace MATCHES "^EXEC\t")
        message(FATAL_ERROR "${name}: invalid positive trace")
    endif()
    file(REAL_PATH "${ARGV2}" root)
    set(denial "")
    if(expected EQUAL 97)
        file(REAL_PATH "${denied_image}" denial)
    endif()
    foreach(variable root denial)
        if(WIN32 AND NOT "${${variable}}" STREQUAL "")
            file(TO_NATIVE_PATH "${${variable}}" ${variable})
            string(PREPEND ${variable} "\\\\?\\")
        endif()
        string(REPLACE "\\" "\\\\" ${variable} "${${variable}}")
        string(REPLACE "\"" "\\\"" ${variable} "${${variable}}")
    endforeach()
    set_property(GLOBAL APPEND PROPERTY qdcxx_guard_entries
        "{\"name\":\"${name}.exec.tsv\",\"root\":\"${root}\",\"denial\":\"${denial}\"}")
    message(STATUS "PASS guard ${name}")
endfunction()
check(baseline 0 "${PROBE}" exit 0)
foreach(name python python3 pythonw py pwsh powershell powershell_ise)
    set(alias "${RUN}/${name}${suffix}")
    configure_file("${PROBE}" "${alias}" COPYONLY)
    file(CHMOD "${alias}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    set(denied_image "${alias}")
    check("${name}-absolute" 97 "${alias}" exit 0)
    check("${name}-path" 97 "${CMAKE_COMMAND}" -E env "PATH=${RUN}" -- "${name}${suffix}" exit 0)
    check("${name}-descendant" 97 "${PROBE}" spawn-swallow "${alias}" exit 0)
endforeach()
# Backward compatibility: default policy still allows a PowerShell-named native image.
execute_process(COMMAND "${GUARD}" "${TRACE_ROOT}/default-policy.python-only.tsv" "${RUN}/pwsh${suffix}" exit 0
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Default Python-only policy changed: ${result}: ${error}")
endif()
foreach(runtime PYTHON POWERSHELL)
    if(DEFINED ${runtime} AND NOT "${${runtime}}" STREQUAL "")
        set(denied_image "${${runtime}}")
        cmake_path(GET denied_image PARENT_PATH directory)
        cmake_path(GET denied_image FILENAME executable)
        check("real-${runtime}-absolute" 97 "${denied_image}" --version)
        check("real-${runtime}-path" 97 "${CMAKE_COMMAND}" -E env "PATH=${directory}" -- "${executable}" --version)
        check("real-${runtime}-descendant" 97 "${PROBE}" spawn-swallow "${denied_image}" --version)
    endif()
endforeach()
if(DEFINED FORMAT_PROBE AND DEFINED FORMAT_DRIVER AND DEFINED ROOT AND DEFINED POWERSHELL)
    set(fake_repo "${RUN}/fake-repo")
    file(MAKE_DIRECTORY "${fake_repo}/src")
    configure_file("${FORMAT_PROBE}" "${RUN}/uncrustify${suffix}" COPYONLY)
    configure_file("${FORMAT_PROBE}" "${RUN}/clang-format${suffix}" COPYONLY)
    file(WRITE "${RUN}/uncrustify${suffix}.mode" "powershell")
    file(WRITE "${RUN}/clang-format${suffix}.mode" "normal")
    file(COPY "${ROOT}/.clang-format" "${ROOT}/.uncrustify.cfg" DESTINATION "${fake_repo}")
    file(WRITE "${fake_repo}/src/control.cpp" "int main() { return 0; }\n")
    file(WRITE "${RUN}/format-files.json" "[\"src/control.cpp\"]")
    cmake_path(GET POWERSHELL PARENT_PATH powershell_dir)
    set(original_path "$ENV{PATH}")
    if(WIN32)
        set(ENV{PATH} "${powershell_dir};$ENV{PATH}")
    else()
        set(ENV{PATH} "${powershell_dir}:$ENV{PATH}")
    endif()
    set(denied_image "${POWERSHELL}")
    check(formatter-powershell-descendant 97 "${CMAKE_COMMAND}" "-DROOT=${fake_repo}"
        "-DUNCRUSTIFY=${RUN}/uncrustify${suffix}" "-DCLANG_FORMAT=${RUN}/clang-format${suffix}"
        "-DFILES=${RUN}/format-files.json" -DMODE=Check -P "${FORMAT_DRIVER}")
    set(ENV{PATH} "${original_path}")
endif()
check(restored 0 "${PROBE}" exit 0)
get_property(entries GLOBAL PROPERTY qdcxx_guard_entries)
list(JOIN entries ",\n" entries)
file(CONFIGURE OUTPUT "${TRACE_ROOT}/inventory.json" CONTENT "{\"entries\":[\n${entries}\n]}\n" @ONLY NEWLINE_STYLE UNIX)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DMANIFEST=${TRACE_ROOT}/inventory.json" "-DTRACE_ROOT=${TRACE_ROOT}"
    -P "${CMAKE_CURRENT_LIST_DIR}/audit.cmake" COMMAND_ERROR_IS_FATAL ANY)
