cmake_minimum_required(VERSION 3.25)
# Rerun existing complete profiles after an author-review tooling correction.
# Original configure/build/test evidence stays intact in the matrix directory.
foreach(required ROOT MATRIX RUN EVIDENCE GUARD LOGGER UNCRUSTIFY CLANG_FORMAT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(EXISTS "${EVIDENCE}" OR EXISTS "${RUN}")
    message(FATAL_ERROR "Recheck work/evidence directories must be fresh")
endif()
file(MAKE_DIRECTORY "${RUN}" "${EVIDENCE}")
find_program(CTEST ctest REQUIRED)
set(ENV{MSBUILDDISABLENODEREUSE} 1)
set(ENV{DOTNET_CLI_TELEMETRY_OPTOUT} 1)
set(ENV{ASAN_OPTIONS} detect_leaks=0)
set(ENV{LSAN_OPTIONS} detect_leaks=0)
file(REAL_PATH "${LOGGER}" logger_image)
if(WIN32)
    file(TO_NATIVE_PATH "${logger_image}" logger_image)
    string(PREPEND logger_image "\\\\?\\")
endif()
string(REPLACE "\\" "\\\\" root_json "${logger_image}")
string(REPLACE "\"" "\\\"" root_json "${root_json}")
function(phase name)
    execute_process(COMMAND "${GUARD}" --deny-interpreters "${EVIDENCE}/${name}.exec.tsv"
        "${LOGGER}" --log "${EVIDENCE}/${name}.log" -- ${ARGN}
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error TIMEOUT 1200)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${name} failed (${result}): ${error}; see ${EVIDENCE}/${name}.log")
    endif()
    set_property(GLOBAL APPEND PROPERTY recheck_entries
        "{\"name\":\"${name}.exec.tsv\",\"root\":\"${root_json}\",\"denial\":\"\"}")
    message(STATUS "PASS ${name}")
endfunction()
phase(portable-bootstrap "${CMAKE_COMMAND}" "-DSOURCE=${ROOT}" "-DBINARY=${RUN}/standalone"
    "-DLOG=${EVIDENCE}/standalone-bootstrap.log" -DCONFIG=Release -P "${ROOT}/tools/dev/Bootstrap.cmake")
phase(portable-format "${CMAKE_COMMAND}" "-DROOT=${ROOT}" "-DUNCRUSTIFY=${UNCRUSTIFY}"
    "-DCLANG_FORMAT=${CLANG_FORMAT}" -DMODE=Check -P "${ROOT}/tools/format/Format-Cpp.cmake")
function(profile name config qtp tape)
    set(build "${MATRIX}/${name}")
    if(NOT EXISTS "${build}/CMakeCache.txt")
        message(FATAL_ERROR "Missing original profile: ${name}")
    endif()
    phase("${name}-build" "${CMAKE_COMMAND}" --build "${build}" --config "${config}" --parallel 6)
    phase("${name}-inventory" "${CMAKE_COMMAND}" "-DCTEST=${CTEST}" "-DBUILD=${build}"
        "-DCONFIG=${config}" "-DOUTPUT=${EVIDENCE}/${name}.tests.json" "-DQTP=${qtp}" "-DTAPE=${tape}"
        -P "${CMAKE_CURRENT_LIST_DIR}/inventory.cmake")
    phase("${name}-test" "${CTEST}" --test-dir "${build}" -C "${config}" --parallel 4 --output-on-failure)
    file(COPY_FILE "${build}/Testing/Temporary/LastTest.log" "${EVIDENCE}/${name}.cases.log")
    if(qtp)
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASES=${EVIDENCE}/${name}.cases.log"
            -P "${CMAKE_CURRENT_LIST_DIR}/case_audit.cmake" COMMAND_ERROR_IS_FATAL ANY)
    endif()
endfunction()
if(WIN32)
    foreach(compiler msvc clang)
        foreach(config Debug Release)
            profile("${compiler}-${config}" "${config}" ON ON)
        endforeach()
    endforeach()
else()
    profile(gcc-Debug Debug ON ON)
    profile(gcc-Release Release ON ON)
    profile(gcc-Asan Debug ON ON)
endif()
foreach(qtp OFF ON)
    foreach(tape OFF ON)
        profile("matrix-ON-${qtp}-${tape}" Release "${qtp}" "${tape}")
    endforeach()
endforeach()
get_property(entries GLOBAL PROPERTY recheck_entries)
list(JOIN entries ",\n" entries)
file(CONFIGURE OUTPUT "${EVIDENCE}/inventory.json" CONTENT "{\"entries\":[\n${entries}\n]}\n" @ONLY NEWLINE_STYLE UNIX)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DMANIFEST=${EVIDENCE}/inventory.json" "-DTRACE_ROOT=${EVIDENCE}"
    -P "${CMAKE_CURRENT_LIST_DIR}/audit.cmake" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_MANIFEST=${EVIDENCE}/inventory.json"
    "-DSOURCE_TRACES=${EVIDENCE}" "-DRUN=${RUN}/audit-negatives" -P "${CMAKE_CURRENT_LIST_DIR}/audit_tests.cmake"
    OUTPUT_FILE "${EVIDENCE}/audit-negatives.log" ERROR_FILE "${EVIDENCE}/audit-negatives.stderr"
    COMMAND_ERROR_IS_FATAL ANY)
