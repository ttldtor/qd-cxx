cmake_minimum_required(VERSION 3.25)

# This audit writes only its fresh ignored RUN directory (and optional report).
# Git's read-only commands must not refresh the owner's index as a side effect.
if(NOT DEFINED ROOT)
    get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
endif()
file(REAL_PATH "${ROOT}" ROOT)
foreach(required MANIFEST BASELINE RUN)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
get_filename_component(RUN "${RUN}" ABSOLUTE BASE_DIR "${ROOT}")
file(RELATIVE_PATH runRelative "${ROOT}" "${RUN}")
if(NOT runRelative MATCHES "^\\.work/" OR EXISTS "${RUN}")
    message(FATAL_ERROR "RUN must be a fresh task directory beneath ROOT/.work")
endif()
find_program(gitProgram git REQUIRED)
function(gitRead)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env GIT_OPTIONAL_LOCKS=0
        "${gitProgram}" -C "${ROOT}" ${ARGV}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Read-only Git command failed (${result}): ${ARGV}\n${error}")
    endif()
    set(gitOutput "${output}" PARENT_SCOPE)
endfunction()

function(pathCheck path)
    if(path STREQUAL "" OR IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)|[\r\n\t\\\\]")
        message(FATAL_ERROR "Invalid repository-relative inventory path: ${path}")
    endif()
endfunction()

function(authoredWhitespace path)
    file(READ "${path}" contents)
    string(REPLACE "\r\n" "\n" contents "${contents}")
    if(contents MATCHES "[ \t]+\n|[ \t]+$")
        message(FATAL_ERROR "Authored trailing whitespace: ${path}")
    endif()
endfunction()

# NUL output is read as hex, so display quoting, semicolons and UTF-8 cannot
# change the inventory. NUL bytes are separators and never enter CMake strings.
function(addGitInventory file)
    file(READ "${file}" encoded HEX)
    string(LENGTH "${encoded}" length)
    set(position 0)
    set(path "")
    while(position LESS length)
        string(SUBSTRING "${encoded}" ${position} 2 byte)
        math(EXPR position "${position}+2")
        if(byte STREQUAL "00")
            pathCheck("${path}")
            string(JSON actual SET "${actual}" "${path}" true)
            set(path "")
        else()
            math(EXPR decimal "0x${byte}")
            string(ASCII ${decimal} character)
            string(APPEND path "${character}")
        endif()
    endwhile()
    if(NOT path STREQUAL "")
        message(FATAL_ERROR "Unterminated Git inventory")
    endif()
    set(actual "${actual}" PARENT_SCOPE)
endfunction()

# A missing index is valid only for a repository whose baseline did not have one.
# The actual project has an index; both its staged state and audit-time bytes are checked.
gitRead(rev-parse --git-path index)
string(STRIP "${gitOutput}" indexPath)
get_filename_component(indexPath "${indexPath}" ABSOLUTE BASE_DIR "${ROOT}")
if(EXISTS "${indexPath}")
    file(SHA256 "${indexPath}" indexBefore)
else()
    set(indexBefore absent)
endif()
gitRead(diff --cached --check)
gitRead(diff --cached --quiet)
gitRead(diff --check)
execute_process(COMMAND "${CMAKE_COMMAND}" -E env GIT_OPTIONAL_LOCKS=0
    "${gitProgram}" -C "${ROOT}" check-ignore "${RUN}/objects"
    RESULT_VARIABLE ignored OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT ignored STREQUAL "0")
    message(FATAL_ERROR "RUN is not Git-ignored: ${error}")
endif()
set(existingParent "${RUN}")
while(NOT EXISTS "${existingParent}")
    get_filename_component(existingParent "${existingParent}" DIRECTORY)
endwhile()
file(REAL_PATH "${existingParent}" resolvedParent)
if(NOT resolvedParent STREQUAL existingParent)
    message(FATAL_ERROR "RUN parent must not contain a filesystem alias")
endif()
file(REAL_PATH "${ROOT}/.work" workRoot)
if(NOT workRoot STREQUAL "${ROOT}/.work")
    message(FATAL_ERROR "ROOT/.work must not resolve outside its lexical location")
endif()
file(MAKE_DIRECTORY "${RUN}/objects")
file(WRITE "${RUN}/empty" "")

file(READ "${BASELINE}" baseline)
string(JSON baselineHead GET "${baseline}" head)
gitRead(rev-parse HEAD)
string(STRIP "${gitOutput}" currentHead)
if(NOT currentHead STREQUAL baselineHead)
    message(FATAL_ERROR "HEAD changed from baseline")
endif()
string(JSON baselineIndex ERROR_VARIABLE missingIndex GET "${baseline}" indexSha256)
if(NOT missingIndex AND NOT baselineIndex STREQUAL indexBefore)
    message(FATAL_ERROR "Owner index differs from recorded baseline bytes")
endif()
set(allowed .gitattributes AGENTS.md CMakeLists.txt tests/conformance/no_python_guard.cpp
    tools/format/CPP.md tools/format/CPP.ru.md docs/CPP-BUILD.md docs/CPP-BUILD.ru.md
    docs/PYTHON-MIGRATION.md docs/PYTHON-MIGRATION.ru.md docs/CURRENT-STATE.md docs/CURRENT-STATE.ru.md
    docs/NEXT-STEPS.md docs/NEXT-STEPS.ru.md tasks/README.md tasks/README.ru.md)
string(JSON baselineCount LENGTH "${baseline}" files)
if(baselineCount LESS 1)
    message(FATAL_ERROR "Empty protected baseline")
endif()
set(protectedCount 0)
set(allowedCount 0)
math(EXPR baselineLast "${baselineCount}-1")
foreach(index RANGE 0 ${baselineLast})
    string(JSON path GET "${baseline}" files ${index} path)
    string(JSON expectedHash GET "${baseline}" files ${index} sha256)
    pathCheck("${path}")
    if(path IN_LIST allowed)
        math(EXPR allowedCount "${allowedCount}+1")
        continue()
    endif()
    if(NOT EXISTS "${ROOT}/${path}" OR IS_DIRECTORY "${ROOT}/${path}")
        message(FATAL_ERROR "Protected baseline file missing: ${path}")
    endif()
    file(SHA256 "${ROOT}/${path}" actualHash)
    string(TOLOWER "${expectedHash}" expectedHash)
    if(NOT actualHash STREQUAL expectedHash)
        message(FATAL_ERROR "Protected baseline file changed: ${path}")
    endif()
    math(EXPR protectedCount "${protectedCount}+1")
endforeach()

message(STATUS "Protected baseline checked: ${protectedCount} preserved, ${allowedCount} allowed existing paths")

file(READ "${MANIFEST}" manifest)
string(REPLACE "\r\n" "\n" manifest "${manifest}")
set(expected "{}")
set(fileCount 0)
while(NOT manifest STREQUAL "")
    string(FIND "${manifest}" "\n" end)
    if(end EQUAL -1)
        set(path "${manifest}")
        set(manifest "")
    else()
        string(SUBSTRING "${manifest}" 0 ${end} path)
        math(EXPR next "${end}+1")
        string(SUBSTRING "${manifest}" ${next} -1 manifest)
    endif()
    pathCheck("${path}")
    string(JSON already ERROR_VARIABLE missing GET "${expected}" "${path}")
    if(NOT missing)
        message(FATAL_ERROR "Duplicate manifest path: ${path}")
    endif()
    if(NOT EXISTS "${ROOT}/${path}" OR IS_DIRECTORY "${ROOT}/${path}")
        message(FATAL_ERROR "Manifest file missing: ${path}")
    endif()
    string(JSON expected SET "${expected}" "${path}" true)
    math(EXPR fileCount "${fileCount}+1")
endwhile()
if(fileCount EQUAL 0)
    message(FATAL_ERROR "Empty change manifest")
endif()
set(actual "{}")
foreach(kind changed untracked)
    if(kind STREQUAL "changed")
        set(arguments diff --name-only -z)
    else()
        set(arguments ls-files --others --exclude-standard -z)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env GIT_OPTIONAL_LOCKS=0
        "${gitProgram}" -C "${ROOT}" ${arguments}
        OUTPUT_FILE "${RUN}/${kind}.nul" ERROR_VARIABLE error RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Git inventory failed: ${error}")
    endif()
    addGitInventory("${RUN}/${kind}.nul")
endforeach()
if(NOT actual STREQUAL expected)
    foreach(pair actual expected)
        string(JSON count LENGTH "${${pair}}")
        if(count GREATER 0)
            math(EXPR last "${count}-1")
            foreach(index RANGE 0 ${last})
                string(JSON path MEMBER "${${pair}}" ${index})
                if(pair STREQUAL "actual")
                    string(JSON found ERROR_VARIABLE missing GET "${expected}" "${path}")
                else()
                    string(JSON found ERROR_VARIABLE missing GET "${actual}" "${path}")
                endif()
                if(missing)
                    message(SEND_ERROR "Inventory mismatch (${pair} only): ${path}")
                endif()
            endforeach()
        endif()
    endforeach()
    message(FATAL_ERROR "Exact changed-file inventory failed")
endif()

message(STATUS "Exact manifest checked: ${fileCount} changed files")

math(EXPR last "${fileCount}-1")
set(authoredCount 0)
foreach(index RANGE 0 ${last})
    string(JSON path MEMBER "${expected}" ${index})
    if(NOT path MATCHES "^tests/conformance/tooling/evidence/")
        authoredWhitespace("${ROOT}/${path}")
        math(EXPR authoredCount "${authoredCount}+1")
    endif()
endforeach()
set(linkCount 0)
foreach(index RANGE 0 ${last})
    string(JSON path MEMBER "${expected}" ${index})
    if(NOT path MATCHES "\\.md$" OR path MATCHES "^tests/conformance/tooling/evidence/")
        continue()
    endif()
    file(READ "${ROOT}/${path}" contents)
    get_filename_component(directory "${ROOT}/${path}" DIRECTORY)
    while(contents MATCHES "\\]\\(([^)]+)\\)")
        set(match "${CMAKE_MATCH_0}")
        set(target "${CMAKE_MATCH_1}")
        string(FIND "${contents}" "${match}" position)
        string(LENGTH "${match}" length)
        math(EXPR position "${position}+${length}")
        string(SUBSTRING "${contents}" ${position} -1 contents)
        string(REGEX REPLACE "^<|>$" "" target "${target}")
        if(target MATCHES "^[A-Za-z][A-Za-z0-9+.-]*:|^#")
            continue()
        endif()
        string(REGEX REPLACE "#.*$" "" target "${target}")
        while(target MATCHES "%([0-9A-Fa-f][0-9A-Fa-f])")
            set(escape "${CMAKE_MATCH_0}")
            math(EXPR byte "0x${CMAKE_MATCH_1}")
            if(byte EQUAL 0)
                message(FATAL_ERROR "NUL in Markdown link: ${path}")
            endif()
            string(ASCII ${byte} character)
            string(REPLACE "${escape}" "${character}" target "${target}")
        endwhile()
        if(NOT target STREQUAL "" AND NOT EXISTS "${directory}/${target}")
            message(FATAL_ERROR "Broken relative Markdown link: ${path}: ${target}")
        endif()
        math(EXPR linkCount "${linkCount}+1")
    endwhile()
endforeach()

message(STATUS "Authored checks: ${authoredCount} files, ${linkCount} relative links")

set(rawCount 0)
foreach(index RANGE 0 ${last})
    string(JSON path MEMBER "${expected}" ${index})
    if(NOT path MATCHES "^tests/conformance/tooling/evidence/")
        continue()
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env GIT_OPTIONAL_LOCKS=0 "GIT_OBJECT_DIRECTORY=${RUN}/objects"
        "${gitProgram}" -C "${ROOT}" -c core.autocrlf=true hash-object -w "--path=${path}" "${path}"
        RESULT_VARIABLE result OUTPUT_VARIABLE objectId ERROR_VARIABLE error)
    string(STRIP "${objectId}" objectId)
    if(NOT result STREQUAL "0" OR NOT objectId MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Isolated Git clean failed: ${path}: ${error}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env GIT_OPTIONAL_LOCKS=0 "GIT_OBJECT_DIRECTORY=${RUN}/objects"
        "${gitProgram}" -C "${ROOT}" -c core.autocrlf=true cat-file --filters "--path=${path}" "${objectId}"
        OUTPUT_FILE "${RUN}/roundtrip.bin" RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Isolated Git smudge failed: ${path}: ${error}")
    endif()
    file(SHA256 "${ROOT}/${path}" before)
    file(SHA256 "${RUN}/roundtrip.bin" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Raw Git filter roundtrip changed bytes: ${path}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env GIT_OPTIONAL_LOCKS=0
        "${gitProgram}" -C "${ROOT}" diff --no-index --check -- "${RUN}/empty" "${path}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result STREQUAL "0" AND NOT result STREQUAL "1")
        message(FATAL_ERROR "Raw Git whitespace attributes failed: ${path}\n${output}${error}")
    endif()
    math(EXPR rawCount "${rawCount}+1")
endforeach()

# The negative is outside raw evidence attributes, so raw exceptions cannot hide
# authored trailing spaces. Reinvoke this same helper in a finite child process.
file(WRITE "${RUN}/authored-whitespace.md" "negative control  \n")
file(READ "${CMAKE_CURRENT_LIST_FILE}" auditSource)
string(FIND "${auditSource}" "function(authoredWhitespace path)" helperStart)
string(SUBSTRING "${auditSource}" ${helperStart} -1 helperSource)
string(FIND "${helperSource}" "endfunction()" helperEnd)
string(LENGTH "endfunction()" terminatorLength)
math(EXPR helperEnd "${helperEnd}+${terminatorLength}")
string(SUBSTRING "${helperSource}" 0 ${helperEnd} helperSource)
file(WRITE "${RUN}/whitespace-negative.cmake" "${helperSource}\nauthoredWhitespace(\"\${INPUT}\")\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${RUN}/authored-whitespace.md" -P "${RUN}/whitespace-negative.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(result STREQUAL "0" OR NOT error MATCHES "Authored trailing whitespace")
    message(FATAL_ERROR "Authored whitespace negative was not rejected")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env GIT_OPTIONAL_LOCKS=0
    "${gitProgram}" -C "${ROOT}" -c core.whitespace=blank-at-eol diff --no-index --check --
    "${RUN}/empty" "${RUN}/authored-whitespace.md"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if((result STREQUAL "0" OR result STREQUAL "1") OR NOT "${output}${error}" MATCHES "trailing whitespace")
    message(FATAL_ERROR "Git authored whitespace negative was not rejected")
endif()
gitRead(diff --cached --check)
gitRead(diff --cached --quiet)
if(EXISTS "${indexPath}")
    file(SHA256 "${indexPath}" indexAfter)
else()
    set(indexAfter absent)
endif()
if(NOT indexBefore STREQUAL indexAfter)
    message(FATAL_ERROR "Audit changed owner index bytes")
endif()
string(TIMESTAMP utc "%Y-%m-%dT%H:%M:%SZ" UTC)
set(report "{\n  \"utc\": \"${utc}\",\n  \"head\": \"${currentHead}\",\n  \"files\": ${fileCount},\n  \"protectedFilesUnchanged\": ${protectedCount},\n  \"allowedBaselineFiles\": ${allowedCount},\n  \"authoredFilesChecked\": ${authoredCount},\n  \"relativeLinksChecked\": ${linkCount},\n  \"rawFilterRoundtrips\": ${rawCount},\n  \"indexBeforeAndAfterSha256\": \"${indexBefore}\",\n  \"staging\": \"empty; no staging performed\",\n  \"authoredWhitespaceNegative\": \"rejected\"\n}\n")
if(DEFINED OUTPUT)
    get_filename_component(reportPath "${OUTPUT}" ABSOLUTE BASE_DIR "${ROOT}")
    file(RELATIVE_PATH reportRelative "${RUN}" "${reportPath}")
    if(reportRelative MATCHES "^\\.\\./" OR IS_ABSOLUTE "${reportRelative}")
        message(FATAL_ERROR "OUTPUT must remain inside ignored RUN to avoid a self-referential manifest")
    endif()
    file(WRITE "${reportPath}" "${report}")
endif()
message(STATUS "Handoff passed: ${fileCount} changed files; ${protectedCount} protected; ${authoredCount} authored; ${linkCount} relative links; ${rawCount} byte-exact raw roundtrips; empty stage and unchanged audit-time index SHA256")
