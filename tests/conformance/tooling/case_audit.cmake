cmake_minimum_required(VERSION 3.25)
file(READ "${CASES}" cases)
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../python-migration/evidence/scenario-map.tsv" schedules ENCODING UTF-8)
list(POP_FRONT schedules)
set(count 0)
foreach(row IN LISTS schedules)
    if(NOT row MATCHES "^(offline|human)\t([^\t]+)\t([^\t]+)\t([0-9]+)\t")
        message(FATAL_ERROR "Malformed frozen schedule")
    endif()
    set(mode "${CMAKE_MATCH_1}")
    set(name "${CMAKE_MATCH_2}")
    set(chunks "${CMAKE_MATCH_3}")
    set(exit "${CMAKE_MATCH_4}")
    if(mode STREQUAL "offline")
        set(mode tsv)
    endif()
    string(REPLACE "," ";" chunks "${chunks}")
    string(FIND "${cases}" "case ${mode}/${name}: chunks=${chunks}; exit=${exit}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing preserved schedule: ${mode}/${name}")
    endif()
    if(mode STREQUAL "tsv")
        string(FIND "${cases}" "legacy TSV/${name}: chunks=1,7,4096; default+explicit; exit=${exit}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Missing preserved legacy TSV case: ${name}")
        endif()
    endif()
    math(EXPR count "${count}+1")
endforeach()
file(READ "${CMAKE_CURRENT_LIST_DIR}/coverage.json" coverage)
foreach(suite offline human)
    string(JSON mutations LENGTH "${coverage}" groups "${suite}_mutations")
    math(EXPR last "${mutations}-1")
    foreach(i RANGE 0 ${last})
        string(JSON label GET "${coverage}" groups "${suite}_mutations" ${i} id)
        string(FIND "${cases}" "${suite}\t${label}\trejected at " position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Missing preserved mutation: ${suite}/${label}")
        endif()
    endforeach()
endforeach()
foreach(required "native argument forwarding: empty, space, Unicode, semicolon, quote, backslash passed"
    "offline: 72 cases" "human: 84 cases" "harness\texit-only\trejected at exact exit comparison")
    string(FIND "${cases}" "${required}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing preserved control: ${required}")
    endif()
endforeach()
message(STATUS "PASS preserved ${count} schedules, 72 legacy cases, 17+9 mutations and exit control")
