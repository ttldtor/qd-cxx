cmake_minimum_required(VERSION 3.25)
foreach(required MANIFEST TRACE_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(READ "${MANIFEST}" manifest)
string(JSON count LENGTH "${manifest}" entries)
if(count EQUAL 0)
    message(FATAL_ERROR "Empty expected trace inventory")
endif()
math(EXPR last "${count}-1")
set(expected)
# UTF-8 grammar excludes surrogates, overlong sequences and values above U+10ffff.
set(cont "[89ab][0-9a-f]")
# Match one scalar at a time. Repeating the alternation over a whole compiler
# trace exhausts CMake's regex stack. ASCII NUL and CR are forbidden framing.
set(utf8 "([1-7][0-9a-f]|0[1-9abcef]|(c[2-9a-f]|d[0-9a-f])${cont}|e0[ab][0-9a-f]${cont}|e[1-9abcef]${cont}${cont}|ed[89][0-9a-f]${cont}|f0[9ab][0-9a-f]${cont}${cont}|f[1-3]${cont}${cont}${cont}|f48[0-9a-f]${cont}${cont})")
foreach(i RANGE 0 ${last})
    string(JSON name GET "${manifest}" entries ${i} name)
    string(JSON root GET "${manifest}" entries ${i} root)
    string(JSON denial GET "${manifest}" entries ${i} denial)
    if(NOT name MATCHES "^[a-zA-Z0-9_-]+[.]exec[.]tsv$" OR name IN_LIST expected)
        message(FATAL_ERROR "Unsafe/duplicate inventory name: ${name}")
    endif()
    list(APPEND expected "${name}")
    set(path "${TRACE_ROOT}/${name}")
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Missing trace: ${name}")
    endif()
    file(READ "${path}" bytes HEX)
    string(REGEX REPLACE "${utf8}" "" invalid "${bytes}")
    if(bytes STREQUAL "" OR bytes MATCHES "^efbbbf" OR NOT invalid STREQUAL "")
        message(FATAL_ERROR "Empty or malformed UTF-8 trace: ${name}")
    endif()
    file(READ "${path}" trace)
    if(NOT bytes MATCHES "0a$")
        message(FATAL_ERROR "Invalid trace framing: ${name}")
    endif()
    set(first TRUE)
    set(denied 0)
    # Image names may contain semicolons, backslashes or unmatched brackets;
    # reversibly encode list metacharacters before splitting, then decode each
    # row. This avoids both list corruption and quadratic whole-trace slicing.
    string(REPLACE "%" "%25" rows "${trace}")
    string(REPLACE "\\" "%5C" rows "${rows}")
    string(REPLACE ";" "%3B" rows "${rows}")
    string(REPLACE "[" "%5B" rows "${rows}")
    string(REPLACE "]" "%5D" rows "${rows}")
    string(REPLACE "\n" ";" rows "${rows}")
    list(POP_BACK rows)
    foreach(row IN LISTS rows)
        string(REPLACE "%5C" "\\" row "${row}")
        string(REPLACE "%3B" ";" row "${row}")
        string(REPLACE "%5B" "[" row "${row}")
        string(REPLACE "%5D" "]" row "${row}")
        string(REPLACE "%25" "%" row "${row}")
        if(NOT row MATCHES "^(EXEC|DENIED)\t([^\t]+)$")
            message(FATAL_ERROR "Malformed trace row: ${name}")
        endif()
        set(kind "${CMAKE_MATCH_1}")
        set(image "${CMAKE_MATCH_2}")
        if(NOT IS_ABSOLUTE "${image}" AND NOT image MATCHES "^\\\\\\\\[?]\\\\[A-Za-z]:\\\\")
            message(FATAL_ERROR "Nonabsolute image: ${name}")
        endif()
        if(first AND NOT image STREQUAL root)
            message(FATAL_ERROR "Wrong root image: ${name}")
        endif()
        set(first FALSE)
        if(image MATCHES "^/")
            # A backslash is a literal POSIX filename byte, not a separator.
            string(REGEX REPLACE "^.*/" "" base "${image}")
        else()
            string(REPLACE "\\" "/" normalized "${image}")
            string(REGEX REPLACE "^.*/" "" base "${normalized}")
        endif()
        string(TOLOWER "${base}" base)
        if(kind STREQUAL "EXEC" AND base MATCHES "^(python([0-9].*)?|pythonw([0-9].*)?|py|pwsh|powershell|powershell_ise)([.]exe)?$")
            message(FATAL_ERROR "Forbidden interpreter executed: ${name}")
        endif()
        if(kind STREQUAL "DENIED")
            math(EXPR denied "${denied}+1")
            if(denial STREQUAL "" OR NOT image STREQUAL denial)
                message(FATAL_ERROR "Unexpected denial: ${name}")
            endif()
        endif()
    endforeach()
    if((denial STREQUAL "" AND NOT denied EQUAL 0) OR (NOT denial STREQUAL "" AND NOT denied EQUAL 1))
        message(FATAL_ERROR "Missing/extra denial: ${name}")
    endif()
endforeach()
file(GLOB actual RELATIVE "${TRACE_ROOT}" "${TRACE_ROOT}/*.exec.tsv")
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Unexpected trace inventory: ${actual}")
endif()
message(STATUS "PASS exact trace inventory: ${count}")
