cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED RUN)
    message(FATAL_ERROR "RUN required")
endif()
file(MAKE_DIRECTORY "${RUN}")
function(writeLf path content)
    file(CONFIGURE OUTPUT "${path}" CONTENT "${content}" @ONLY NEWLINE_STYLE UNIX)
endfunction()
set(audit "${CMAKE_CURRENT_LIST_DIR}/audit.cmake")
if(DEFINED SOURCE_MANIFEST)
    file(READ "${SOURCE_MANIFEST}" manifest)
    string(JSON count LENGTH "${manifest}" entries)
    math(EXPR last "${count}-1")
    foreach(i RANGE 0 ${last})
        string(JSON name GET "${manifest}" entries ${i} name)
        configure_file("${SOURCE_TRACES}/${name}" "${RUN}/${name}" COPYONLY)
    endforeach()
else()
    set(manifest [=[{"entries":[{"name":"positive.exec.tsv","root":"/native/logger","denial":""},{"name":"negative.exec.tsv","root":"/native/probe","denial":"/native/pwsh"}]}]=])
    writeLf("${RUN}/positive.exec.tsv" "EXEC\t/native/logger\nEXEC\t/native/compiler\n")
    writeLf("${RUN}/negative.exec.tsv" "EXEC\t/native/probe\nDENIED\t/native/pwsh\n")
endif()
writeLf("${RUN}/inventory.json" "${manifest}")
function(check name valid)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DMANIFEST=${RUN}/inventory.json" "-DTRACE_ROOT=${RUN}" -P "${audit}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
    if((valid AND NOT result STREQUAL "0") OR (NOT valid AND NOT result STREQUAL "1"))
        message(FATAL_ERROR "${name}: wrong audit result ${result}: ${error}")
    endif()
    message(STATUS "PASS audit ${name}")
endfunction()
check(intact TRUE)
string(JSON count LENGTH "${manifest}" entries)
math(EXPR last "${count}-1")
foreach(i RANGE 0 ${last})
    string(JSON name GET "${manifest}" entries ${i} name)
    file(RENAME "${RUN}/${name}" "${RUN}/${name}.saved")
    check("missing-${name}" FALSE)
    file(RENAME "${RUN}/${name}.saved" "${RUN}/${name}")
endforeach()
string(JSON name GET "${manifest}" entries 0 name)
file(READ "${RUN}/${name}" original)
foreach(mutation empty malformed wrong-root relative forbidden missing-lf extra-tab crlf bom utf16)
    if(mutation STREQUAL "empty")
        set(value "")
    elseif(mutation STREQUAL "malformed")
        set(value "BOGUS\t/native/logger\n")
    elseif(mutation STREQUAL "wrong-root")
        set(value "EXEC\t/other/logger\n")
    elseif(mutation STREQUAL "relative")
        set(value "EXEC\tlogger\n")
    elseif(mutation STREQUAL "forbidden")
        set(value "${original}EXEC\t/native/python3\n")
    elseif(mutation STREQUAL "missing-lf")
        string(REGEX REPLACE "\n$" "" value "${original}")
    elseif(mutation STREQUAL "extra-tab")
        set(value "${original}EXEC\t/native/tool\textra\n")
    elseif(mutation STREQUAL "crlf")
        string(REPLACE "\n" "\r\n" value "${original}")
    elseif(mutation STREQUAL "bom")
        string(ASCII 239 187 191 bom)
        set(value "${bom}${original}")
    else()
        string(ASCII 255 254 bom)
        set(value "${bom}${original}")
    endif()
    if(mutation STREQUAL "crlf")
        file(CONFIGURE OUTPUT "${RUN}/${name}" CONTENT "${original}" @ONLY NEWLINE_STYLE CRLF)
    elseif(mutation STREQUAL "missing-lf")
        string(REGEX MATCH "^[^\n]+" value "${original}")
        file(WRITE "${RUN}/${name}" "${value}")
    else()
        writeLf("${RUN}/${name}" "${value}")
    endif()
    check("content-${mutation}" FALSE)
endforeach()
writeLf("${RUN}/${name}" "${original}")
writeLf("${RUN}/extra.exec.tsv" "${original}")
check(extra-file FALSE)
file(REMOVE "${RUN}/extra.exec.tsv")
check(restored TRUE)
if(NOT DEFINED SOURCE_MANIFEST)
    writeLf("${RUN}/${name}" "${original}EXEC\t/native/tool\\python3\nEXEC\t/native/%5C%3B;[%5B\n")
    check(posix-metacharacters TRUE)
    # Real full-suite process traces exceed one megabyte. Include multibyte
    # image names, and require a normal rejection rather than a crash/timeout.
    string(REPEAT "EXEC\t/native/компилятор;unmatched[-with-a-long-tool-path-for-the-large-trace\n" 20000 large)
    writeLf("${RUN}/${name}" "${original}${large}")
    check(large-utf8 TRUE)
    string(ASCII 237 160 128 surrogate)
    writeLf("${RUN}/${name}" "${original}${large}EXEC\t/native/${surrogate}\n")
    check(large-invalid-utf8 FALSE)
    writeLf("${RUN}/${name}" "${original}")
    check(large-restored TRUE)
endif()
