# Internal check: cmake -DORG_TTLDTOR_QDCXX_PWSH=<pwsh> -P tests/conformance/option_chains_oracle_help.cmake.
# Reads the launcher help without SDK/input paths; no output files or Java work are requested.
# Missing PowerShell, help/invalid-argument contract failures produce a CMake error.
if(NOT ORG_TTLDTOR_QDCXX_PWSH)
    find_program(ORG_TTLDTOR_QDCXX_PWSH pwsh REQUIRED)
endif()
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(launcher "${repo}/tools/upstream/option-chains-oracle/Invoke-Oracle.ps1")
foreach(mode IN ITEMS noargs help ru invalid bad_mode bad_option)
    set(args)
    if(mode STREQUAL "help")
        set(args -Help)
    elseif(mode STREQUAL "ru")
        set(args -HelpRu)
    elseif(mode STREQUAL "invalid")
        set(args -Mode Verify)
    elseif(mode STREQUAL "bad_mode")
        set(args -Mode Invalid)
    elseif(mode STREQUAL "bad_option")
        set(args -NotAParameter)
    endif()
    execute_process(COMMAND "${ORG_TTLDTOR_QDCXX_PWSH}" -NoProfile -File "${launcher}" ${args}
        RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
    if(mode STREQUAL "bad_mode" OR mode STREQUAL "bad_option")
        if(code EQUAL 0 OR err STREQUAL "")
            message(FATAL_ERROR "Invalid invocation succeeded: ${mode}: ${code}: ${err}")
        endif()
    elseif(mode STREQUAL "invalid")
        if(code EQUAL 0 OR NOT err MATCHES "Required inputs missing")
            message(FATAL_ERROR "Incomplete invocation did not fail with actionable input error: ${code}: ${err}")
        endif()
    else()
        if(NOT code EQUAL 0 OR NOT err STREQUAL "" OR out STREQUAL "")
            message(FATAL_ERROR "Help failed: ${mode}: ${code}: ${err}")
        endif()
        if(mode STREQUAL "noargs")
            set(noargs "${out}")
        elseif(mode STREQUAL "help" AND NOT out STREQUAL noargs)
            message(FATAL_ERROR "No-argument and -Help outputs differ")
        endif()
        if(mode STREQUAL "ru" AND NOT out MATCHES "Exit0")
            message(FATAL_ERROR "Russian help lacks exit contract")
        endif()
    endif()
endforeach()
message(STATUS "Option-chain oracle noargs/EN/RU help and incomplete invocation PASS")
