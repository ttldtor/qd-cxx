# Process acceptance of the explicit default Quote profile, without scripting dependencies.
if(NOT DEFINED QUOTE_INPUT)
    set(QUOTE_INPUT "${ROOT}/tests/fixtures/protocol/quote/expected/default-quote.qtp")
endif()
execute_process(COMMAND "${PROGRAM}" --input "${QUOTE_INPUT}" --profile default-quote-v1 RESULT_VARIABLE code OUTPUT_VARIABLE baseline ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR NOT err STREQUAL "" OR NOT baseline MATCHES "^format\tqdcxx-tape-inspect\t2\tdefault-quote-v1\n" OR NOT baseline MATCHES "typed-record\t" OR NOT baseline MATCHES "quote\t")
    message(FATAL_ERROR "Default Quote profile failed: ${code}: ${err}")
endif()

execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE code OUTPUT_VARIABLE help ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR NOT err STREQUAL "" OR help STREQUAL "")
    message(FATAL_ERROR "No-argument help failed")
endif()
execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE code OUTPUT_VARIABLE explicit_help ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR NOT err STREQUAL "" OR NOT help STREQUAL explicit_help)
    message(FATAL_ERROR "Standalone help differs")
endif()
foreach(args IN ITEMS "--input;x;--profile;default-quote-v1;--diagnostics-version;0" "--input;x;--profile;default-quote-v1;--diagnostics-version;3" "--input;x;--profile;default-quote-v1;--diagnostics-version;01" "--input;x;--profile;default-quote-v1;--diagnostics-version;2;--diagnostics-version;2" "--input;x;--profile;default-quote-v1;--max-values;-1")
    execute_process(COMMAND "${PROGRAM}" ${args} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT code EQUAL 2 OR NOT out STREQUAL "" OR NOT err MATCHES "usage")
        message(FATAL_ERROR "Invalid Quote arguments accepted: ${args}")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" --input "${ROOT}/.work/nonexistent-qdcxx-022-input" --profile default-quote-v1 RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 3 OR NOT out STREQUAL "" OR NOT err MATCHES "^incomplete-v2\t3\topen")
    message(FATAL_ERROR "Missing Quote input IO contract")
endif()
execute_process(COMMAND "${PROGRAM}" --input nonexistent --profile wrong --diagnostics-version 2 --output-format human RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 2 OR NOT out STREQUAL "" OR NOT err MATCHES "LOCAL_PROFILE\nReason:")
    message(FATAL_ERROR "Unknown profile rejected before IO with bounded explanation")
endif()
foreach(chunk IN ITEMS 1 2 7 137)
    execute_process(COMMAND "${PROGRAM}" --input "${QUOTE_INPUT}" --profile default-quote-v1 --chunk-size "${chunk}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT code EQUAL 0 OR NOT out STREQUAL baseline OR NOT err STREQUAL "")
        message(FATAL_ERROR "Quote chunk output differs: ${chunk}")
    endif()
endforeach()
string(LENGTH "${baseline}" exact)
math(EXPR short "${exact}-1")
foreach(bound IN ITEMS "${exact}" "${short}" 0)
    execute_process(COMMAND "${PROGRAM}" --input "${QUOTE_INPUT}" --profile default-quote-v1 --max-output "${bound}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(bound EQUAL exact)
        if(NOT code EQUAL 0 OR NOT out STREQUAL baseline)
            message(FATAL_ERROR "Quote exact output budget")
        endif()
    elseif(NOT code EQUAL 6 OR out MATCHES "complete\t")
        message(FATAL_ERROR "Quote output excess not rejected")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" --input "${QUOTE_INPUT}" --profile default-quote-v1 --output-format human RESULT_VARIABLE code OUTPUT_VARIABLE human ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR NOT err STREQUAL "" OR NOT human MATCHES "human 2 profile=default-quote-v1" OR NOT human MATCHES "Bid.Time=1700000000000 ms" OR NOT human MATCHES "Bid.Price=100.25 \\(type:120 raw:2566530\\)")
    message(FATAL_ERROR "Human Quote values or header: ${err}")
endif()
string(LENGTH "${human}" exact_human)
math(EXPR short_human "${exact_human}-1")
foreach(bound IN ITEMS "${exact_human}" "${short_human}")
    execute_process(COMMAND "${PROGRAM}" --input "${QUOTE_INPUT}" --profile default-quote-v1 --output-format human --max-output "${bound}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(bound EQUAL exact_human)
        if(NOT code EQUAL 0 OR NOT out STREQUAL human)
            message(FATAL_ERROR "Quote exact human output budget")
        endif()
    elseif(NOT code EQUAL 6 OR out MATCHES "Complete:")
        message(FATAL_ERROR "Quote human output excess not rejected")
    endif()
endforeach()

# Compare every captured production record, all eight exact raw pairs and all mapped bits.
get_filename_component(quote_dir "${QUOTE_INPUT}" DIRECTORY)
file(STRINGS "${quote_dir}/default-quote.tsv" oracle_lines ENCODING UTF-8)
set(record_count 0)
set(symbol_units 0)
foreach(line IN LISTS oracle_lines)
    string(REPLACE "\t" ";" cells "${line}")
    list(GET cells 0 kind)
    if(kind STREQUAL "record")
        list(GET cells 1 record_index)
        list(GET cells 3 symbol)
        set(pairs "")
        math(EXPR record_count "${record_count}+1")
        string(LENGTH "${symbol}" hex_units)
        math(EXPR symbol_units "${symbol_units}+${hex_units}/4")
    elseif(kind STREQUAL "field")
        list(GET cells 3 type)
        list(GET cells 4 raw)
        if(NOT pairs STREQUAL "")
            string(APPEND pairs ",")
        endif()
        string(APPEND pairs "${type}:${raw}")
    elseif(kind STREQUAL "mapped")
        set(expected "\t${record_index}\t0\t00510075006f00740065\t${symbol}\t${pairs}\n")
        string(FIND "${baseline}" "${expected}" position)
        if(position LESS 0)
            message(FATAL_ERROR "Production exact raw record ${record_index} differs")
        endif()
        list(REMOVE_AT cells 0 2)
        list(JOIN cells "\t" mapped)
        string(FIND "${baseline}" "quote\t${mapped}\n" position)
        if(position LESS 0)
            message(FATAL_ERROR "Production mapped Quote ${record_index} differs")
        endif()
    endif()
endforeach()
math(EXPR value_count "${record_count}*8")
foreach(pair IN ITEMS "--max-records;${record_count}" "--max-values;${value_count}" "--max-symbol-units;${symbol_units}")
    list(GET pair 0 option)
    list(GET pair 1 exact_bound)
    math(EXPR short_bound "${exact_bound}-1")
    foreach(bound IN ITEMS "${exact_bound}" "${short_bound}")
        execute_process(COMMAND "${PROGRAM}" --input "${QUOTE_INPUT}" --profile default-quote-v1 "${option}" "${bound}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(bound EQUAL exact_bound)
            if(NOT code EQUAL 0 OR NOT out STREQUAL baseline)
                message(FATAL_ERROR "Exact Quote ${option} budget failed")
            endif()
        elseif(NOT code EQUAL 6 OR out MATCHES "complete\t")
            message(FATAL_ERROR "Quote ${option} excess not rejected")
        endif()
    endforeach()
endforeach()
execute_process(COMMAND "${PROGRAM}" --input "${QUOTE_INPUT}" --profile oracle-sre-v1 RESULT_VARIABLE legacy_code OUTPUT_VARIABLE legacy_out ERROR_VARIABLE legacy_err)
execute_process(COMMAND "${PROGRAM}" --input "${QUOTE_INPUT}" --profile oracle-sre-v1 --diagnostics-version 2 RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT legacy_code EQUAL 4 OR NOT code EQUAL 4 OR NOT out STREQUAL legacy_out OR NOT legacy_err MATCHES "^incomplete\t" OR NOT err MATCHES "\tTYPE\n$")
    message(FATAL_ERROR "Legacy Quote exclusion or opt-in diagnostic changed")
endif()
execute_process(COMMAND "${PROGRAM}" --input "${QUOTE_INPUT}" --profile default-quote-v1 --max-values 0 --diagnostics-version 1 RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 6 OR NOT err MATCHES "^incomplete\t" OR err MATCHES "incomplete-v2")
    message(FATAL_ERROR "Explicit legacy diagnostic grammar")
endif()
message(STATUS "Default Quote CLI checks passed; ${record_count} production records compared")
