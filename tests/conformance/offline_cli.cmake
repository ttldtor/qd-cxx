include("${CMAKE_CURRENT_LIST_DIR}/inspection_cli_common.cmake")
inspection_hashes(before "${FIXTURES}")
if(NOT DEFINED MANIFEST)
    set(MANIFEST "${FIXTURES}/designed.json")
endif()
file(SHA256 "${MANIFEST}" manifestBefore)
inspection_manifest("${MANIFEST}" qdcxx-offline-designed-v1)
if(NOT QUICK AND (NOT DEFINED PROCESS_HELPER OR NOT EXISTS "${PROCESS_HELPER}"))
    message(FATAL_ERROR "Native argument helper missing")
endif()
math(EXPR last "${caseCount}-1")
foreach(i RANGE 0 ${last})
    inspection_case(${i} tsv)
endforeach()

set(good "")
inspection_arg(good --profile)
inspection_arg(good oracle-sre-v1)
inspection_arg(good --input)
inspection_arg(good "${FIXTURES}/expected/composed.qtp")
file(SIZE "${FIXTURES}/expected/composed.qtp" size)
math(EXPR boundary "${size}+1")
set(javaSizes)
foreach(size RANGE 1 ${boundary})
    list(APPEND javaSizes ${size})
endforeach()
list(APPEND javaSizes 4096)
if(QUICK)
    set(javaSizes 4096)
endif()
set(first TRUE)
foreach(size IN LISTS javaSizes)
    set(arguments "${good}")
    inspection_arg(arguments --chunk-size)
    inspection_arg(arguments "${size}")
    inspection_run("${arguments}")
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "Java composed process failed: ${code}")
    endif()
    inspection_check(validate tsv 0 "${RUN_DIR}/actual.out" "${RUN_DIR}/actual.err")
    inspection_check(java "${FIXTURES}/expected/offline-inspection.tsv" "${FIXTURES}/expected/composed.qtp" "${RUN_DIR}/actual.out")
    if(first)
        file(COPY_FILE "${RUN_DIR}/actual.out" "${RUN_DIR}/java.out")
        file(SHA256 "${RUN_DIR}/actual.out" baselineHash)
        set(first FALSE)
    endif()
    file(SHA256 "${RUN_DIR}/actual.out" actualHash)
    if(NOT actualHash STREQUAL baselineHash)
        message(FATAL_ERROR "Java chunk output changed")
    endif()
endforeach()

if(NOT QUICK)
    foreach(tail IN ITEMS "[=[--help]=] [=[x]=]" "${good} [=[--bogus]=] [=[1]=]" "${good} [=[--profile]=] [=[oracle-sre-v1]=]" "${good} [=[--max-input]=]"
        "${good} [=[--max-input]=] [=[-1]=]" "${good} [=[--max-input]=] [=[+1]=]" "${good} [=[--max-input]=] [=[1x]=]" "${good} [=[--max-input]=] [=[]=]"
        "${good} [=[--max-input]=] [=[18446744073709551616]=]" "${good} [=[--chunk-size]=] [=[0]=]" "${good} [=[--max-frame]=] [=[18446744073709551615]=]"
        "${good} [=[--chunk-size]=] [=[18446744073709551615]=]" "[=[--profile]=] [=[wrong]=] [=[--input]=] [=[x]=]" "[=[--input]=] [=[x]=]"
        "[=[--profile]=] [=[oracle-sre-v1]=]" "[=[--profile]=] [=[oracle-sre-v1]=] [=[--input]=] [=[-]=]"
        "${good} [=[--max-input]=] [=[1]=] [=[--max-input]=] [=[2]=]" "${good} [=[--max-input=1]=]" "${good} [=[extra]=]")
        inspection_usage("${tail}")
    endforeach()
    inspection_run("[=[--help]=]")
    file(READ "${RUN_DIR}/actual.out" help)
    file(READ "${RUN_DIR}/actual.err" error)
    if(NOT code EQUAL 0 OR NOT error STREQUAL "" OR NOT help MATCHES "^qdcxx-qtp-inspect --profile " OR NOT help MATCHES "--max-output" OR help MATCHES "complete\t")
        message(FATAL_ERROR "Help contract failed")
    endif()
    file(COPY_FILE "${RUN_DIR}/actual.out" "${RUN_DIR}/help.out")
    inspection_run("")
    inspection_check(bytes "${RUN_DIR}/actual.out" "${RUN_DIR}/help.out")
    file(READ "${RUN_DIR}/actual.out" noArguments)
    file(READ "${RUN_DIR}/actual.err" error)
    if(NOT code EQUAL 0 OR NOT noArguments STREQUAL help OR NOT error STREQUAL "")
        message(FATAL_ERROR "No-argument/help mismatch")
    endif()
    foreach(input IN ITEMS "${RUN_DIR}/absent.qtp" "${RUN_DIR}")
        set(arguments "[=[--profile]=] [=[oracle-sre-v1]=] [=[--input]=]")
        inspection_arg(arguments "${input}")
        inspection_run("${arguments}")
        if(NOT code EQUAL 3)
            message(FATAL_ERROR "Missing/directory input exit mismatch")
        endif()
        inspection_check(validate tsv 3 "${RUN_DIR}/actual.out" "${RUN_DIR}/actual.err")
        if(input MATCHES "absent.qtp$")
            file(SIZE "${RUN_DIR}/actual.out" bytes)
            if(NOT bytes EQUAL 0)
                message(FATAL_ERROR "Missing input wrote stdout")
            endif()
        endif()
    endforeach()
    # Exercise the same immutable binary at an awkward path without shell/list interpretation.
    set(awkward "${RUN_DIR}/space ;literal.qtp")
    file(COPY_FILE "${FIXTURES}/expected/composed.qtp" "${awkward}")
    set(arguments "[=[--profile]=] [=[oracle-sre-v1]=] [=[--input]=]")
    inspection_arg(arguments "${awkward}")
    inspection_run("${arguments}")
    file(COPY_FILE "${RUN_DIR}/java.out" "${RUN_DIR}/expected.out")
    file(WRITE "${RUN_DIR}/expected.err" "")
    inspection_exact(tsv 0)
    # The production narrow Windows argv is limited by its active code page.
    # Check Unicode forwarding through the same launcher with a native-argv test helper.
    function(inspection_native_arguments)
        set(PROGRAM "${PROCESS_HELPER}")
        set(arguments "")
        foreach(argument IN ITEMS --argument-probe "" "space Юникод;literal" "\"quoted\"" "trailing\\")
            inspection_arg(arguments "${argument}")
        endforeach()
        inspection_run("${arguments}")
        file(READ "${RUN_DIR}/actual.out" output)
        file(READ "${RUN_DIR}/actual.err" error)
        if(NOT code EQUAL 0 OR NOT output STREQUAL "native arguments preserved" OR NOT error STREQUAL "")
            message(FATAL_ERROR "Native argument forwarding failed: ${code}; ${output}; ${error}")
        endif()
        message(STATUS "native argument forwarding: empty, space, Unicode, semicolon, quote, backslash passed")
    endfunction()
    inspection_native_arguments()
endif()
inspection_hashes(after "${FIXTURES}")
file(SHA256 "${MANIFEST}" manifestAfter)
if(NOT before STREQUAL after OR NOT manifestBefore STREQUAL manifestAfter)
    message(FATAL_ERROR "Read-only fixture/manifest changed")
endif()
message(STATUS "offline: ${caseCount} cases, original schedules and Java boundaries passed; fixtures unchanged")
