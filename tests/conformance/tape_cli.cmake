# Native process checks; no Python or shell quoting dependency.
execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE code OUTPUT_VARIABLE help ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR NOT err STREQUAL "" OR help STREQUAL "")
    message(FATAL_ERROR "No-argument help failed")
endif()
execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE code OUTPUT_VARIABLE explicit_help ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR NOT err STREQUAL "" OR NOT help STREQUAL explicit_help)
    message(FATAL_ERROR "Standalone help differs")
endif()
foreach(args IN ITEMS "--input" "--help;--input;x" "--input;-;--profile;oracle-sre-v1" "--input;x;--profile;wrong" "--input;x;--profile;oracle-sre-v1;--max-input;-1" "--input;x;--profile;oracle-sre-v1;--max-input;18446744073709551616" "--input;x;--profile;oracle-sre-v1;--input;y" "--input;x;--profile;oracle-sre-v1;--chunk-size;0")
    execute_process(COMMAND "${PROGRAM}" ${args} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT code EQUAL 2 OR NOT out STREQUAL "" OR NOT err MATCHES "usage")
        message(FATAL_ERROR "Invalid arguments accepted: ${args}")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" --input "${ROOT}/.work/nonexistent-qdcxx-021-input" --profile oracle-sre-v1 RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 3 OR NOT out STREQUAL "" OR NOT err MATCHES "open")
    message(FATAL_ERROR "Missing input IO contract")
endif()
set(tape "${ROOT}/tests/fixtures/protocol/tape/expected")
foreach(file IN ITEMS constrained.qtp default.qtp text.txt truncated.qtp)
    execute_process(COMMAND "${PROGRAM}" --input "${tape}/${file}" --profile oracle-sre-v1 RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(file STREQUAL "constrained.qtp")
        if(NOT code EQUAL 0 OR NOT err STREQUAL "" OR NOT out MATCHES "complete\t137\t8\t7\t7\t9\n$")
            message(FATAL_ERROR "Unchanged constrained tape failed: ${code}: ${err}")
        endif()
        set(baseline "${out}")
    elseif(file STREQUAL "truncated.qtp")
        if(NOT code EQUAL 5 OR out MATCHES "complete\t")
            message(FATAL_ERROR "Truncated input contract")
        endif()
    elseif(NOT code EQUAL 4 OR out MATCHES "complete\t")
        message(FATAL_ERROR "Excluded original input accepted: ${file}: ${code}")
    endif()
endforeach()
foreach(chunk IN ITEMS 1 2 7 137)
    execute_process(COMMAND "${PROGRAM}" --input "${tape}/constrained.qtp" --profile oracle-sre-v1 --chunk-size "${chunk}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT code EQUAL 0 OR NOT out STREQUAL baseline OR NOT err STREQUAL "")
        message(FATAL_ERROR "Chunk output differs: ${chunk}")
    endif()
endforeach()
string(LENGTH "${baseline}" exact)
math(EXPR short "${exact}-1")
foreach(bound IN ITEMS "${exact}" "${short}" 0)
    execute_process(COMMAND "${PROGRAM}" --input "${tape}/constrained.qtp" --profile oracle-sre-v1 --max-output "${bound}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(bound EQUAL exact)
        if(NOT code EQUAL 0 OR NOT out STREQUAL baseline)
            message(FATAL_ERROR "Exact output budget")
        endif()
    elseif(NOT code EQUAL 6 OR out MATCHES "complete\t")
        message(FATAL_ERROR "Output excess not rejected")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" --input "${tape}/constrained.qtp" --profile oracle-sre-v1 --output-format human RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR NOT err STREQUAL "" OR NOT out MATCHES "DESCRIBE_PROTOCOL" OR NOT out MATCHES "authenticated-footer=no" OR NOT out MATCHES "Complete: bytes=137")
    message(FATAL_ERROR "Human tape contract")
endif()
if(UNIX AND EXISTS /dev/full)
    execute_process(COMMAND "${PROGRAM}" --help OUTPUT_FILE /dev/full ERROR_VARIABLE err RESULT_VARIABLE code)
    if(NOT code EQUAL 3)
        message(FATAL_ERROR "Help output failure ignored")
    endif()
    execute_process(COMMAND "${PROGRAM}" --input "${tape}/constrained.qtp" --profile oracle-sre-v1 OUTPUT_FILE /dev/full ERROR_VARIABLE err RESULT_VARIABLE code)
    if(NOT code EQUAL 3)
        message(FATAL_ERROR "File output failure ignored")
    endif()
endif()
message(STATUS "Tape process checks passed")
