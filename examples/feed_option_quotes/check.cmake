execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT result STREQUAL "0" OR output STREQUAL "" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Help failed: ${result} ${error}")
endif()
execute_process(COMMAND "${PROGRAM}" "${FIXTURE}" ABC 11 --list RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT result STREQUAL "0" OR NOT error STREQUAL "" OR NOT output STREQUAL "call9\nput9\ncall10\nput10\ncall11\nput11\ncall12\nput12\n")
    message(FATAL_ERROR "Unexpected selected symbols: ${result} ${output} ${error}")
endif()
execute_process(COMMAND "${PROGRAM}" "${FIXTURE}" MISSING 11 --list RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT result STREQUAL "1" OR error STREQUAL "")
    message(FATAL_ERROR "Missing chain was not rejected")
endif()
