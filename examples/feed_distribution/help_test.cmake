if(NOT DEFINED PROGRAM)
    message(FATAL_ERROR "PROGRAM is required")
endif()
execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE no_args_code OUTPUT_VARIABLE no_args ERROR_VARIABLE no_args_error TIMEOUT 5)
execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE help_code OUTPUT_VARIABLE help ERROR_VARIABLE help_error TIMEOUT 5)
execute_process(COMMAND "${PROGRAM}" --help-ru RESULT_VARIABLE ru_code OUTPUT_VARIABLE ru ERROR_VARIABLE ru_error TIMEOUT 5)
if(NOT no_args_code STREQUAL "0" OR NOT help_code STREQUAL "0" OR NOT ru_code STREQUAL "0" OR NOT no_args STREQUAL help)
    message(FATAL_ERROR "Offline help failed or differs for no arguments")
endif()
if(NOT no_args_error STREQUAL "" OR NOT help_error STREQUAL "" OR NOT ru_error STREQUAL "")
    message(FATAL_ERROR "Help wrote to stderr")
endif()
foreach(role IN ITEMS source server client)
    if(NOT help MATCHES "${role}" OR NOT ru MATCHES "${role}")
        message(FATAL_ERROR "Help must describe ${role}")
    endif()
    execute_process(COMMAND "${PROGRAM}" "${role}" invalid RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
    if(NOT code STREQUAL "2" OR NOT out STREQUAL "" OR NOT err MATCHES "Invalid arguments")
        message(FATAL_ERROR "Invalid ${role} arguments were not rejected before work")
    endif()
endforeach()
