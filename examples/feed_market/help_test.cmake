if(NOT DEFINED PROGRAM)
    message(FATAL_ERROR "PROGRAM is required")
endif()
execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE no_args_result OUTPUT_VARIABLE no_args ERROR_VARIABLE no_args_error TIMEOUT 5)
execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE help_result OUTPUT_VARIABLE help ERROR_VARIABLE help_error TIMEOUT 5)
execute_process(COMMAND "${PROGRAM}" --help-ru RESULT_VARIABLE ru_result OUTPUT_VARIABLE ru ERROR_VARIABLE ru_error TIMEOUT 5)
if(NOT no_args_result EQUAL 0 OR NOT help_result EQUAL 0 OR NOT ru_result EQUAL 0 OR NOT no_args STREQUAL help)
    message(FATAL_ERROR "Offline help failed or no-argument help differs")
endif()
if(NOT no_args_error STREQUAL "" OR NOT help_error STREQUAL "" OR NOT ru_error STREQUAL "")
    message(FATAL_ERROR "Help wrote to stderr")
endif()
if(NOT help MATCHES "--duration-ms" OR NOT ru MATCHES "--duration-ms")
    message(FATAL_ERROR "Duration option is absent from help")
endif()
foreach(value IN ITEMS 0 1 600001 invalid)
    execute_process(COMMAND "${PROGRAM}" --run --duration-ms "${value}" RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT result EQUAL 2 OR NOT error MATCHES "Invalid duration")
        message(FATAL_ERROR "Invalid duration ${value} was not rejected before connection: ${result}")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" --run --address RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
    TIMEOUT 5)
if(NOT result EQUAL 2 OR NOT error MATCHES "Invalid arguments")
    message(FATAL_ERROR "Missing address was not rejected before connection: ${result}")
endif()
foreach(address IN ITEMS "--help" "127.0.0.1" "127.0.0.1:65536" "127.0.0.1:7300[aggregationPeriod=1s]")
    execute_process(COMMAND "${PROGRAM}" --run --address "${address}" RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT result EQUAL 2 OR NOT error MATCHES "Invalid address")
        message(FATAL_ERROR "Malformed address was not rejected before connection: ${result}")
    endif()
endforeach()
