if(NOT DEFINED PROGRAM)
    message(FATAL_ERROR "PROGRAM is required")
endif()
foreach(arg IN ITEMS "" "--help" "--help-ru")
    if(arg STREQUAL "")
        execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    else()
        execute_process(COMMAND "${PROGRAM}" "${arg}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    endif()
    if(NOT result EQUAL 0 OR output STREQUAL "" OR NOT error STREQUAL "")
        message(FATAL_ERROR "Offline help failed: ${arg} ${result} ${error}")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" --unknown RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT result EQUAL 2 OR NOT error MATCHES "Invalid arguments")
    message(FATAL_ERROR "Invalid arguments not rejected: ${result}")
endif()
foreach(pair IN ITEMS "bad;100" "100;bad" "200;100")
    list(GET pair 0 from)
    list(GET pair 1 to)
    execute_process(COMMAND "${PROGRAM}" --run 127.0.0.1:1 127.0.0.1:1 "${from}" "${to}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT result EQUAL 2 OR NOT error MATCHES "Invalid time range")
        message(FATAL_ERROR "Invalid time range was not rejected before network work: ${pair} ${result}")
    endif()
endforeach()
