if(NOT DEFINED PROGRAM)
    message(FATAL_ERROR "PROGRAM is required")
endif()

foreach(argument IN ITEMS none --help --help-ru)
    set(command "${PROGRAM}")
    if(NOT argument STREQUAL "none")
        list(APPEND command "${argument}")
    endif()
    execute_process(COMMAND ${command} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT result STREQUAL "0" OR output STREQUAL "" OR NOT error STREQUAL "")
        message(FATAL_ERROR "Offline help failed: ${argument}: ${result}: ${error}")
    endif()
    if(argument STREQUAL "none")
        set(default_output "${output}")
    elseif(argument STREQUAL "--help" AND NOT output STREQUAL default_output)
        message(FATAL_ERROR "No arguments and --help returned different output")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" --unknown RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
    TIMEOUT 5)
if(NOT result STREQUAL "2" OR NOT output STREQUAL "" OR error STREQUAL "")
    message(FATAL_ERROR "Invalid argument did not receive a usage diagnostic: ${result}")
endif()
