execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE result OUTPUT_VARIABLE default_help ERROR_VARIABLE error TIMEOUT 5)
if(NOT result STREQUAL "0" OR default_help STREQUAL "" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Input-free help failed")
endif()
foreach(argument IN ITEMS --help)
    execute_process(COMMAND "${PROGRAM}" "${argument}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
        TIMEOUT 5)
    if(NOT result STREQUAL "0" OR output STREQUAL "" OR NOT error STREQUAL "")
        message(FATAL_ERROR "Help failed: ${argument}")
    endif()
    if(argument STREQUAL "--help" AND NOT output STREQUAL default_help)
        message(FATAL_ERROR "No-argument help differs from --help")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" --unknown RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT result STREQUAL "2" OR NOT output STREQUAL "" OR error STREQUAL "")
    message(FATAL_ERROR "Invalid arguments failed")
endif()
execute_process(COMMAND "${PROGRAM}" "${FIXTURE}" ABC RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
    TIMEOUT 5)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT result STREQUAL "0" OR NOT error STREQUAL "" OR NOT output STREQUAL "ABC series=1\ncalls=1 puts=1 strikes: 10\n")
    message(FATAL_ERROR "Unexpected option chain: ${result} ${output} ${error}")
endif()
