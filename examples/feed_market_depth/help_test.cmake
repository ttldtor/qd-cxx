execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT result EQUAL 0 OR NOT output MATCHES "--duration-ms" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Offline help failed")
endif()
execute_process(COMMAND "${PROGRAM}" --run --duration-ms 0 RESULT_VARIABLE result TIMEOUT 5)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "Invalid duration was not rejected")
endif()
execute_process(COMMAND "${PROGRAM}" --run --source "BAD!" RESULT_VARIABLE result TIMEOUT 5)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "Invalid source was not rejected")
endif()
execute_process(COMMAND "${PROGRAM}" --run --address invalid RESULT_VARIABLE result TIMEOUT 5)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "Invalid address was not rejected")
endif()
