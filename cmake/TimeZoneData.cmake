# Internal caller: backend-enabled qdcxx_time_zone_data target. Inputs: exact tracked sources/data/manifests.
# Output: checked native sources and embedded approved-byte backing. Mismatches fail before compilation.
# No executable, acquisition, ambient SDK discovery or runtime configuration is performed here.
function(qdcxx_time_zone_byte_array output encoded)
    # Keep compiler input lines finite while transforming each fixed source file in bulk.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," initializer "${encoded}")
    string(REPEAT "0x[0-9a-f][0-9a-f]," 32 row_pattern)
    string(REGEX REPLACE "(${row_pattern})" "\\1\n" initializer "${initializer}")
    set(${output} "${initializer}" PARENT_SCOPE)
endfunction()

function(qdcxx_time_zone_data target)
    set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    set(vendor "${root}/third_party/schedule-date-3.0.5")
    set(data "${root}/resources/time-zone-data/tzdb-2026f")
    file(READ "${vendor}/manifest.json" provider_manifest)
    foreach(binding IN ITEMS "LICENSE.txt;licenseSha256" "patches/controlled-profile.patch;patchSha256")
        list(GET binding 0 path)
        list(GET binding 1 key)
        string(JSON expected GET "${provider_manifest}" "${key}")
        file(SHA256 "${vendor}/${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Timezone dependency license/patch differs from manifest: ${path}")
        endif()
    endforeach()
    string(JSON provider_version GET "${provider_manifest}" version)
    string(JSON provider_commit GET "${provider_manifest}" commit)
    string(JSON provider_namespace GET "${provider_manifest}" privateNamespace)
    if(NOT provider_version STREQUAL "3.0.5" OR NOT provider_commit STREQUAL "179a6b921ccd6179b5b04dce812a89f71a51b4df"
       OR NOT provider_namespace STREQUAL "org_ttldtor_qdcxx_date_305_v1")
        message(FATAL_ERROR "Unsupported timezone provider profile")
    endif()
    string(JSON source_count LENGTH "${provider_manifest}" sources)
    if(NOT source_count EQUAL 4)
        message(FATAL_ERROR "Timezone provider requires four pinned source files")
    endif()
    foreach(index RANGE 0 3)
        string(JSON path GET "${provider_manifest}" sources ${index} path)
        string(JSON expected_hash GET "${provider_manifest}" sources ${index} sha256)
        file(SHA256 "${vendor}/${path}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "Timezone provider source differs from manifest: ${path}")
        endif()
    endforeach()
    file(READ "${data}/manifest.json" data_manifest)
    string(JSON expected_license GET "${data_manifest}" licenseSha256)
    file(SHA256 "${data}/LICENSE" actual_license)
    if(NOT actual_license STREQUAL expected_license)
        message(FATAL_ERROR "Timezone data license differs from manifest")
    endif()
    string(JSON data_version GET "${data_manifest}" version)
    string(JSON file_count LENGTH "${data_manifest}" files)
    if(NOT data_version STREQUAL "2026f" OR NOT file_count EQUAL 11)
        message(FATAL_ERROR "Unsupported timezone data profile")
    endif()
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated/time-zone-data/approved_tzdata.cpp")
    set(source "// Generated from exact tracked timezone bytes; no runtime discovery.\n#include \"snapshot.hpp\"\nnamespace org::ttldtor::qdcxx::time::detail::provider::input {\n")
    set(entries "")
    set(total_bytes 0)
    set(data_files "")
    foreach(index RANGE 0 10)
        string(JSON path GET "${data_manifest}" files ${index} path)
        string(JSON expected_hash GET "${data_manifest}" files ${index} sha256)
        string(JSON expected_size GET "${data_manifest}" files ${index} bytes)
        if(NOT path MATCHES "^(africa|antarctica|asia|australasia|backward|etcetera|europe|northamerica|southamerica|leapseconds|version)$")
            message(FATAL_ERROR "Unexpected file in fixed timezone profile")
        endif()
        file(SHA256 "${data}/${path}" actual_hash)
        file(SIZE "${data}/${path}" actual_size)
        if(NOT actual_hash STREQUAL expected_hash OR NOT actual_size EQUAL expected_size)
            message(FATAL_ERROR "Timezone data differs from manifest: ${path}")
        endif()
        math(EXPR total_bytes "${total_bytes} + ${actual_size}")
        list(APPEND data_files "${data}/${path}")
        file(READ "${data}/${path}" encoded HEX)
        string(APPEND source "static const unsigned char DATA_${index}[] = {\n")
        # Transform each fixed file in bulk; per-byte CMake mutations copy a growing megabyte string.
        qdcxx_time_zone_byte_array(initializer "${encoded}")
        string(APPEND source "${initializer}")
        string(APPEND source "\n};\n")
        string(APPEND entries "{\"${path}\", DATA_${index}, sizeof(DATA_${index})},\n")
    endforeach()
    if(NOT total_bytes EQUAL 855823)
        message(FATAL_ERROR "Timezone fixed snapshot size changed")
    endif()
    string(APPEND source "const FileBytes APPROVED_FILES[] = {\n${entries}};\nconst std::size_t APPROVED_FILE_COUNT = 11;\n}\n")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated/time-zone-data")
    file(WRITE "${generated}.tmp" "${source}")
    configure_file("${generated}.tmp" "${generated}" COPYONLY)
    file(REMOVE "${generated}.tmp")
    target_sources(${target} PRIVATE "${vendor}/src/tz.cpp" "${generated}"
        "${root}/src/time/timezone/provider.cpp")
    target_include_directories(${target} PRIVATE "${vendor}/include" "${root}/src/time/timezone" "${CMAKE_CURRENT_BINARY_DIR}/generated/time-zone-data")
    target_compile_definitions(${target} PRIVATE USE_OS_TZDB=0 HAS_REMOTE_API=0 AUTO_DOWNLOAD=0 INSTALL=explicit_only)
    if(WIN32)
        target_link_libraries(${target} PRIVATE shell32 ole32 advapi32)
    endif()
    install(FILES ${data_files} "${data}/manifest.json" "${data}/LICENSE"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/qdcxx/time-zone-data/tzdb-2026f")
    install(FILES "${root}/resources/schedule/java8-zone-ids.txt" "${root}/resources/time-zone-data/calendar-offset-conventions.json"
        "${root}/resources/time-zone-data/java8-zone-metadata.tsv" "${root}/resources/time-zone-data/java8-systemv-transitions.tsv"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/qdcxx/time-zone-data")
    install(FILES "${vendor}/LICENSE.txt" "${vendor}/manifest.json"
        "${vendor}/src/tz.cpp" "${vendor}/include/date/date.h" "${vendor}/include/date/tz.h"
        "${vendor}/include/date/tz_private.h" "${vendor}/patches/controlled-profile.patch"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/qdcxx/time-zone-data/date-3.0.5-notices")
endfunction()
