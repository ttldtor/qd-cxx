# Internal caller: the selected schedule target in CMakeLists.txt.
# Inputs: tracked calendar/identity resources and their manifest. Output: a private embedded header.
# Hash/count/order mismatches fail configuration; no acquisition, executable or ambient lookup is used.
function(qdcxx_schedule_data output_file)
    set(resource_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../resources/schedule")
    file(READ "${resource_root}/manifest.json" manifest)
    string(JSON schema_version GET "${manifest}" schemaVersion)
    if(NOT schema_version EQUAL 1)
        message(FATAL_ERROR "Unsupported schedule resource manifest version")
    endif()
    string(JSON calendar_hash GET "${manifest}" calendar sha256)
    string(JSON calendar_size GET "${manifest}" calendar bytes)
    string(JSON calendar_version GET "${manifest}" calendar versionMillis)
    string(JSON calendar_date GET "${manifest}" calendar dateText)
    string(JSON identity_hash GET "${manifest}" zoneIdentityProfile sha256)
    string(JSON identity_count GET "${manifest}" zoneIdentityProfile namedIds)
    file(SHA256 "${resource_root}/schedule.properties" actual_calendar_hash)
    file(SIZE "${resource_root}/schedule.properties" actual_calendar_size)
    file(SHA256 "${resource_root}/java8-zone-ids.txt" actual_identity_hash)
    if(NOT actual_calendar_hash STREQUAL calendar_hash OR NOT actual_calendar_size EQUAL calendar_size
       OR NOT actual_identity_hash STREQUAL identity_hash)
        message(FATAL_ERROR "Schedule calendar/identity bytes differ from their pinned manifest")
    endif()
    file(STRINGS "${resource_root}/java8-zone-ids.txt" identities ENCODING UTF-8)
    list(LENGTH identities actual_identity_count)
    set(sorted_identities "${identities}")
    list(SORT sorted_identities COMPARE STRING CASE SENSITIVE ORDER ASCENDING)
    list(REMOVE_DUPLICATES sorted_identities)
    if(NOT "${identities}" STREQUAL "${sorted_identities}" OR NOT actual_identity_count EQUAL identity_count)
        message(FATAL_ERROR "Schedule identity profile must be complete, sorted and unique")
    endif()
    set(header "// Generated from exact tracked schedule resources; do not edit.\n#pragma once\n#include <array>\n#include <cstdint>\n#include <string_view>\nnamespace org::ttldtor::qdcxx::schedule::detail::data {\n")
    string(APPEND header "inline constexpr std::int64_t CALENDAR_VERSION_MILLIS = ${calendar_version}LL;\n")
    string(APPEND header "inline constexpr std::u16string_view CALENDAR_DATE_TEXT = u\"${calendar_date}\";\n")
    string(APPEND header "inline constexpr std::array<std::u16string_view, ${identity_count}> ZONE_IDS = {\n")
    foreach(identity IN LISTS identities)
        if(NOT identity MATCHES "^[A-Za-z0-9_+./-]+$")
            message(FATAL_ERROR "Unsupported code unit in the pinned schedule identity profile")
        endif()
        string(APPEND header "u\"${identity}\",\n")
    endforeach()
    string(APPEND header "};\ninline constexpr unsigned char CALENDAR_BYTES[] = {\n")
    file(READ "${resource_root}/schedule.properties" encoded HEX)
    string(REGEX MATCHALL ".." byte_tokens "${encoded}")
    set(column 0)
    foreach(byte IN LISTS byte_tokens)
        string(APPEND header "0x${byte},")
        math(EXPR column "${column} + 1")
        if(column EQUAL 32)
            string(APPEND header "\n")
            set(column 0)
        endif()
    endforeach()
    string(APPEND header "\n};\n}\n")
    get_filename_component(output_directory "${output_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_directory}")
    file(WRITE "${output_file}.tmp" "${header}")
    configure_file("${output_file}.tmp" "${output_file}" COPYONLY)
    file(REMOVE "${output_file}.tmp")
endfunction()
