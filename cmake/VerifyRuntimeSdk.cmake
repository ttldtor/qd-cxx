# Internal caller: Runtime.cmake, only when runtime is enabled.
# Inputs: reviewed source manifest, explicit SDK root and optional exact subtree.
# Result: all source hashes and the selected file set verified; any mismatch is a fatal configure error.
# No acquisition, SDK execution, environment mutation or source writes occur.
function(qdcxxVerifyRuntimeSdk manifest sdkRoot exactSubtree)
    file(READ "${manifest}" profile)
    string(JSON schema GET "${profile}" schemaVersion)
    if(NOT schema EQUAL 1)
        message(FATAL_ERROR "Unsupported runtime SDK source-manifest schema")
    endif()
    file(REAL_PATH "${sdkRoot}" root)
    string(JSON count LENGTH "${profile}" files)
    if(count LESS 1 OR count GREATER 20000)
        message(FATAL_ERROR "Invalid runtime SDK source-manifest file count")
    endif()
    set(expectedFiles)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON relative GET "${profile}" files ${index} path)
        string(JSON expectedHash GET "${profile}" files ${index} sha256)
        if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)|[;\\\\\r\n]" OR relative STREQUAL "")
            message(FATAL_ERROR "Invalid relative runtime SDK source path in manifest")
        endif()
        if(NOT EXISTS "${root}/${relative}" OR IS_DIRECTORY "${root}/${relative}")
            message(FATAL_ERROR "Missing pinned runtime SDK source: ${relative}")
        endif()
        file(REAL_PATH "${root}/${relative}" resolved)
        string(FIND "${resolved}" "${root}/" prefix)
        if(NOT prefix EQUAL 0)
            message(FATAL_ERROR "Runtime SDK source resolves outside its explicit root: ${relative}")
        endif()
        file(SHA256 "${resolved}" actualHash)
        if(NOT actualHash STREQUAL expectedHash)
            message(FATAL_ERROR "Pinned runtime SDK source hash mismatch: ${relative}")
        endif()
        if(exactSubtree STREQUAL "" OR relative MATCHES "^${exactSubtree}/")
            list(APPEND expectedFiles "${relative}")
        endif()
    endforeach()
    if(exactSubtree STREQUAL "")
        file(GLOB_RECURSE actualFiles LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/*")
    else()
        file(GLOB_RECURSE actualFiles LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/${exactSubtree}/*")
    endif()
    list(SORT expectedFiles)
    list(SORT actualFiles)
    if(NOT actualFiles STREQUAL expectedFiles)
        message(FATAL_ERROR "Pinned runtime SDK source file set mismatch under ${exactSubtree}")
    endif()
    message(STATUS "Verified ${count} pinned runtime SDK source/license files")
endfunction()
