# Internal callers: Tls.cmake and the installed qdcxx package configuration.
# Inputs: immutable profile metadata, platform key and explicit read-only SDK root.
# Result: exact relative file inventory and hashes verified, or a fatal configure error.
# No source execution, acquisition, environment mutation or SDK writes occur.

# Internal callers: producer TLS configure and installed consumers, before SDK import.
# The Windows qualification requires the dynamic release CRT (/MD). Reject explicit unsupported
# runtime selections and compile-check the effective preprocessor profile, including flag overrides.
function(qdcxxCheckTlsHost platform)
    if(platform STREQUAL "windows-x64")
        if(NOT WIN32 OR NOT MSVC OR NOT MSVC_VERSION EQUAL 1942 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
            message(FATAL_ERROR "The qualified TLS host requires MSVC 19.42 and Windows x64")
        endif()
        if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "" AND
            NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDLL" AND
            NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
            message(FATAL_ERROR "The qualified TLS host requires the dynamic release CRT (/MD), not a static/debug CRT")
        endif()
        if(CMAKE_CONFIGURATION_TYPES)
            message(FATAL_ERROR "The initial qualified Windows TLS profile requires a single-configuration generator")
        endif()
        # A try_compile otherwise defaults to Debug even for a Release Ninja producer/consumer.
        # Empty single-config builds use the same release runtime selection as this Release probe.
        if(CMAKE_BUILD_TYPE STREQUAL "")
            set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
        else()
            set(CMAKE_TRY_COMPILE_CONFIGURATION "${CMAKE_BUILD_TYPE}")
        endif()
        include(CheckCXXSourceCompiles)
        unset(ORG_TTLDTOR_QDCXX_TLS_DYNAMIC_RELEASE_CRT CACHE)
        unset(ORG_TTLDTOR_QDCXX_TLS_DYNAMIC_RELEASE_CRT)
        check_cxx_source_compiles("\
#if !defined(_M_X64) || !defined(_MT) || !defined(_DLL) || defined(_DEBUG)\n\
# error The qualified TLS host requires Windows x64 and the dynamic release CRT\n\
#endif\n\
int main() { return 0; }\n" ORG_TTLDTOR_QDCXX_TLS_DYNAMIC_RELEASE_CRT)
        if(NOT ORG_TTLDTOR_QDCXX_TLS_DYNAMIC_RELEASE_CRT)
            message(FATAL_ERROR "The effective TLS consumer compiler flags must select Windows x64 and /MD")
        endif()
    elseif(platform STREQUAL "linux-x64")
        if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR
            NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL 13.3.0 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR
            NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
            message(FATAL_ERROR "The qualified TLS host requires GCC 13.3 and Linux x86-64")
        endif()
    else()
        message(FATAL_ERROR "Unsupported qualified TLS host platform")
    endif()
endfunction()

function(qdcxxVerifyTlsFiles manifest expectedHash expectedCount sdkRoot)
    if(NOT IS_DIRECTORY "${sdkRoot}" OR NOT EXISTS "${manifest}")
        message(FATAL_ERROR "Provide the explicit qualified TLS SDK root and packaged manifest")
    endif()
    file(SHA256 "${manifest}" actualManifestHash)
    if(NOT actualManifestHash STREQUAL expectedHash)
        message(FATAL_ERROR "TLS qualification manifest hash mismatch")
    endif()
    file(REAL_PATH "${sdkRoot}" root)
    file(STRINGS "${manifest}" entries ENCODING UTF-8)
    list(LENGTH entries count)
    if(NOT count EQUAL expectedCount OR count LESS 1 OR count GREATER 20000)
        message(FATAL_ERROR "TLS qualification manifest file count mismatch")
    endif()
    set(expectedFiles)
    foreach(entry IN LISTS entries)
        string(FIND "${entry}" "\t" separator)
        if(NOT separator EQUAL 64)
            message(FATAL_ERROR "Invalid TLS qualification manifest row")
        endif()
        string(SUBSTRING "${entry}" 0 64 hash)
        string(SUBSTRING "${entry}" 65 -1 relative)
        if(NOT hash MATCHES "^[0-9a-f]+$" OR IS_ABSOLUTE "${relative}" OR
            relative MATCHES "(^|/)\\.\\.?(/|$)|[;\\\\:\t\r\n]|//|^/|/$" OR relative STREQUAL "")
            message(FATAL_ERROR "Invalid relative TLS qualification path or hash")
        endif()
        if(NOT EXISTS "${root}/${relative}" OR IS_DIRECTORY "${root}/${relative}" OR IS_SYMLINK "${root}/${relative}")
            message(FATAL_ERROR "Missing qualified TLS SDK file: ${relative}")
        endif()
        file(REAL_PATH "${root}/${relative}" resolved)
        string(FIND "${resolved}" "${root}/" prefix)
        if(NOT prefix EQUAL 0)
            message(FATAL_ERROR "TLS SDK file resolves outside the explicit root: ${relative}")
        endif()
        file(SHA256 "${resolved}" actual)
        if(NOT actual STREQUAL hash)
            message(FATAL_ERROR "Qualified TLS SDK file hash mismatch: ${relative}")
        endif()
        list(APPEND expectedFiles "${relative}")
    endforeach()
    file(GLOB_RECURSE actualFiles LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/*")
    list(SORT expectedFiles)
    list(REMOVE_DUPLICATES expectedFiles)
    list(LENGTH expectedFiles uniqueCount)
    list(SORT actualFiles)
    if(NOT uniqueCount EQUAL expectedCount OR NOT actualFiles STREQUAL expectedFiles)
        message(FATAL_ERROR "Qualified TLS SDK exact file inventory mismatch")
    endif()
    message(STATUS "Verified ${count} qualified TLS SDK files")
endfunction()

# Internal caller: explicit TLS build/package setup. The profile has separate source and installed
# platform manifests; installed consumers verify their SDK, without requiring a source checkout.
function(qdcxxVerifyTlsProfile profile platform sdkRoot)
    file(READ "${profile}" metadata)
    string(JSON revision GET "${metadata}" schemaVersion)
    string(JSON identity GET "${metadata}" profileId)
    if(NOT revision EQUAL 1 OR NOT identity STREQUAL "openssl-3.5.9-controlled-static-v1")
        message(FATAL_ERROR "Unsupported TLS qualification profile")
    endif()
    if(platform STREQUAL "source")
        string(JSON manifest GET "${metadata}" source manifest file)
        string(JSON hash GET "${metadata}" source manifest sha256)
        string(JSON count GET "${metadata}" source manifest regularFileCount)
    else()
        string(JSON manifest GET "${metadata}" platforms "${platform}" manifest file)
        string(JSON hash GET "${metadata}" platforms "${platform}" manifest sha256)
        string(JSON count GET "${metadata}" platforms "${platform}" manifest regularFileCount)
    endif()
    if(IS_ABSOLUTE "${manifest}" OR manifest MATCHES "[/\\\\;:]" OR manifest STREQUAL "")
        message(FATAL_ERROR "Invalid TLS manifest filename")
    endif()
    get_filename_component(directory "${profile}" DIRECTORY)
    qdcxxVerifyTlsFiles("${directory}/${manifest}" "${hash}" "${count}" "${sdkRoot}")
endfunction()

# Internal caller: explicit TLS build/package setup, after full qualification verification.
# Result: fixed SDK imported targets only; no ambient find_package, registry or package search.
function(qdcxxImportTlsSdk sdkRoot platform)
    file(REAL_PATH "${sdkRoot}" sdkRoot)
    if(platform STREQUAL "windows-x64")
        set(ssl "${sdkRoot}/lib/libssl.lib")
        set(crypto "${sdkRoot}/lib/libcrypto.lib")
        set(native crypt32 bcrypt ws2_32)
    elseif(platform STREQUAL "linux-x64")
        set(ssl "${sdkRoot}/lib64/libssl.a")
        set(crypto "${sdkRoot}/lib64/libcrypto.a")
        set(native Threads::Threads "${CMAKE_DL_LIBS}")
    else()
        message(FATAL_ERROR "Unsupported TLS SDK platform")
    endif()
    foreach(target qdcxx_tls_crypto qdcxx_tls_ssl)
        if(target STREQUAL "qdcxx_tls_crypto")
            set(location "${crypto}")
            set(dependencies "${native}")
        else()
            set(location "${ssl}")
            set(dependencies qdcxx_tls_crypto)
        endif()
        if(TARGET "${target}")
            # Repeated find_package is valid only for the identical already-qualified import.
            # Reject a conflicting target instead of rewriting another owner's linkage or SDK path.
            get_target_property(imported "${target}" IMPORTED)
            get_target_property(type "${target}" TYPE)
            get_target_property(actualLocation "${target}" IMPORTED_LOCATION)
            get_target_property(actualIncludes "${target}" INTERFACE_INCLUDE_DIRECTORIES)
            get_target_property(actualDependencies "${target}" INTERFACE_LINK_LIBRARIES)
            get_property(hasConfigurations TARGET "${target}" PROPERTY IMPORTED_CONFIGURATIONS SET)
            if(NOT imported OR NOT type STREQUAL "STATIC_LIBRARY" OR NOT actualLocation STREQUAL location OR
                NOT actualIncludes STREQUAL "${sdkRoot}/include" OR NOT actualDependencies STREQUAL dependencies OR
                hasConfigurations)
                message(FATAL_ERROR "A conflicting qualified TLS SDK target already exists: ${target}")
            endif()
            set(configurations DEBUG RELEASE RELWITHDEBINFO MINSIZEREL NOCONFIG)
            if(NOT CMAKE_BUILD_TYPE STREQUAL "")
                string(TOUPPER "${CMAKE_BUILD_TYPE}" selectedConfiguration)
                list(APPEND configurations "${selectedConfiguration}")
            endif()
            foreach(configuration IN LISTS configurations)
                foreach(property IMPORTED_LOCATION IMPORTED_IMPLIB IMPORTED_LINK_INTERFACE_LIBRARIES MAP_IMPORTED_CONFIG)
                    get_property(hasOverride TARGET "${target}" PROPERTY "${property}_${configuration}" SET)
                    if(hasOverride)
                        message(FATAL_ERROR "A conflicting qualified TLS SDK configuration override exists: ${target}")
                    endif()
                endforeach()
            endforeach()
        else()
            add_library("${target}" STATIC IMPORTED GLOBAL)
            set_target_properties("${target}" PROPERTIES IMPORTED_LOCATION "${location}"
                INTERFACE_INCLUDE_DIRECTORIES "${sdkRoot}/include" INTERFACE_LINK_LIBRARIES "${dependencies}")
        endif()
    endforeach()
endfunction()
