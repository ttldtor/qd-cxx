if(NOT ORG_TTLDTOR_QDCXX_BUILD_CLIENT OR NOT ORG_TTLDTOR_QDCXX_BUILD_RUNTIME)
    message(FATAL_ERROR "BUILD_TLS requires explicit BUILD_CLIENT=ON and BUILD_RUNTIME=ON")
endif()
if(BUILD_SHARED_LIBS)
    message(FATAL_ERROR "The initial qualified TLS profile supports static qdcxx libraries only")
endif()
set(ORG_TTLDTOR_QDCXX_OPENSSL_ROOT "" CACHE PATH "Explicit exact qualified static OpenSSL installation")
set(ORG_TTLDTOR_QDCXX_OPENSSL_SOURCE "" CACHE PATH "Explicit exact qualified OpenSSL source tree")
if(WIN32)
    if(NOT MSVC OR NOT MSVC_VERSION EQUAL 1942)
        message(FATAL_ERROR "The qualified TLS profile requires MSVC 19.42 on Windows x64")
    endif()
    set(qdcxxTlsPlatform windows-x64)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL 13.3.0)
        message(FATAL_ERROR "The qualified TLS profile requires GCC 13.3 on Linux x86-64")
    endif()
    set(qdcxxTlsPlatform linux-x64)
else()
    message(FATAL_ERROR "The initial qualified TLS profile supports Windows x64 and Linux x86-64 only")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VerifyTlsSdk.cmake")
qdcxxCheckTlsHost("${qdcxxTlsPlatform}")
set(qdcxxTlsProfile "${CMAKE_CURRENT_LIST_DIR}/tls-profile/openssl-3.5.9.json")
qdcxxVerifyTlsProfile("${qdcxxTlsProfile}" source "${ORG_TTLDTOR_QDCXX_OPENSSL_SOURCE}")
qdcxxVerifyTlsProfile("${qdcxxTlsProfile}" "${qdcxxTlsPlatform}" "${ORG_TTLDTOR_QDCXX_OPENSSL_ROOT}")
qdcxxImportTlsSdk("${ORG_TTLDTOR_QDCXX_OPENSSL_ROOT}" "${qdcxxTlsPlatform}")

add_library(qdcxx_tls src/transport/tls_resources.cpp src/transport/tls_policy.cpp
    src/transport/tls_engine.cpp src/transport/tls_runtime.cpp src/transport/tls_byte_owner.cpp)
target_link_libraries(qdcxx_tls PUBLIC qdcxx_transport qdcxx_client PRIVATE qdcxx_tls_ssl qdcxx_tls_crypto)
target_include_directories(qdcxx_tls SYSTEM PRIVATE "${ORG_TTLDTOR_QDCXX_ASIO_INCLUDE}")
target_link_libraries(qdcxx_tls PRIVATE "$<BUILD_INTERFACE:c-ares::cares>")
target_compile_definitions(qdcxx_tls PRIVATE ASIO_STANDALONE ASIO_NO_DEPRECATED)
set_target_properties(qdcxx_tls PROPERTIES CXX_EXTENSIONS OFF)
if(WIN32)
    target_compile_definitions(qdcxx_tls PRIVATE _WIN32_WINNT=0x0A00 WINVER=0x0A00 NOMINMAX WIN32_LEAN_AND_MEAN)
endif()
install(TARGETS qdcxx_tls EXPORT qdcxxTargets ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}")
install(FILES include/qd/transport/tls_runtime.hpp include/qd/transport/tls_resources.hpp
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/qd/transport")
install(FILES "${CMAKE_CURRENT_LIST_DIR}/VerifyTlsSdk.cmake" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/qdcxx")
install(DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/tls-profile" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/qdcxx")
install(FILES "${ORG_TTLDTOR_QDCXX_OPENSSL_SOURCE}/LICENSE.txt"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/qdcxx/licenses" RENAME OpenSSL-Apache-2.0.txt)
