# Internal callers: explicit Boost source provisioner, static SDK builder and sealed consumer.
# Inputs: pinned manifest and source tree. Output: exact verified file inventory or fatal error.
# No acquisition, source execution or writes occur.
function(qdcxxVerifyIpfTransferSources manifest sourceRoot)
    file(READ "${manifest}" profile)
    string(JSON count LENGTH "${profile}" files)
    if(count LESS 1 OR count GREATER 40000)
        message(FATAL_ERROR "QDCXX_IPF_SOURCE: invalid manifest count")
    endif()
    file(REAL_PATH "${sourceRoot}" root)
    set(expectedFiles)
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        string(JSON relative GET "${profile}" files ${index} path)
        string(JSON expected GET "${profile}" files ${index} sha256)
        if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.?(/|$)|[;\\\\:\t\r\n]|//|^/|/$" OR relative STREQUAL "")
            message(FATAL_ERROR "QDCXX_IPF_SOURCE: invalid manifest path")
        endif()
        if(NOT EXISTS "${root}/${relative}" OR IS_DIRECTORY "${root}/${relative}" OR IS_SYMLINK "${root}/${relative}")
            message(FATAL_ERROR "QDCXX_IPF_SOURCE: missing/nonregular source ${relative}")
        endif()
        file(REAL_PATH "${root}/${relative}" resolved)
        string(FIND "${resolved}" "${root}/" prefix)
        if(NOT prefix EQUAL 0)
            message(FATAL_ERROR "QDCXX_IPF_SOURCE: redirected source ${relative}")
        endif()
        file(SHA256 "${resolved}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "QDCXX_IPF_SOURCE: source hash mismatch: ${relative}")
        endif()
        list(APPEND expectedFiles "${relative}")
    endforeach()
    file(GLOB_RECURSE actualFiles LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/*")
    list(SORT expectedFiles)
    list(SORT actualFiles)
    if(NOT actualFiles STREQUAL expectedFiles)
        message(FATAL_ERROR "QDCXX_IPF_SOURCE: exact source inventory mismatch")
    endif()
    message(STATUS "Verified ${count} pinned IPF transfer source/license files")
endfunction()

# The exact supported compiler/CRT/sanitizer profiles are deliberately finite.
function(qdcxxCheckIpfTransferHost)
    if(CMAKE_CONFIGURATION_TYPES OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "QDCXX_IPF_HOST: single-configuration x64 build required")
    endif()
    if(WIN32)
        if(NOT MSVC OR NOT MSVC_VERSION EQUAL 1942 OR NOT CMAKE_BUILD_TYPE STREQUAL "Release")
            message(FATAL_ERROR "QDCXX_IPF_HOST: Windows MSVC 19.42 x64 Release/MD required")
        endif()
        set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
        include(CheckCXXSourceCompiles)
        unset(ORG_TTLDTOR_QDCXX_IPF_RELEASE_CRT CACHE)
        check_cxx_source_compiles("\n#if !defined(_M_X64) || !defined(_MT) || !defined(_DLL) || defined(_DEBUG)\n#error Windows x64 /MD required\n#endif\nint main(){return 0;}" ORG_TTLDTOR_QDCXX_IPF_RELEASE_CRT)
        if(NOT ORG_TTLDTOR_QDCXX_IPF_RELEASE_CRT)
            message(FATAL_ERROR "QDCXX_IPF_HOST: effective compiler flags must select x64 /MD")
        endif()
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL 13.3.0 OR
            NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$" OR NOT CMAKE_BUILD_TYPE STREQUAL "Debug")
            message(FATAL_ERROR "QDCXX_IPF_HOST: Linux GCC 13.3.0 x86-64 Debug ASan/UBSan required")
        endif()
        include(CheckCXXSourceCompiles)
        unset(ORG_TTLDTOR_QDCXX_IPF_SANITIZED CACHE)
        check_cxx_source_compiles("\n#if !defined(__x86_64__) || !defined(__SANITIZE_ADDRESS__)\n#error x64 ASan required\n#endif\nint main(){return 0;}" ORG_TTLDTOR_QDCXX_IPF_SANITIZED)
        if(NOT ORG_TTLDTOR_QDCXX_IPF_SANITIZED OR NOT CMAKE_CXX_FLAGS MATCHES "-fsanitize=address,undefined")
            message(FATAL_ERROR "QDCXX_IPF_HOST: explicit -fsanitize=address,undefined compiler/link flags required")
        endif()
    else()
        message(FATAL_ERROR "QDCXX_IPF_HOST: unsupported host")
    endif()
endfunction()

# Internal caller: explicit SDK seal and installed SDK config; validates actual local artifact binding.
function(qdcxxVerifyIpfTransferSdk sdkRoot expectedSourceHash expectedPlatform)
    set(metadata "${sdkRoot}/share/qdcxx-ipf-transfer")
    file(SHA256 "${metadata}/boost-1.92.0.sources.json" sourceHash)
    if(NOT sourceHash STREQUAL expectedSourceHash)
        message(FATAL_ERROR "QDCXX_IPF_SDK: pinned source manifest differs")
    endif()
    qdcxxVerifyIpfTransferSources("${metadata}/boost-1.92.0.sources.json" "${sdkRoot}/source")
    file(READ "${metadata}/build-profile.json" profile)
    string(JSON platform GET "${profile}" platform)
    string(JSON sourceBinding GET "${profile}" sourceManifestSha256)
    string(JSON archive GET "${profile}" archive)
    if(NOT platform STREQUAL expectedPlatform OR NOT sourceBinding STREQUAL expectedSourceHash OR
        NOT archive MATCHES "^lib/(qdcxx_boost_url\\.lib|libqdcxx_boost_url\\.a)$")
        message(FATAL_ERROR "QDCXX_IPF_SDK: unsupported platform/source/archive binding")
    endif()
    file(SHA256 "${sdkRoot}/${archive}" actualArchive)
    file(SHA256 "${metadata}/build-profile.json" actualProfile)
    file(READ "${metadata}/seal.json" seal)
    string(JSON expectedArchive GET "${seal}" archiveSha256)
    string(JSON expectedProfile GET "${seal}" buildProfileSha256)
    if(NOT actualArchive STREQUAL expectedArchive OR NOT actualProfile STREQUAL expectedProfile)
        message(FATAL_ERROR "QDCXX_IPF_SDK: sealed artifact/build profile hash mismatch")
    endif()
    string(JSON count LENGTH "${seal}" files)
    if(count LESS 1 OR count GREATER 40000)
        message(FATAL_ERROR "QDCXX_IPF_SDK: invalid sealed inventory count")
    endif()
    math(EXPR last "${count}-1")
    set(expectedFiles)
    foreach(index RANGE 0 ${last})
        string(JSON relative GET "${seal}" files ${index} path)
        string(JSON expected GET "${seal}" files ${index} sha256)
        if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.?(/|$)|[;\\\\:\t\r\n]|//|^/|/$" OR relative STREQUAL "")
            message(FATAL_ERROR "QDCXX_IPF_SDK: invalid sealed path")
        endif()
        qdcxxIpfSdkPath("${sdkRoot}/${relative}")
        file(SHA256 "${sdkRoot}/${relative}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "QDCXX_IPF_SDK: sealed file hash mismatch: ${relative}")
        endif()
        list(APPEND expectedFiles "${relative}")
    endforeach()
    file(GLOB_RECURSE actualFiles LIST_DIRECTORIES FALSE RELATIVE "${sdkRoot}" "${sdkRoot}/*")
    list(REMOVE_ITEM actualFiles "share/qdcxx-ipf-transfer/seal.json" "share/qdcxx-ipf-transfer/seal.lock")
    list(SORT actualFiles)
    list(SORT expectedFiles)
    if(NOT actualFiles STREQUAL expectedFiles)
        message(FATAL_ERROR "QDCXX_IPF_SDK: exact sealed inventory mismatch")
    endif()
    message(STATUS "Verified explicit sealed IPF transfer SDK: ${platform}; ${count} artifact/source/package files")
endfunction()

# Internal seal guard: reject redirected ancestors before creating a receipt/lock in a trusted SDK.
function(qdcxxIpfSdkPath path)
    if(NOT IS_ABSOLUTE "${path}" OR "${path}" MATCHES "[;\r\n]")
        message(FATAL_ERROR "QDCXX_IPF_SDK: absolute path without separators required")
    endif()
    set(current "${path}")
    while(NOT current STREQUAL "")
        if(IS_SYMLINK "${current}")
            message(FATAL_ERROR "QDCXX_IPF_SDK: symlink/junction path rejected")
        endif()
        if(EXISTS "${current}")
            file(REAL_PATH "${current}" resolved)
            set(expected "${current}")
            if(WIN32)
                string(TOLOWER "${expected}" expected)
                string(TOLOWER "${resolved}" resolved)
            endif()
            if(NOT expected STREQUAL resolved)
                message(FATAL_ERROR "QDCXX_IPF_SDK: redirected path rejected")
            endif()
        endif()
        cmake_path(GET current PARENT_PATH parent)
        if(parent STREQUAL current)
            break()
        endif()
        set(current "${parent}")
    endwhile()
endfunction()
