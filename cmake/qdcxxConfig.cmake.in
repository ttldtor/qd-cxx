@PACKAGE_INIT@

set(qdcxx_FOUND TRUE)
unset(qdcxx_NOT_FOUND_MESSAGE)
set(qdcxx_feed_FOUND @ORG_TTLDTOR_QDCXX_BUILD_FEED_API@)
foreach(qdcxxComponent IN LISTS qdcxx_FIND_COMPONENTS)
    if(NOT qdcxxComponent STREQUAL "feed")
        set(qdcxx_${qdcxxComponent}_FOUND FALSE)
        if(qdcxx_FIND_REQUIRED_${qdcxxComponent})
            string(APPEND qdcxx_NOT_FOUND_MESSAGE "Unsupported qdcxx component '${qdcxxComponent}'; supported component: feed. ")
        endif()
    elseif(NOT qdcxx_feed_FOUND AND qdcxx_FIND_REQUIRED_feed)
        string(APPEND qdcxx_NOT_FOUND_MESSAGE "The qdcxx feed component is not installed; rebuild qdcxx with ORG_TTLDTOR_QDCXX_BUILD_FEED_API=ON and its CLIENT, RUNTIME and RECOVERY prerequisites. ")
    endif()
endforeach()
unset(qdcxxComponent)
check_required_components(qdcxx)
if(NOT qdcxx_FOUND)
    return()
endif()

if(@ORG_TTLDTOR_QDCXX_BUILD_RUNTIME@ OR @ORG_TTLDTOR_QDCXX_BUILD_CLIENT@)
    include(CMakeFindDependencyMacro)
    find_dependency(Threads)
endif()
if(@ORG_TTLDTOR_QDCXX_BUILD_RUNTIME@)
    if(NOT TARGET qdcxx_runtime_cares)
        add_library(qdcxx_runtime_cares STATIC IMPORTED)
        set_and_check(qdcxxCaresArchive "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@qdcxxCaresInstalledName@")
        set_target_properties(qdcxx_runtime_cares PROPERTIES IMPORTED_LOCATION "${qdcxxCaresArchive}"
            INTERFACE_LINK_LIBRARIES "@qdcxxCaresNativeLibraries@")
    endif()
endif()
if(@ORG_TTLDTOR_QDCXX_BUILD_TLS@)
    set(ORG_TTLDTOR_QDCXX_OPENSSL_ROOT "" CACHE PATH "Explicit exact qualified static OpenSSL installation")
    include("${CMAKE_CURRENT_LIST_DIR}/VerifyTlsSdk.cmake")
    qdcxxCheckTlsHost("@qdcxxTlsPlatform@")
    qdcxxVerifyTlsProfile("${CMAKE_CURRENT_LIST_DIR}/tls-profile/openssl-3.5.9.json"
        "@qdcxxTlsPlatform@" "${ORG_TTLDTOR_QDCXX_OPENSSL_ROOT}")
    qdcxxImportTlsSdk("${ORG_TTLDTOR_QDCXX_OPENSSL_ROOT}" "@qdcxxTlsPlatform@")
endif()
if(@ORG_TTLDTOR_QDCXX_BUILD_IPF_TRANSFER@)
    if(NOT TARGET qdcxx_ipf_zlib)
        add_library(qdcxx_ipf_zlib STATIC IMPORTED)
        set_and_check(qdcxxIpfZlibArchive "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@qdcxxIpfZlibInstalledName@")
        set_target_properties(qdcxx_ipf_zlib PROPERTIES IMPORTED_LOCATION "${qdcxxIpfZlibArchive}")
    endif()
    set(ORG_TTLDTOR_QDCXX_IPF_TRANSFER_SDK "" CACHE PATH "Explicit qualified sealed static IPF transfer SDK")
    if(NOT IS_ABSOLUTE "${ORG_TTLDTOR_QDCXX_IPF_TRANSFER_SDK}")
        message(FATAL_ERROR "IPF transfer consumers require explicit ORG_TTLDTOR_QDCXX_IPF_TRANSFER_SDK")
    endif()
    find_dependency(qdcxx_ipf_transfer_sdk CONFIG NO_DEFAULT_PATH
        PATHS "${ORG_TTLDTOR_QDCXX_IPF_TRANSFER_SDK}/lib/cmake/qdcxx_ipf_transfer_sdk")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/qdcxxTargets.cmake")
if(qdcxx_feed_FOUND AND NOT TARGET qdcxx::feed)
    add_library(qdcxx::feed ALIAS qdcxx_feed)
endif()
