# Admit only the fixed project build environment represented by the native probe.
# Unknown target/source/directory options and usage requirements fail closed instead
# of interpreting arbitrary generator expressions or claiming generic target attestation.
function(_qdcxx_recovery_admit_environment target root out_includes out_definitions out_ok)
    set(allowed "${root}/include" "${root}/src/transport")
    if(TARGET qdcxx_transport)
        list(APPEND allowed "${ORG_TTLDTOR_QDCXX_ASIO_INCLUDE}"
            "${ORG_TTLDTOR_QDCXX_CARES_SOURCE}"
            "${ORG_TTLDTOR_QDCXX_CARES_SOURCE}/include"
            "${CMAKE_CURRENT_BINARY_DIR}/qdcxx-runtime-cares"
            "${CMAKE_CURRENT_BINARY_DIR}/qdcxx-runtime-cares/include")
    endif()
    if(TARGET qdcxx_tls)
        list(APPEND allowed "${ORG_TTLDTOR_QDCXX_OPENSSL_ROOT}/include")
    endif()
    set(allowed_normal)
    foreach(path IN LISTS allowed)
        if(path AND IS_ABSOLUTE "${path}")
            cmake_path(NORMAL_PATH path)
            list(APPEND allowed_normal "${path}")
        endif()
    endforeach()
    set(benign ASIO_STANDALONE ASIO_NO_DEPRECATED NOMINMAX WIN32_LEAN_AND_MEAN
        _WIN32_WINNT=0x0A00 WINVER=0x0A00 CARES_STATICLIB OPENSSL_STATIC)
    set(producers "${target}")
    foreach(owner qdcxx_core qdcxx_protocol qdcxx_client qdcxx_transport qdcxx_tls qdcxx_tls_recovery)
        if(TARGET ${owner})
            list(APPEND producers "${owner}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES producers)
    set(queue "${producers}")
    set(seen)
    set(includes "${root}/include" "${root}/src/transport")
    set(definitions)
    set(ok TRUE)
    set(configurations DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    foreach(configuration IN LISTS CMAKE_CONFIGURATION_TYPES CMAKE_BUILD_TYPE CMAKE_TRY_COMPILE_CONFIGURATION)
        string(TOUPPER "${configuration}" upper)
        if(upper AND NOT upper IN_LIST configurations)
            set(ok FALSE)
        endif()
    endforeach()
    while(queue AND ok)
        list(POP_FRONT queue owner)
        if(owner IN_LIST seen)
            continue()
        endif()
        list(APPEND seen "${owner}")
        set(options_properties INTERFACE_COMPILE_OPTIONS)
        set(definition_properties INTERFACE_COMPILE_DEFINITIONS)
        set(include_properties INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
        set(feature_properties INTERFACE_COMPILE_FEATURES)
        set(link_properties INTERFACE_LINK_LIBRARIES)
        if(owner IN_LIST producers)
            list(APPEND options_properties COMPILE_OPTIONS COMPILE_FLAGS)
            list(APPEND definition_properties COMPILE_DEFINITIONS)
            list(APPEND include_properties INCLUDE_DIRECTORIES)
            list(APPEND feature_properties COMPILE_FEATURES)
            list(APPEND link_properties LINK_LIBRARIES)
            get_target_property(directory ${owner} SOURCE_DIR)
            foreach(property COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
                get_directory_property(value DIRECTORY "${directory}" ${property})
                if(value)
                    set(ok FALSE)
                endif()
            endforeach()
            get_target_property(standard ${owner} CXX_STANDARD)
            if(standard AND standard GREATER 23)
                set(ok FALSE)
            endif()
            get_target_property(runtime ${owner} MSVC_RUNTIME_LIBRARY)
            if(runtime AND NOT runtime STREQUAL CMAKE_MSVC_RUNTIME_LIBRARY)
                set(ok FALSE)
            endif()
            get_target_property(sources ${owner} SOURCES)
            foreach(source IN LISTS sources)
                if(source MATCHES "\\$<")
                    set(ok FALSE)
                    continue()
                endif()
                foreach(property COMPILE_OPTIONS COMPILE_FLAGS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
                    get_source_file_property(value "${source}" DIRECTORY "${directory}" ${property})
                    if(value)
                        set(ok FALSE)
                    endif()
                endforeach()
                foreach(configuration IN LISTS configurations)
                    get_source_file_property(value "${source}" DIRECTORY "${directory}"
                        "COMPILE_DEFINITIONS_${configuration}")
                    if(value)
                        set(ok FALSE)
                    endif()
                endforeach()
            endforeach()
        endif()
        foreach(property IN LISTS options_properties)
            get_target_property(value ${owner} ${property})
            if(value)
                set(ok FALSE)
            endif()
        endforeach()
        foreach(property IN LISTS feature_properties)
            get_target_property(features ${owner} ${property})
            foreach(feature IN LISTS features)
                if(feature MATCHES "\\$<")
                    set(ok FALSE)
                elseif(feature MATCHES "^cxx_std_([0-9]+)$" AND CMAKE_MATCH_1 GREATER 23)
                    set(ok FALSE)
                endif()
            endforeach()
        endforeach()
        foreach(property IN LISTS definition_properties)
            get_target_property(values ${owner} ${property})
            if(NOT values)
                continue()
            endif()
            foreach(value IN LISTS values)
                if(NOT value IN_LIST benign)
                    set(ok FALSE)
                else()
                    list(APPEND definitions "${value}")
                endif()
            endforeach()
        endforeach()
        foreach(property IN LISTS include_properties)
            get_target_property(values ${owner} ${property})
            if(NOT values)
                continue()
            endif()
            foreach(value IN LISTS values)
                if(value MATCHES "^\\$<INSTALL_INTERFACE:.*>$")
                    continue()
                elseif(value MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
                    set(value "${CMAKE_MATCH_1}")
                endif()
                if(value MATCHES "\\$<" OR NOT IS_ABSOLUTE "${value}")
                    set(ok FALSE)
                    continue()
                endif()
                cmake_path(NORMAL_PATH value)
                if(NOT value IN_LIST allowed_normal)
                    set(ok FALSE)
                else()
                    list(APPEND includes "${value}")
                endif()
            endforeach()
        endforeach()
        foreach(property IN LISTS link_properties)
            get_target_property(values ${owner} ${property})
            if(NOT values)
                continue()
            endif()
            foreach(value IN LISTS values)
                if(value MATCHES "^\\$<(INSTALL_INTERFACE|LINK_ONLY):.*>$")
                    continue()
                elseif(value MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
                    set(value "${CMAKE_MATCH_1}")
                endif()
                if(value MATCHES "\\$<")
                    set(ok FALSE)
                elseif(TARGET "${value}")
                    list(APPEND queue "${value}")
                endif()
            endforeach()
        endforeach()
    endwhile()
    if(CMAKE_CXX_STANDARD AND CMAKE_CXX_STANDARD GREATER 23)
        set(ok FALSE)
    endif()
    if(includes MATCHES "\\]==\\]" OR definitions MATCHES "\\]==\\]")
        set(ok FALSE)
    endif()
    list(REMOVE_DUPLICATES includes)
    list(REMOVE_DUPLICATES definitions)
    # Private system includes are not exposed as a portable CMake target property.
    # Admitted project/SDK directories must not shadow the qualified STL; rejecting
    # such directories avoids pretending that normal/system include ordering is reproduced.
    foreach(directory IN LISTS includes)
        foreach(header vector string memory xstring xmemory yvals_core.h
                bits/basic_string.h bits/basic_string.tcc bits/new_allocator.h bits/stl_vector.h bits/c++config.h)
            if(EXISTS "${directory}/${header}")
                set(ok FALSE)
            endif()
        endforeach()
    endforeach()
    set(${out_includes} "${includes}" PARENT_SCOPE)
    set(${out_definitions} "${definitions}" PARENT_SCOPE)
    set(${out_ok} "${ok}" PARENT_SCOPE)
endfunction()

# Called for qdcxx_recovery after creating that target. Uses a native compile-only
# probe with the current compiler/configuration, then hashes the headers actually
# selected by that compiler. Writes diagnostics only below the binary directory.
# Unknown compiler, ABI, headers or a failed probe select profile zero; the recovery
# factory rejects it before preparing owners. Other components remain available.
# Participating translation units must use the same qualified headers/ABI; later
# per-target include/flag overrides invalidate qualification rather than being attested here.
function(qdcxx_configure_recovery_copy_profile target)
    set(profile 0)
    set(candidate 0)
    set(expected)
    set(probe "${CMAKE_CURRENT_BINARY_DIR}/recovery-copy-profile")
    file(MAKE_DIRECTORY "${probe}")
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    _qdcxx_recovery_admit_environment(${target} "${root}" includes definitions environment_ok)
    set(reason "Compiler outside qualified profiles")
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND CMAKE_CXX_COMPILER_VERSION MATCHES "^19\\.42(\\.|$)")
        set(candidate 1)
        set(expected
            "vector|93ccfdf0c075aa361ff1b95c7bf159a968dc3a8160ce3b7a1c3e72daf81e66c7"
            "xstring|9430d0ecbe27d932ec0c322d2d21b2909cc27a7d7e0d77ea4383170bc7fbf5b9"
            "xmemory|bf19440c179d48604cfe0f1c8d84cea4192f5daa35ffb508523bccf0e5727be0"
            "yvals_core.h|6b419a8b58c5122b114593f8ea880f3fcbe626590ab80e23d36c168a1547fc50")
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND CMAKE_CXX_COMPILER_VERSION MATCHES "^13\\.3(\\.|$)")
        set(candidate 2)
        set(expected
            "bits/basic_string.h|a59d74827107619a8b6c78dd8aef60a19d87154ae483f6b8546f10841800a12b"
            "bits/basic_string.tcc|f98bb3939ab623912042fb4226d21cec2b0e79c2d1b0e43bbdb12d1dc99f46c1"
            "bits/new_allocator.h|22a5a1f0100d4d5fb900e1dddac9fc4e18470374e2b4e88430baea699c6fe583"
            "bits/stl_vector.h|c4d4d95e5f60ea1b349e1a7568edef381621c38b430826e2d669ffeb2a2eb1b7"
            "bits/c++config.h|335e3585a6d6626cc9c9264c8c19716eb827cbcbc777516b0ce5ba1840a59f1c")
    endif()

    if(NOT environment_ok)
        set(candidate 0)
        set(reason "Existing producer compile settings are outside the represented profile")
    endif()

    if(candidate)
        set(source "${probe}/profile.cpp")
        file(WRITE "${source}" [=[
#include <string>
#include <vector>

static_assert(sizeof(char16_t) == 2 && sizeof(void *) == 8);
#if QDCXX_PROFILE_KIND == 1
#if !defined(_MSVC_STL_UPDATE) || _MSVC_STL_UPDATE != 202408L || _ITERATOR_DEBUG_LEVEL != 0
#error Unqualified recovery copy ABI
#endif
#elif QDCXX_PROFILE_KIND == 2
#if !defined(__GLIBCXX__) || __GLIBCXX__ != 20240904 || _GLIBCXX_USE_CXX11_ABI != 1 || defined(_GLIBCXX_DEBUG)
#error Unqualified recovery copy ABI
#endif
#else
#error Unknown recovery copy profile
#endif
int qdcxxRecoveryCopyProbe() { return 0; }
]=])
        if(NOT CMAKE_TRY_COMPILE_CONFIGURATION)
            if(CMAKE_BUILD_TYPE)
                set(CMAKE_TRY_COMPILE_CONFIGURATION "${CMAKE_BUILD_TYPE}")
            else()
                set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
            endif()
        endif()
        file(WRITE "${probe}/environment.cmake"
            "set(QDCXX_PROFILE_INCLUDES [==[${includes}]==])\nset(QDCXX_PROFILE_DEFINITIONS [==[${definitions}]==])\n")
        set(flags
            "-DQDCXX_PROFILE_SOURCE:FILEPATH=${source}"
            "-DQDCXX_PROFILE_KIND:STRING=${candidate}"
            "-DQDCXX_PROFILE_DEPENDENCIES:FILEPATH=${probe}/dependencies.json"
            "-DQDCXX_PROFILE_ENVIRONMENT:FILEPATH=${probe}/environment.cmake"
            "-DCMAKE_CXX_FLAGS:STRING=${CMAKE_CXX_FLAGS}"
            "-DCMAKE_BUILD_TYPE:STRING=${CMAKE_TRY_COMPILE_CONFIGURATION}")
        foreach(config DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
            list(APPEND flags "-DCMAKE_CXX_FLAGS_${config}:STRING=${CMAKE_CXX_FLAGS_${config}}")
        endforeach()
        if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY)
            list(APPEND flags "-DCMAKE_MSVC_RUNTIME_LIBRARY:STRING=${CMAKE_MSVC_RUNTIME_LIBRARY}")
        endif()
        try_compile(compiled PROJECT qdcxx_recovery_copy_probe
            SOURCE_DIR "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RecoveryCopyProbe"
            BINARY_DIR "${probe}/build" TARGET copy_probe NO_CACHE
            CMAKE_FLAGS ${flags} OUTPUT_VARIABLE trace)
        file(WRITE "${probe}/qualification.log" "${trace}")
        set(headers)
        if(compiled AND candidate EQUAL 1 AND EXISTS "${probe}/dependencies.json")
            file(READ "${probe}/dependencies.json" dependencies)
            string(JSON count ERROR_VARIABLE error LENGTH "${dependencies}" Data Includes)
            if(error STREQUAL "NOTFOUND" AND count GREATER 0)
                math(EXPR last "${count} - 1")
                foreach(index RANGE 0 ${last})
                    string(JSON path GET "${dependencies}" Data Includes ${index})
                    string(REPLACE "\\" "/" path "${path}")
                    list(APPEND headers "${path}")
                endforeach()
            endif()
        elseif(compiled AND candidate EQUAL 2)
            string(REPLACE "\r\n" "\n" trace "${trace}")
            string(REPLACE "\n" ";" lines "${trace}")
            foreach(line IN LISTS lines)
                if(line MATCHES "^\\.+ (/.+)$")
                    list(APPEND headers "${CMAKE_MATCH_1}")
                endif()
            endforeach()
        endif()
        list(REMOVE_DUPLICATES headers)
        set(matches "${compiled}")
        file(WRITE "${probe}/headers.tsv" "header\tactual_path\tsha256\tmatched\n")
        foreach(entry IN LISTS expected)
            string(REPLACE "|" ";" pair "${entry}")
            list(GET pair 0 suffix)
            list(GET pair 1 hash)
            set(selected)
            foreach(path IN LISTS headers)
                string(TOLOWER "${path}" lower)
                string(LENGTH "${lower}" path_length)
                string(LENGTH "/${suffix}" suffix_length)
                if(path_length GREATER_EQUAL suffix_length)
                    math(EXPR start "${path_length} - ${suffix_length}")
                    string(SUBSTRING "${lower}" ${start} ${suffix_length} tail)
                    if(tail STREQUAL "/${suffix}")
                        list(APPEND selected "${path}")
                    endif()
                endif()
            endforeach()
            list(LENGTH selected count)
            set(actual "")
            set(path "")
            set(equal FALSE)
            if(count EQUAL 1)
                list(GET selected 0 path)
                if(EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
                    file(SHA256 "${path}" actual)
                    if(actual STREQUAL hash)
                        set(equal TRUE)
                    endif()
                endif()
            endif()
            if(NOT equal)
                set(matches FALSE)
            endif()
            file(APPEND "${probe}/headers.tsv" "${suffix}\t${path}\t${actual}\t${equal}\n")
        endforeach()
        if(matches)
            set(profile "${candidate}")
        endif()
    else()
        file(WRITE "${probe}/qualification.log" "${reason}; no native probe executed.\n")
        file(WRITE "${probe}/headers.tsv" "header\tactual_path\tsha256\tmatched\n")
    endif()
    file(WRITE "${probe}/result.txt" "profile=${profile}\ncompiler=${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\n")
    target_compile_definitions(${target} PRIVATE "ORG_TTLDTOR_QDCXX_RECOVERY_COPY_PROFILE=${profile}")
    set_property(TARGET ${target} PROPERTY QDCXX_RECOVERY_COPY_PROFILE "${profile}")
    message(STATUS "Recovery copy profile: ${profile} (zero means unsupported recovery preparation)")
endfunction()
