# Internal caller: the shared timezone target in CMakeLists.txt. Input: tracked actual Java identity/legacy observations
# and source-backed Calendar conventions. Output: private immutable identity header; no Java execution.
function(qdcxx_time_zone_identity output)
    set(resources "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../resources/time-zone-data")
    file(READ "${resources}/calendar-offset-conventions.json" manifest)
    foreach(kind IN ITEMS metadata legacyTransitions)
        string(JSON path GET "${manifest}" ${kind} path)
        string(JSON expected GET "${manifest}" ${kind} sha256)
        file(SHA256 "${resources}/${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Java timezone observations differ from manifest: ${path}")
        endif()
    endforeach()
    file(STRINGS "${resources}/java8-zone-metadata.tsv" metadata ENCODING UTF-8)
    file(STRINGS "${resources}/java8-systemv-transitions.tsv" transitions ENCODING UTF-8)
    list(LENGTH metadata identity_count)
    list(LENGTH transitions transition_count)
    if(NOT identity_count EQUAL 631 OR NOT transition_count EQUAL 936)
        message(FATAL_ERROR "Schedule timezone compatibility observations are incomplete")
    endif()
    set(header "// Generated from actual pinned Java observations and source-backed Calendar conventions.\n#pragma once\n#include <array>\n#include <cstddef>\n#include <cstdint>\n#include <string_view>\nnamespace org::ttldtor::qdcxx::time::detail::zone_data {\nstruct LegacyTransition { std::int64_t seconds; std::int32_t before; std::int32_t after; };\ninline constexpr std::array<LegacyTransition, 936> TRANSITIONS = {{\n")
    set(index 0)
    foreach(line IN LISTS transitions)
        string(REPLACE "\t" ";" cells "${line}")
        list(LENGTH cells width)
        if(NOT width EQUAL 4)
            message(FATAL_ERROR "Invalid legacy timezone observation width")
        endif()
        list(GET cells 0 id)
        list(GET cells 1 seconds)
        list(GET cells 2 before)
        list(GET cells 3 after)
        if(NOT id MATCHES "^SystemV/(AST4ADT|CST6CDT|EST5EDT|MST7MDT|PST8PDT|YST9YDT)$"
           OR NOT seconds MATCHES "^-?[0-9]+$" OR NOT before MATCHES "^-?[0-9]+$" OR NOT after MATCHES "^-?[0-9]+$")
            message(FATAL_ERROR "Invalid legacy timezone observation fields")
        endif()
        if(NOT DEFINED "legacy_start_${id}")
            set("legacy_start_${id}" ${index})
            set("legacy_count_${id}" 0)
        endif()
        math(EXPR "legacy_count_${id}" "${legacy_count_${id}} + 1")
        string(APPEND header "{${seconds}LL,${before},${after}},\n")
        math(EXPR index "${index} + 1")
    endforeach()
    string(APPEND header "}};\nstruct Identity { std::u16string_view id; const char* mapped; std::int64_t referenceRawMillis; bool systemV; bool legacyDst; std::size_t first; std::size_t count; };\ninline constexpr std::array<Identity,631> IDENTITIES = {{\n")
    set(observed_ids "")
    foreach(line IN LISTS metadata)
        string(REPLACE "\t" ";" cells "${line}")
        list(LENGTH cells width)
        if(NOT width EQUAL 11)
            message(FATAL_ERROR "Invalid Java timezone identity observation width")
        endif()
        list(GET cells 0 id)
        list(GET cells 1 mapped)
        list(GET cells 2 raw)
        list(GET cells 3 savings)
        if(NOT id MATCHES "^[A-Za-z0-9_+./-]+$" OR NOT mapped MATCHES "^[A-Za-z0-9_+./:-]+$"
           OR NOT raw MATCHES "^-?[0-9]+$" OR NOT savings MATCHES "^[0-9]+$")
            message(FATAL_ERROR "Invalid Java timezone identity fields")
        endif()
        list(APPEND observed_ids "${id}")
        set(system_v false)
        set(legacy_dst false)
        set(first 0)
        set(count 0)
        if(id MATCHES "^SystemV/")
            set(system_v true)
            if(DEFINED "legacy_start_${id}")
                set(legacy_dst true)
                set(first "${legacy_start_${id}}")
                set(count "${legacy_count_${id}}")
                if(NOT savings EQUAL 3600000 OR NOT count EQUAL 156)
                    message(FATAL_ERROR "Unexpected SystemV transition/rule profile")
                endif()
            elseif(NOT savings EQUAL 0)
                message(FATAL_ERROR "Missing SystemV transition profile")
            endif()
        endif()
        string(APPEND header "{u\"${id}\",\"${mapped}\",${raw}LL,${system_v},${legacy_dst},${first},${count}},\n")
    endforeach()
    file(STRINGS "${resources}/../schedule/java8-zone-ids.txt" accepted_ids ENCODING UTF-8)
    if(NOT observed_ids STREQUAL accepted_ids)
        message(FATAL_ERROR "Schedule timezone observations do not match the complete accepted identity profile")
    endif()
    string(APPEND header "}};\nstruct RawConvention { std::string_view canonical; std::int64_t begin; std::int64_t end; std::int64_t adjustment; };\n")
    string(JSON convention_count LENGTH "${manifest}" rawConventions)
    if(NOT convention_count EQUAL 5)
        message(FATAL_ERROR "Unexpected Calendar raw-offset convention profile")
    endif()
    string(APPEND header "inline constexpr std::array<RawConvention,5> RAW_CONVENTIONS = {{\n")
    foreach(index RANGE 0 4)
        string(JSON canonical GET "${manifest}" rawConventions ${index} nativeCanonicalZone)
        string(JSON begin GET "${manifest}" rawConventions ${index} beginUtcMillis)
        string(JSON end GET "${manifest}" rawConventions ${index} endUtcMillis)
        string(JSON adjustment GET "${manifest}" rawConventions ${index} rawAdjustmentSeconds)
        if(NOT canonical MATCHES "^[A-Za-z0-9_+./-]+$")
            message(FATAL_ERROR "Invalid Calendar raw-offset convention identity")
        endif()
        string(APPEND header "{\"${canonical}\",${begin}LL,${end}LL,${adjustment}LL},\n")
    endforeach()
    string(APPEND header "}};\n}\n")
    get_filename_component(directory "${output}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(WRITE "${output}.tmp" "${header}")
    configure_file("${output}.tmp" "${output}" COPYONLY)
    file(REMOVE "${output}.tmp")
endfunction()
