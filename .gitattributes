* text=auto
*.md text eol=lf
*.lock text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
tests/conformance/encoding/*.log -text
tests/conformance/encoding/cases.tsv -text
tools/upstream/schema-oracle/*.java text eol=lf
tools/upstream/schema-oracle/*.ps1 text eol=lf
tests/fixtures/schema/inputs/*.xml text eol=lf
tests/fixtures/schema/*.json text eol=lf
tests/fixtures/schema/expected/*.tsv text eol=lf
# Raw observations and environment/build metadata retain their captured bytes.
tests/fixtures/schema/captures/** -text
# Encoding provenance hashes identify exact tool/input and captured bytes.
tools/upstream/encoding-oracle/* -text
tests/fixtures/encoding/cases.json -text
tests/fixtures/encoding/expected/*.tsv text eol=lf
tests/fixtures/encoding/captures/** -text
tools/upstream/*-oracle/*.java text eol=lf
tools/upstream/protocol-oracle/Invoke-Oracle.ps1 text eol=lf
.clang-format text eol=lf
.uncrustify.cfg text eol=lf
tools/format/licenses/*.txt text eol=lf
tools/format/*.ps1 text eol=lf
tools/format/*.json text eol=lf
tools/format/evidence/** -text

# QDCXX-012 hashes canonical harness/input bytes and preserves new raw evidence verbatim.
tools/upstream/protocol-oracle/* text eol=lf
tests/fixtures/protocol/cases.json text eol=lf
tests/fixtures/protocol/expected/P02*.tsv text eol=lf
tests/fixtures/protocol/p02/captures/** -text
tests/conformance/protocol/logs/*.log -text
tests/conformance/protocol/frames.tsv text eol=lf

# QDCXX-013 retains exact hashed probe/input bytes and captured provenance.
# Java is already formatter-canonical LF; PS scripts/docs retain their captured Windows bytes.
tools/upstream/description-oracle/*.ps1 -text
tools/upstream/description-oracle/*.md -text
tests/fixtures/protocol/p08/inputs.tsv -text
tests/fixtures/protocol/p08/expected/*.tsv text eol=lf
tests/fixtures/protocol/p08/captures/** -text
tests/conformance/protocol/descriptions/logs/*.log -text

# QDCXX-015 preserves exact hashed inputs/tools and raw evidence.
tools/upstream/symbol-oracle/*.ps1 -text
tools/upstream/symbol-oracle/*.md -text
tests/fixtures/encoding/symbols/inputs.tsv -text
tests/fixtures/encoding/symbols/expected/*.tsv text eol=lf
tests/fixtures/encoding/symbols/captures/** -text
tests/conformance/encoding/symbols/logs/*.log -text

# Additive tape-reader observations and hashed tools retain exact captured bytes.
tools/upstream/tape-reader-oracle/*.ps1 -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/fixtures/protocol/tape-reader/expected/** -text
# Raw captured logs contain significant CRLF and padded diagnostic dumps; never trim them.
# This exception does not apply to authored code, documentation or expected TSV rows.
tests/fixtures/protocol/tape-reader/evidence/** -text -whitespace
tests/conformance/protocol/tape/logs/** -text -whitespace
